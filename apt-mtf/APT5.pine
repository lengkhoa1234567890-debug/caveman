//══════════════════════════════════════════════════════════════════
// CANH BAO KHUNG CHART
//══════════════════════════════════════════════════════════════════
bool aptTfOk = timeframe.in_seconds(timeframe.period) == 60
// [SUA MQL5SYNC-02] spread quy ra GIA (SYMBOL_SPREAD * _Point ben MQL5) va so chu so thap phan cua gia (_Digits).
float aptSpreadPx = i_asymSpreadPts * syminfo.mintick
int aptDigits = int(math.max(0.0, math.round(math.log10(1.0 / syminfo.mintick))))

//══════════════════════════════════════════════════════════════════
// PREFIX-SUM TREN M1 — tuong duong cumTPV/cumVol ben MQL5
//══════════════════════════════════════════════════════════════════
float aptCumT = ta.cum(hlc3 * volume)
float aptCumV = ta.cum(volume)

// VWAP cua n nen M1 gan nhat, tinh tu nen DANG CHAY (song theo tick)
f_rvNow(simple int n) =>
    float dT = aptCumT - aptCumT[n]
    float dV = aptCumV - aptCumV[n]
    dV > 0.0 and not na(dT) ? dT / dV : na

// VWAP cua n nen M1 KET THUC tai nen truoc (dung lay mau tai moc doi nen TF)
f_rvAt1(simple int n) =>
    float dT = aptCumT[1] - aptCumT[1 + n]
    float dV = aptCumV[1] - aptCumV[1 + n]
    dV > 0.0 and not na(dT) ? dT / dV : na

//══════════════════════════════════════════════════════════════════
// WOODIE — SAO CHEP y het AptWoodieLevelValue()
//     PP = (H + L + 2*C)/4 ; rng = H - L
//     R1 = 2*PP - L                  S1 = 2*PP - H
//     R2 = PP + rng                  S2 = PP - rng
//     Rn = H + (n-1)*(PP - L)        Sn = L - (n-1)*(H - PP)   (n >= 3)
// k: 0 = PP ; 1..9 = R1..R9 ; 10..18 = S1..S9
//══════════════════════════════════════════════════════════════════
f_woodie(int k, float h, float l, float c) =>
    float pp = (h + l + 2.0 * c) / 4.0
    float rg = h - l
    float dr = pp - l
    float df = h - pp
    float v = na
    if k == 0
        v := pp
    else if k == 1
        v := 2.0 * pp - l
    else if k == 2
        v := pp + rg
    else if k <= 9
        v := h + (k - 1) * dr
    else if k == 10
        v := 2.0 * pp - h
    else if k == 11
        v := pp - rg
    else
        v := l - (k - 10) * df
    v

//══════════════════════════════════════════════════════════════════
// AptBrkAccSecToStr() — nhung ban MQL5 xoa ky tu "s" truoc khi noi vao
// _rv1PivAppend (StringReplace(..., "s", "")), nen o day tra ve dang DA BO "s".
//     < 60 giay  -> "45"
//     >= 60 giay -> "25.16"  (25 phut 16 giay)
//══════════════════════════════════════════════════════════════════

//       r

//       r

//══════════════════════════════════════════════════════════════════
// AptTickPressure() — TSF + LAM tren cua so nB nen M1
//   TSF = tong(sign(dC)*vol) / tong(vol)
//   LAM = log2( (pathR/volR) / (pathW/volW) ), khong con gioi han +-2
//   kRec = clamp(nB/8, 3, 15)
//══════════════════════════════════════════════════════════════════
// [CAP NHAT LAM-6H-01 - THEO YEU CAU] Nang tran kep tren "nn > 240" thanh
// "nn > 360": 360 la nB LON NHAT trong script nay (khung 6h, xem aptNb o
// duoi), nen tran moi khong con kep bat ky khung nao trong 9 khung 1m..6h -
// khung 6h gio dung DUNG cua so 360 nen M1 cua chinh no thay vi bi kep chung
// ve 240 nhu 4h. Khong doi cap "nn < 5", khong doi cong thuc kRec/TSF/LAM
// ben duoi.
f_tickPressure(int nB) =>
    float outTsf = na
    float outLam = na
    int nn = nB
    if nn < 5
        nn := 5
    if nn > 360
        nn := 360
    int kRec = int(nn / 8)
    if kRec < 3
        kRec := 3
    if kRec > 15
        kRec := 15
    float num = 0.0
    float den = 0.0
    float pathW = 0.0
    float volW = 0.0
    float pathR = 0.0
    float volR = 0.0
    for s = 0 to nn - 1
        float v = volume[s]
        float dP = close[s] - close[s + 1]
        if v > 0.0
            if dP > 0.0
                num += v
            else if dP < 0.0
                num -= v
            den += v
            float ad = math.abs(dP)
            pathW += ad
            volW += v
            if s < kRec
                pathR += ad
                volR += v
    if den > 0.0 and volW > 0.0 and volR > 0.0
        float lamW = pathW / volW
        float lamR = pathR / volR
        if lamW > 0.0 and lamR > 0.0
            outTsf := num / den
            float lam = math.log(lamR / lamW) / math.log(2.0)
            outLam := lam
    [outTsf, outLam]

//══════════════════════════════════════════════════════════════════
// f_tickPressureAsym() — chi phi day gia TANG so voi day gia GIAM tren
//   CUNG mot cua so nB nen (dung Y HET cach cap nn/vong lap cua
//   f_tickPressure() o tren: nn = clamp(nB, 5, 360)). TradingView khong co
//   spread lich su theo tung nen nen tru MOT hang so co dinh spreadPts
//   (input i_asymSpreadPts, quy doi qua syminfo.mintick) khoi |dP| truoc
//   khi cong don - phan con lai am (< spreadPx) coi nhu KHONG du de "day"
//   duoc gia, tinh la 0.
//   lamUp = tong(|dP|-spreadPx, dP>0) / tong(volume, dP>0)
//   lamDn = tong(|dP|-spreadPx, dP<0) / tong(volume, dP<0)
//   outAsym = log2(lamDn/lamUp): DUONG = day TANG dat hon, AM = day GIAM
//   dat hon - dung Y HET quy uoc cua outLam o tren. KHONG doi
//   f_tickPressure()/outLam o tren.
//══════════════════════════════════════════════════════════════════
f_tickPressureAsym(int nB, float spreadPts) =>
    float outAsym = na
    int nn = nB
    if nn < 5
        nn := 5
    if nn > 360
        nn := 360
    float spreadPx = spreadPts * syminfo.mintick
    float pathUp = 0.0
    float volUp = 0.0
    float pathDn = 0.0
    float volDn = 0.0
    for s = 0 to nn - 1
        float v = volume[s]
        float dP = close[s] - close[s + 1]
        if v > 0.0
            float ad = math.abs(dP)
            float adAdj = ad > spreadPx ? ad - spreadPx : 0.0
            if dP > 0.0
                pathUp += adAdj
                volUp += v
            else if dP < 0.0
                pathDn += adAdj
                volDn += v
    if volUp > 0.0 and volDn > 0.0
        float lamUp = pathUp / volUp
        float lamDn = pathDn / volDn
        if lamUp > 0.0 and lamDn > 0.0
            outAsym := math.log(lamDn / lamUp) / math.log(2.0)
    outAsym

f_tpLbl(float tsf, float lam) =>
    float th = 0.3
    string s = "trung tính, giữ nhịp"
    if tsf > 0.15
        if lam < -th
            s := "nghiêng tăng, bán dầy"
        else if lam > th
            s := "nghiêng tăng, bán mỏng"
        else
            s := "nghiêng tăng, giữ nhịp"
    else if tsf < -0.15
        if lam > th
            s := "nghiêng giảm, mua mỏng"
        else if lam < -th
            s := "nghiêng giảm, mua dầy"
        else
            s := "nghiêng giảm, giữ nhịp"
    else
        if lam < -th
            s := "trung tính, chặn dầy"
        else if lam > th
            s := "trung tính, chặn mỏng"
        else
            s := "trung tính, giữ nhịp"
    s

f_tpClr(float tsf) =>
    color c = color.silver
    if tsf > 0.15
        c := #FFD700
    else if tsf < -0.15
        c := #F5F5F5
    c

f_ordClr(int up, int dn) =>
    color c = color.silver
    if up > dn
        c := #FFD700
    else if dn > up
        c := #F5F5F5
    c

// [CAP NHAT THEO YEU CAU] f_tfEnabled — tra ve TRUE/FALSE khung tai chi so i
//   (0..APT_TFN-1, dung thu tu aptNb/aptTfName) co dang BAT hay khong. 6
//   khung cu (i = 0..5, tuc 1m..2h) LUON tra ve true - KHONG co cong tac
//   rieng, hanh vi giu NGUYEN y het truoc khi them 3 khung moi. 3 khung MOI
//   (i = 6/7/8, tuc 3h/4h/6h) doc dung cong tac rieng cua no
//   (i_show3h/i_show4h/i_show6h). Dung de bo qua vong tinh RSI/EMA 19 muc
//   Woodie (khoi trang thai) va vong quet mau hinh + chuoi WPR (khoi ve) cua
//   CHINH khung do khi tat, giam tai tinh toan.
f_tfEnabled(int i) =>
    bool on = true
    if i == 6
        on := i_show3h
    else if i == 7
        on := i_show4h
    else if i == 8
        on := i_show6h
    on

// [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] f_priorityPushY — SAO CHEP
//   y het khoi "UU TIEN VI TRI NHAN PIVOT THEO THU TU KHUNG" ([SUA PVM1-01]/
//   [SUA PVM1-03] trong DrawWoodiePivotEma() ben AutoPositionTool_UI.mq5),
//   dung CHUNG cho CA BA cot nhan (Pivot, RV1, RV2): khung dung TRUOC (idx
//   nho hon, tuc uu tien cao hon - dung DUNG thu tu vong lap i = 0..APT_TFN-1
//   cua ban Pine nay, khop g_rvTfList/g_tfList ben MQL5) LUON giu DUNG vi tri
//   gia THAT (khong bao gio bi day, vi khi den luot no CHUA co nhan nao "da
//   chot" truoc do trong mang settled de cham). Khung uu tien THAP HON, neu
//   vi tri that TRUNG hoac qua GAN (< gap) BAT KY nhan nao da CHOT truoc no
//   (settled[0..idx-1]), thi bi DAY XUONG (giam gia) vua du de thoat het
//   cham, lap lai toi da APT_TFN lan - dung Y HET vong "_guard"/"_pvSettled"
//   ben MQL5. Mang settled (aptPivYAdj/aptRv1YAdj/aptRv2YAdj cua tung cot,
//   truyen vao qua tham chieu array) duoc GHI (array.set) boi noi goi NGAY
//   SAU khi goi ham nay, y het cach _pvSettled[_pvSettledN++] = _pvPlaced ben
//   MQL5. Ham CHI TINH gia moi: KHONG tao/xoa object nao, KHONG ve them
//   duong line nao, KHONG doi setting/input nao.
// [SUA PVDIR-01 / SUA RVDIR-01 - THEO YEU CAU] CAP NHAT THEO BAN MQL5 MOI
//   NHAT: CHIEU day nhan chong de KHONG con LUON XUONG nua ma PHU THUOC vi
//   tri GIA HIEN TAI so voi CHINH muc gia THAT cua nhan dang xet (rawY) -
//   dung Y HET khoi "[SUA PVDIR-01]" trong DrawWoodiePivotEma() va khoi
//   "[SUA RVDIR-01]" trong DrawRv2RsiLabels() ben AutoPositionTool_UI.mq5:
//     - gia hien tai <  rawY  -> ca cum nhan nam TREN gia  -> day LEN  (dir = +1)
//     - gia hien tai >= rawY  -> ca cum nhan nam DUOI gia  -> day XUONG (dir = -1)
//   tuc nhan khung LON (uu tien THAP hon) luon bi day RA XA gia, con nhan
//   khung NHO (uu tien CAO hon) giu DUNG vi tri gia that va nam SAT gia
//   nhat - thuan mat hon so voi cach cu. Ben MQL5 moc so sanh la
//   SymbolInfoDouble(_Symbol, SYMBOL_BID); ben Pine dung THANG gia co san
//   cua chart la close (gia dong cua nen dang chay = gia hien tai), KHONG
//   them input/setting nao de lay gia.
//   Chieu duoc CHOT MOT LAN truoc vong guard (nhu _pvDir/_lpDir ben MQL5)
//   nen moi buoc day deu DON DIEU mot huong, vong lap chac chan dung.
//   Buoc mot hang van la gap (stepSafe cua noi goi) va nguong phat hien
//   cham van la gap * 0.8 - GIU NGUYEN, khong doi cong thuc nao. Ham VAN
//   CHI TINH gia moi: KHONG tao/xoa label nao, KHONG ve them duong line
//   nao, KHONG doi setting/input nao. AP DUNG DONG NHAT cho CA BA cot
//   (Pivot, RV1, RV2) vi ca ba deu goi CHUNG ham nay.
//       y
// [SUA PVORDERFIX-01 / SUA RVORDERFIX-01 - THEO YEU CAU] CAP NHAT THEO BAN
//   MQL5 MOI NHAT: CHIEU day nhan chong de gio tinh RIENG cho TUNG nhan da
//   chot dang va cham (dirVsJ) - theo DUNG thu hang gia THAT giua nhan dang
//   xet (rawY) va CHINH nhan da chot do (raw[j], doc tu mang raw MOI truyen
//   vao song song voi settled - dung Y HET _pvOvPrice[_k]/_olPrice[_lpIdx[_k]]
//   ben MQL5), KHONG con dung mot dir chung theo gia hien tai (close) nua:
//     - rawY >= raw[j]  -> nhan dang xet GIA CAO hon nhan da chot j -> day
//       nhan dang xet LEN tren nhan do (dirVsJ = +1)
//     - rawY <  raw[j]  -> nhan dang xet GIA THAP hon nhan da chot j -> day
//       nhan dang xet XUONG duoi nhan do (dirVsJ = -1)
//   nen nhan nao co gia THAT cao hon LUON duoc xep o hang gia man hinh CAO
//   hon nhan va cham co gia THAT thap hon, bat ke gia hien tai dang o dau -
//   nho vay thu tu TREN/DUOI cua BAT KY cap nhan nao tren cung mot cot LUON
//   khop voi thu tu gia THAT cua chung. Mang raw (aptPivYRaw/aptRv1YRaw/
//   aptRv2YRaw cua tung cot, THEM MOI song song voi settled) luu lai gia THAT
//   (rawY) cua tung nhan theo dung chi so i, GHI (array.set) boi noi goi NGAY
//   SAU khi goi ham nay - CUNG nhip voi cach settled dang duoc ghi, dung Y HET
//   _pvOvPrice[]/_olPrice[] ben MQL5 (mang gia THAT goc, KHONG doi qua cac
//   vong day). Bien close KHONG con dung trong ham nay nua (dung Y HET viec
//   MQL5 giu nguyen khai bao _pvBidNow/_lpBidNow o noi goi nhung khong con
//   dung de chon chieu day). Buoc mot hang van la gap va nguong phat hien cham
//   van la gap * 0.8 - GIU NGUYEN, khong doi cong thuc nao. Ham VAN CHI TINH
//   gia moi: KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
//   setting/input nao. AP DUNG DONG NHAT cho CA BA cot (Pivot, RV1, RV2) vi
//   ca ba deu goi CHUNG ham nay.
f_priorityPushY(float rawY, array<float> settled, array<float> raw, int idx, float gap) =>
    float y = rawY
    if not na(rawY) and not na(gap) and gap > 0.0
        for guard = 0 to APT_TFN - 1
            bool hit = false
            for j = 0 to idx - 1
                float yj = array.get(settled, j)
                if not na(yj) and math.abs(y - yj) < gap * 0.8
                    float rawJ = array.get(raw, j)
                    int dirVsJ = rawY >= rawJ ? 1 : -1
                    float cand = yj + dirVsJ * gap
                    if (dirVsJ > 0 and cand > y) or (dirVsJ < 0 and cand < y)
                        y := cand
                        hit := true
            if not hit
                break
    y

//══════════════════════════════════════════════════════════════════
// THANG MAU — SAO CHEP y het BrkRowColor() / doan duoi AptPivotRowColor()
// Tra ve MA MAU (dung cho ca to mau lan phan nhom bo dem Up/Dn):
//   1 magenta  2 orange  3 gold  4 yellow  5 lime      -> nhom TANG
//   6 white    7 lightgray  8 silver  9 lightsteelblue  10 lightblue -> nhom GIAM
//   0 = roi ve mau du phong
//══════════════════════════════════════════════════════════════════
f_brkCode(float brkVal, bool brkUp) =>
    int c = 0
    if na(brkVal)
        c := 0
    else if brkVal > 110.0 and brkUp
        c := 1
    else if brkVal > 100.0 or (brkVal > 80.0 and brkUp)
        c := 2
    else if brkVal > 90.0 or (brkVal > 70.0 and brkUp)
        c := 3
    else if brkVal > 70.0 or (brkVal > 60.0 and brkUp)
        c := 4
    else if brkVal > 50.0 or (brkVal > 40.0 and brkUp)
        c := 5
    else if brkVal < -10.0 and not brkUp
        c := 6
    else if brkVal < 10.0
        c := 7
    else if brkVal < 20.0
        c := 8
    else if brkVal < 30.0
        c := 9
    else if brkVal < 40.0
        c := 10
    else
        c := 0
    c

f_codeToColor(int c, bool brkUp) =>
    color r = brkUp ? i_colUp : i_colDn
    if c == 1
        r := color.fuchsia
    else if c == 2
        r := color.orange
    else if c == 3
        r := #FFD700
    else if c == 4
        r := color.yellow
    else if c == 5
        r := color.lime
    else if c == 6
        r := color.white
    else if c == 7
        r := #D3D3D3
    else if c == 8
        r := color.silver
    else if c == 9
        r := #B0C4DE
    else if c == 10
        r := #ADD8E6
    r

//══════════════════════════════════════════════════════════════════
// TRANG THAI (var) — chi cap nhat tai moc doi nen TF
//══════════════════════════════════════════════════════════════════
// [CAP NHAT THEO YEU CAU] THEM 3 khung 3h/4h/6h vao CUOI (chi so 6/7/8) - 6
// khung dau GIU NGUYEN thu tu/gia tri, KHONG doi.
var array<int>    aptNb     = array.from(1, 5, 15, 30, 60, 120, 180, 240, 360)
var array<string> aptTfName = array.from("1m", "5m", "15m", "30m", "1h", "2h", "3h", "4h", "6h")
var array<string> aptLvName = array.from("PP", "R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9")

// [CAP NHAT THEO YEU CAU - BARTF-01] Giai ma input i_barTF thanh CHI SO trong
// aptNb/aptTfName (aptBarIdx) va so nen M1 cua khung do (aptBarNb). Tinh MOT
// LAN o nen dau tien (var) nen khong ton them gi moi bar. Neu ten khung khong
// khop (khong the xay ra voi options co dinh) thi roi ve DUNG hanh vi cu:
// chi so 2 = "15m" = APT_BAR_NB. Hang so APT_BAR_NB GIU NGUYEN, khong xoa -
// van dung lam gia tri du phong o day.
var int aptBarIdxRaw = array.indexof(aptTfName, i_barTF)
var int aptBarIdx    = aptBarIdxRaw < 0 ? 2 : aptBarIdxRaw
var int aptBarNb     = aptBarIdxRaw < 0 ? APT_BAR_NB : array.get(aptNb, aptBarIdx)

var array<int>   aptBk    = array.new_int(APT_TFN, na)     // id nen TF dang chay
var array<float> aptCurH  = array.new_float(APT_TFN, na)   // H dang gom cua nen TF hien tai
var array<float> aptCurL  = array.new_float(APT_TFN, na)
var array<float> aptCurO  = array.new_float(APT_TFN, na)   // O cua nen TF hien tai (de biet isBull)
var array<float> aptPrvH  = array.new_float(APT_TFN, na)   // H/L/C cua nen TF LIEN TRUOC (shift 1)
var array<float> aptPrvL  = array.new_float(APT_TFN, na)

// [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Lich su H/L cua tung khung
// TF (chi cac nen DA DONG) phuc vu kenh brkD, cong hai mang trang thai cua
// chuoi (streak). Cot 0 = nen TF dong gan nhat, cot 1 = nen truoc do...
// APT_BRKD_HIST = 61 = maxval cua i_brkDBars (60) + 1, du cho moi cau hinh.
// Ben MQL5 khong can hai matrix nay vi iHighest/iLowest doc thang lich su cua
// khung khac; Pine phai tu gom nen TF tu nen 1m nen phai luu lai.
const int APT_BRKD_HIST     = 61
const int APT_BRKD_STRK_MAX = 60
var matrix<float> aptTfH = matrix.new<float>(APT_TFN, APT_BRKD_HIST, na)
var matrix<float> aptTfL = matrix.new<float>(APT_TFN, APT_BRKD_HIST, na)
var array<int> aptBrkStrkCnt  = array.new_int(APT_TFN, 0)
var array<int> aptBrkStrkSide = array.new_int(APT_TFN, 0)

// [BO SUNG MQL5SYNC-01 - THEO YEU CAU] Lich su nen TF DA DONG (O/H/L/C/V/gio
//   mo) cua TUNG khung, dang VONG (ring buffer) APT_TFBAR_HIST o, nuoi tai
//   CHINH moc doi nen TF cua khoi trang thai ben duoi. Doc qua f_hbGet(m, i, s)
//   voi s = 1 la nen TF dong gan nhat (= shift 1 ben MQL5). Phuc vu: nen dao
//   chieu (AptCdlScanTF), Value Area (AptImbCalcValueArea - nhanh du phong)
//   va vung Volume Imbalance (AptVImbFindTF). KHONG ve gi.
// [SUA MQL5SYNC-02] 125 -> 205: SMA(Close, 200) cua nhan Close Simple can 199 nen TF da dong + nen dang chay.
const int APT_TFBAR_HIST = 205
var matrix<float> aptHbO = matrix.new<float>(APT_TFN, APT_TFBAR_HIST, na)
var matrix<float> aptHbH = matrix.new<float>(APT_TFN, APT_TFBAR_HIST, na)
var matrix<float> aptHbL = matrix.new<float>(APT_TFN, APT_TFBAR_HIST, na)
var matrix<float> aptHbC = matrix.new<float>(APT_TFN, APT_TFBAR_HIST, na)
var matrix<float> aptHbV = matrix.new<float>(APT_TFN, APT_TFBAR_HIST, na)
var matrix<float> aptHbT = matrix.new<float>(APT_TFN, APT_TFBAR_HIST, na)
var array<int> aptHbHead = array.new_int(APT_TFN, APT_TFBAR_HIST - 1)
var array<int> aptHbCnt = array.new_int(APT_TFN, 0)
var array<float> aptCurV = array.new_float(APT_TFN, 0.0)

f_hbGet(matrix<float> m, int i, int s) =>
    float v = na
    if s >= 1 and s <= array.get(aptHbCnt, i)
        int col = (array.get(aptHbHead, i) - (s - 1) + APT_TFBAR_HIST * 2) % APT_TFBAR_HIST
        v := matrix.get(m, i, col)
    v

// f_brkD — brkD cua MOT khung tai muc gia px, tuong duong AptBrkDAt() ben MQL5.
//   i  = chi so khung trong aptNb/aptTfName (0 = 1m)
//   n  = so nen cua kenh (i_brkDBars)
//   px = gia dem so (bid cho nen dang chay)
// Thieu du lieu (chua du n nen TF dong, hoac HH <= LL) -> tra na, noi goi tu
// lui ve gia tri cu; KHONG doan bua.
f_brkD(int i, int n, float px) =>
    float hh = na
    float ll = na
    for j = 0 to n - 1
        float hj = matrix.get(aptTfH, i, j)
        float lj = matrix.get(aptTfL, i, j)
        if not na(hj) and not na(lj)
            hh := na(hh) ? hj : math.max(hh, hj)
            ll := na(ll) ? lj : math.min(ll, lj)
    float den = na(hh) or na(ll) ? na : hh - ll
    float r = na(den) or den <= 0.0 or na(px) ? na : (px - ll) / den * 100.0
    r

// f_brkStreak — so nen lien tiep brkD giu nguyen phia so voi moc 50, DA GOM ca
// nen dang chay, tuong duong AptBrkStreakCount() ben MQL5. Phan cua cac nen DA
// DONG duoc nuoi san trong aptBrkStrkCnt/aptBrkStrkSide (cap nhat MOT LAN moi
// khi khung do sang nen moi), o day chi ghep them phia cua nen dang chay -
// dung y het co che cache theo bar-time ben MQL5. Tra ve >= 1.
f_brkStreak(int i, float bd) =>
    int sideNow = bd > 50.0 ? 1 : -1
    int cnt = array.get(aptBrkStrkSide, i) == sideNow ? array.get(aptBrkStrkCnt, i) + 1 : 1
    int r = cnt > APT_BRKD_STRK_MAX ? APT_BRKD_STRK_MAX : cnt
    r

// f_brkScore — diem tong hop brk cua (mac dinh) 5 khung 1m..1h, trong so
// TANG DAN tu khung nho den khung lon, tuong duong AptBrkScore() ben MQL5:
//     brkScore = SUM( w_k * sign(brkD_k - 50) ) / SUM( w_k ),  w_k = k + 1
// k = 0..4 trong aptNb = 1m, 5m, 15m, 30m, 1h (KHONG doi thu tu mang goc).
// Ket qua nam trong [-1.0, +1.0]. Khung nao f_brkD() tra na thi bi loai khoi CA
// tu so LAN mau so - diem van chuan hoa dung theo phan trong so doc duoc, KHONG
// coi khung thieu du lieu la 0. Ca cac khung dang tham gia deu thieu -> tra na.
// [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU, SUA BRKSCORE-TFCOUNT-01]
// So khung tham gia vong lap (truoc day hang cung k = 0..4, tuc LUON DU 5
// khung) nay doc tu input i_brkScoreTfCount (khai bao canh i_brkDBars o dau
// file), KEP trong [1, 5] ngay tai day. Cong thuc brkScore va trong so
// w_k = k+1 GIU NGUYEN 100% - CHI doi SO KHUNG k chay toi (tu 0..4 co dinh
// thanh 0..nTf-1 theo input), khong doi mot phep tinh nao khac.
f_brkScore(int n, float px) =>
    int nTf = i_brkScoreTfCount < 1 ? 1 : i_brkScoreTfCount > 5 ? 5 : i_brkScoreTfCount
    float sumW = 0.0
    float sumS = 0.0
    for k = 0 to nTf - 1
        float b = f_brkD(k, n, px)
        if not na(b)
            float w = k + 1
            sumW := sumW + w
            sumS := sumS + w * (b > 50.0 ? 1.0 : -1.0)
    float r = sumW <= 0.0 ? na : sumS / sumW
    r

var matrix<float> aptRvS = matrix.new<float>(APT_TFN, APT_SAMP_N, na)   // mau RV1 da chot (0 = moi nhat = rv[1])

// EMA(5) + RSI(5) Wilder tren chuoi tung muc Pivot — index = tf*APT_LVN + lvl
var array<float> aptEmaLv  = array.new_float(APT_TFN * APT_LVN, na)
var array<float> aptEmaPrv = array.new_float(APT_TFN * APT_LVN, na)
var array<float> aptRsiU   = array.new_float(APT_TFN * APT_LVN, 0.0)
var array<float> aptRsiD   = array.new_float(APT_TFN * APT_LVN, 0.0)
var array<int>   aptRsiN   = array.new_int(APT_TFN * APT_LVN, 0)
var array<float> aptRsiCur = array.new_float(APT_TFN * APT_LVN, na)
var array<float> aptRsiPrv = array.new_float(APT_TFN * APT_LVN, na)
// [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] So nen RSI da tang/giam
// LIEN TUC tinh den hien tai cua tung (khung, muc Pivot) - tuong duong
// CalcRsiTrendBars() ben AutoPositionTool_UI.mq5 (dau + = dang tang, dau - =
// dang giam). Truoc day <+/-dRSI> cua Pine (pivDlt/dRsiNear) chi la HIEU SO
// RSI giua 2 nen lien tiep - KHONG khop MQL5 (ban MQL5 da doi tu hieu so
// sang SO NEN LIEN TUC tu lau, [SUA RSITREND-01]). Cap nhat DUNG MOI nen (o
// khoi tinh RSI trong vong lap trang thai o duoi, KHONG can luu lai lich su
// RSI - chi can cap nhat DAN theo tung nen dong, cho ra CUNG ket qua nhu quet
// lui lich su moi lan ve).
var array<int>   aptRsiStreak = array.new_int(APT_TFN * APT_LVN, 0)

// RV2 = EMA(5) tren chuoi RV1
var array<float> aptRv2    = array.new_float(APT_TFN, na)
// [BO SUNG THEO YEU CAU] Lich su RV2 da chot (CUNG khuon voi aptRvS o
// tren), phuc vu William %R tren RV2 o cum HANG 8+ - KHONG doi cach tinh
// aptRv2 da co, chi luu THEM lich su cua chinh no.
var matrix<float> aptRv2S = matrix.new<float>(APT_TFN, APT_SAMP_N, na)

// Bo dem cong don theo giay — varip de KHONG bi roll back moi tick
// [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Cap MOI <UpC>/<DnC>, dieu
// kien dua tren William %R cua RV2(tf)/RV1(tf) - xem f_wprShift va khoi cong
// don trong vong lap chinh ben duoi.

// [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Gia dong cua NGAY HOM
// TRUOC (tuong duong iClose(_Symbol, PERIOD_D1, 1) ben AutoPositionTool_UI.mq5),
// dung cho <cdlS1> cua cot nhan Pivot (xem khoi tinh sCdlS1 trong vong lap
// chinh). Pine khong request.security nen tu theo doi moc doi NGAY ngay
// trong dong M1 (CUNG kieu voi aptBk/aptPrvC dang lam cho tung khung TF o
// tren), dung CHUNG aptAnchorMs de khop lech gio server nhu cac moc doi nen
// khac trong file.
var int   aptDayBk         = na
var float aptPrevDayClose  = na

// Mang luu vi tri Y da dieu chinh cua cot nhan Pivot de tranh chong cheo
var array<float> aptPivYAdj = array.new_float(APT_TFN, na)
// [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Mang luu vi tri Y da dieu
// chinh cua cot nhan RV1 (khung 5m tro len, i = 1..5 - i = 0 la khung 1m,
// KHONG qua f_priorityPushY nen KHONG ghi vao day, xem khoi (2) COT NHAN RV1
// trong vong lap chinh) va cot nhan RV2 (CA 6 khung, i = 0..5), dung CHUNG
// f_priorityPushY() voi cot Pivot o tren - ap dung dung "co che uu tien vi
// tri theo thu tu khung" giong ben MQL5 cho ca hai cot nay.
var array<float> aptRv1YAdj = array.new_float(APT_TFN, na)
var array<float> aptRv2YAdj = array.new_float(APT_TFN, na)
// [SUA PVORDERFIX-01 / SUA RVORDERFIX-01 - THEO YEU CAU] Mang MOI, song song
// tung phan tu voi aptPivYAdj/aptRv1YAdj/aptRv2YAdj o tren: luu gia THAT goc
// (rawY truyen vao f_priorityPushY, tuc pivYBase/rvL/rv2 - KHONG bi day) cua
// tung nhan theo dung chi so i, dung Y HET vai tro _pvOvPrice[]/_olPrice[]
// ben MQL5 sau khi doi sang [SUA PVORDERFIX-01]/[SUA RVORDERFIX-01]: f_priorityPushY
// doc mang nay de xet chieu day RIENG cho tung cap nhan cham nhau (dirVsJ),
// thay vi dung CHUNG mot chieu theo gia hien tai (close) nhu ban [SUA
// PVDIR-01]/[SUA RVDIR-01] cu. KHONG thay doi cach aptPivYAdj/aptRv1YAdj/
// aptRv2YAdj hoat dong.
var array<float> aptPivYRaw = array.new_float(APT_TFN, na)
var array<float> aptRv1YRaw = array.new_float(APT_TFN, na)
var array<float> aptRv2YRaw = array.new_float(APT_TFN, na)

var line aptLine15m = na
var line aptLine15mOpen = na
var line aptLine15mClose = na

//══════════════════════════════════════════════════════════════════
// RV1 SONG THEO TICK — 6 gia tri, offset HANG SO nen khong ton bo nho history
//══════════════════════════════════════════════════════════════════
float aptRvLive0 = f_rvNow(1)
float aptRvLive1 = f_rvNow(5)
float aptRvLive2 = f_rvNow(15)
float aptRvLive3 = f_rvNow(30)
float aptRvLive4 = f_rvNow(60)
float aptRvLive5 = f_rvNow(120)
// [SUA APT_TFN9-01] them 3h/4h/6h de khop APT_TFN=9, tranh loi array.get out of bounds
float aptRvLive6 = f_rvNow(180)
float aptRvLive7 = f_rvNow(240)
float aptRvLive8 = f_rvNow(360)
array<float> aptRvLive = array.from(aptRvLive0, aptRvLive1, aptRvLive2, aptRvLive3, aptRvLive4, aptRvLive5, aptRvLive6, aptRvLive7, aptRvLive8)

float aptRvChot0 = f_rvAt1(1)
float aptRvChot1 = f_rvAt1(5)
float aptRvChot2 = f_rvAt1(15)
float aptRvChot3 = f_rvAt1(30)
float aptRvChot4 = f_rvAt1(60)
float aptRvChot5 = f_rvAt1(120)
// [SUA APT_TFN9-01] them 3h/4h/6h de khop APT_TFN=9, tranh loi array.get out of bounds
float aptRvChot6 = f_rvAt1(180)
float aptRvChot7 = f_rvAt1(240)
float aptRvChot8 = f_rvAt1(360)
array<float> aptRvChot = array.from(aptRvChot0, aptRvChot1, aptRvChot2, aptRvChot3, aptRvChot4, aptRvChot5, aptRvChot6, aptRvChot7, aptRvChot8)

//══════════════════════════════════════════════════════════════════
// VONG CAP NHAT TRANG THAI
// QUAN TRONG: chi chay o NEN DA DONG. Tren nen dang chay Pine roll back toan bo
// trang thai moi tick roi chay lai; ghi var/array o do se lam lech chuoi EMA/RSI.
// Cac gia tri CAN SONG THEO TICK (RV1 live, diffrv1, brk%, Q1, slope) deu tinh
// ngoai khoi nay nen khong bi anh huong.
//══════════════════════════════════════════════════════════════════
int aptAnchorMs = i_anchorMin * 60000

//══════════════════════════════════════════════════════════════════
// [SUA RT-TF-01 - THEO YEU CAU: GIA TRI PHAI CAP NHAT REALTIME] f_tfRollClosed —
//   CHOT MOT nen TF vua dong (buoc 1..4 cua vong cap nhat trang thai cu, SAO
//   CHEP y het, KHONG doi cong thuc nao). Chi khac: H/L/O/C/V/mau RV1 cua nen
//   vua dong duoc TRUYEN VAO thay vi doc close[1]/aptRvChot - de goi duoc o
//   HAI cho: (a) chot SOM ngay khi nen M1 CUOI CUNG cua nen TF dong (khong
//   tre), (b) chot du phong khi gap khoang trong phien (cach cu).
//══════════════════════════════════════════════════════════════════
f_tfRollClosed(int i, int nB, int bkClosed, float hOld, float lOld, float oClosed, float vClosed, float cClosed, float smpClosed) =>
    //--- 1) chot H/L/C cua nen TF vua dong ---
    array.set(aptPrvH, i, hOld)
    array.set(aptPrvL, i, lOld)
    //--- 1a) [BO SUNG MQL5SYNC-01] day nen TF vua dong vao lich su vong aptHb*
    int hbHead = (array.get(aptHbHead, i) + 1) % APT_TFBAR_HIST
    array.set(aptHbHead, i, hbHead)
    matrix.set(aptHbO, i, hbHead, nz(oClosed, cClosed))
    matrix.set(aptHbH, i, hbHead, hOld)
    matrix.set(aptHbL, i, hbHead, lOld)
    matrix.set(aptHbC, i, hbHead, cClosed)
    matrix.set(aptHbV, i, hbHead, vClosed)
    matrix.set(aptHbT, i, hbHead, float(bkClosed) * nB * 60000 + aptAnchorMs)
    array.set(aptHbCnt, i, math.min(array.get(aptHbCnt, i) + 1, APT_TFBAR_HIST))
    //--- 1b) [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] chot
    //    brkD cua nen TF VUA DONG roi cap nhat chuoi (streak), SAU DO
    //    moi day H/L cua no vao lich su kenh. Thu tu nay BAT BUOC:
    //    kenh cua nen vua dong phai la N nen TRUOC no, tuc lich su
    //    aptTfH/aptTfL luc CHUA day - dung y het "shift 1..N" ben MQL5.
    float bdHH = na
    float bdLL = na
    for j = 0 to i_brkDBars - 1
        float hj = matrix.get(aptTfH, i, j)
        float lj = matrix.get(aptTfL, i, j)
        if not na(hj) and not na(lj)
            bdHH := na(bdHH) ? hj : math.max(bdHH, hj)
            bdLL := na(bdLL) ? lj : math.min(bdLL, lj)
    float bdDen = na(bdHH) or na(bdLL) ? na : bdHH - bdLL
    float bdClosed = na(bdDen) or bdDen <= 0.0 ? na : (cClosed - bdLL) / bdDen * 100.0
    if not na(bdClosed)
        int bdSide = bdClosed > 50.0 ? 1 : -1
        int bdCnt = array.get(aptBrkStrkSide, i) == bdSide ? array.get(aptBrkStrkCnt, i) + 1 : 1
        array.set(aptBrkStrkCnt, i, bdCnt > APT_BRKD_STRK_MAX ? APT_BRKD_STRK_MAX : bdCnt)
        array.set(aptBrkStrkSide, i, bdSide)
    // [TOI UU BRKD-PERF-01 - THEO YEU CAU] Chi day dung i_brkDBars cot
    //   thay vi ca APT_BRKD_HIST cot. APT_BRKD_HIST = 61 la kich thuoc
    //   CAP PHAT toi da cua matrix (cho phep keo i_brkDBars len 60),
    //   KHONG phai so cot thuc su dung: ca f_brkD() lan khoi chot brkD
    //   ngay tren deu CHI doc cot 0..i_brkDBars-1, nen cac cot tu
    //   i_brkDBars tro di khong co noi nao doc - day chung la vo ich.
    //   Voi mac dinh i_brkDBars = 5: 60 vong -> 4 vong, cho MOI khung
    //   trong 9 khung, MOI lan khung do dong nen.
    //   KHONG doi ket qua mot chu so nao (cot bi bo qua chua tung duoc
    //   doc), KHONG doi input/setting nao.
    for j = i_brkDBars - 1 to 1
        matrix.set(aptTfH, i, j, matrix.get(aptTfH, i, j - 1))
        matrix.set(aptTfL, i, j, matrix.get(aptTfL, i, j - 1))
    matrix.set(aptTfH, i, 0, hOld)
    matrix.set(aptTfL, i, 0, lOld)
    //--- 2) day mot mau RV1 moi vao hang cua khung ---
    float smp = smpClosed
    if not na(smp) and smp > 0.0
        for j = APT_SAMP_N - 1 to 1
            matrix.set(aptRvS, i, j, matrix.get(aptRvS, i, j - 1))
        matrix.set(aptRvS, i, 0, smp)
        //--- 3) RV2 = EMA(5) tren chuoi RV1 ---
        float e2Old = array.get(aptRv2, i)
        float e2 = na(e2Old) ? smp : (smp - e2Old) * (2.0 / (APT_EMA_P + 1)) + e2Old
        array.set(aptRv2, i, e2)
        //--- 3b) (BO SUNG THEO YEU CAU) day mot mau RV2 vao lich su rieng
        //    cua RV2 (aptRv2S), CUNG kieu shift nhu aptRvS o tren, phuc vu
        //    William %R tren RV2 o cum HANG 8+ - KHONG doi logic tinh RV2
        //    (e2) da co, chi luu THEM lich su cua no.
        for j = APT_SAMP_N - 1 to 1
            matrix.set(aptRv2S, i, j, matrix.get(aptRv2S, i, j - 1))
        matrix.set(aptRv2S, i, 0, e2)
    //--- 4) 19 muc Woodie -> EMA(5) -> RSI(5) Wilder ---
    // [CAP NHAT THEO YEU CAU] Them dieu kien "and f_tfEnabled(i)"
    // vao CUOI dieu kien co san (khong doi hai dieu kien cu
    // not na(cB)/hOld>=lOld mot chut nao): khung bi tat (chi 3h/
    // 4h/6h moi co cong tac, xem f_tfEnabled) se bo qua HAN vong
    // tinh 19 muc Woodie/EMA/RSI/streak ben duoi - day la khoi
    // ton tai nang nhat trong PHAN TRANG THAI, giam tai dung y
    // yeu cau.
    float cB = cClosed
    if not na(cB) and hOld >= lOld and f_tfEnabled(i)
        for k = 0 to APT_LVN - 1
            int gi = i * APT_LVN + k
            float lv = f_woodie(k, hOld, lOld, cB)
            float eOld = array.get(aptEmaLv, gi)
            float ev = na(eOld) ? lv : (lv - eOld) * (2.0 / (APT_EMA_P + 1)) + eOld
            array.set(aptEmaLv, gi, ev)
            float pv = array.get(aptEmaPrv, gi)
            if not na(pv)
                float u = math.max(ev - pv, 0.0)
                float d = math.max(pv - ev, 0.0)
                int nn = array.get(aptRsiN, gi)
                if nn < APT_RSI_P
                    array.set(aptRsiU, gi, array.get(aptRsiU, gi) + u)
                    array.set(aptRsiD, gi, array.get(aptRsiD, gi) + d)
                    array.set(aptRsiN, gi, nn + 1)
                    if nn + 1 == APT_RSI_P
                        array.set(aptRsiU, gi, array.get(aptRsiU, gi) / APT_RSI_P)
                        array.set(aptRsiD, gi, array.get(aptRsiD, gi) / APT_RSI_P)
                else
                    array.set(aptRsiU, gi, (array.get(aptRsiU, gi) * (APT_RSI_P - 1) + u) / APT_RSI_P)
                    array.set(aptRsiD, gi, (array.get(aptRsiD, gi) * (APT_RSI_P - 1) + d) / APT_RSI_P)
                if array.get(aptRsiN, gi) >= APT_RSI_P
                    float au = array.get(aptRsiU, gi)
                    float ad = array.get(aptRsiD, gi)
                    array.set(aptRsiPrv, gi, array.get(aptRsiCur, gi))
                    array.set(aptRsiCur, gi, ad <= 0.0 ? 100.0 : 100.0 - 100.0 / (1.0 + au / ad))
                    // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU
                    // CAU] Cap nhat DAN so nen RSI tang/giam LIEN
                    // TUC (aptRsiStreak) - tuong duong
                    // CalcRsiTrendBars() ben MQL5, dung ket qua
                    // aptRsiCur/aptRsiPrv VUA gan o hai dong tren
                    // (KHONG tinh lai RSI). Thieu RSI truoc do
                    // (aptRsiPrv con na - lan dau RSI vua du diem)
                    // -> giu 0, dung y het "khong du du lieu -> 0"
                    // cua CalcRsiTrendBars.
                    float rsiNowV = array.get(aptRsiCur, gi)
                    float rsiPrvV = array.get(aptRsiPrv, gi)
                    int prevStreak = array.get(aptRsiStreak, gi)
                    int newStreak = 0
                    if not na(rsiPrvV)
                        if rsiNowV > rsiPrvV
                            newStreak := prevStreak > 0 ? prevStreak + 1 : 1
                        else if rsiNowV < rsiPrvV
                            newStreak := prevStreak < 0 ? prevStreak - 1 : -1
                    array.set(aptRsiStreak, gi, newStreak)
                    // [BO SUNG RSIEXTREME-01 - THEO YEU CAU] Day
                    //   rsiNowV (RSI(5) VUA chot cua CHINH (khung,
                    //   muc) nay) vao dau lich su aptRsiHist -
                    //   CUNG ky thuat shift-mot-o-mot voi khoi day
                    //   aptRvS/aptRv2S o (2)/(3) phia tren (dich
                    //   toan bo cot sang phai 1 vi tri, roi ghi gia
                    //   tri moi vao cot 0). KHONG doi rsiNowV/
                    //   aptRsiCur/aptRsiStreak, CHI THEM lich su.
            array.set(aptEmaPrv, gi, ev)
    true

// [SUA RT-TF-01 - THEO YEU CAU] Vong cap nhat trang thai viet lai de KHONG TRE:
//   ban cu chi phat hien doi nen TF o nen M1 DAU TIEN cua nen TF moi khi nen
//   do DA DONG -> moi lan doi nen TF tre ~1 phut (khung 1m tre DUNG 1 nen).
//   Ban moi: khi nen M1 dong ma time_close roi sang bucket moi => nen M1 nay
//   la nen CUOI cua nen TF -> chot NGAY (dung close/f_rvNow cua chinh no).
//   Van CHI ghi trang thai o nen DA DONG (khong bi roll back). Cach cu duoc
if aptTfOk and barstate.isconfirmed
    int aptDayBkNow = int((time - aptAnchorMs) / 86400000)
    if na(aptDayBk) or aptDayBk != aptDayBkNow
        if not na(aptDayBk) and bar_index > 0
            aptPrevDayClose := close[1]
        aptDayBk := aptDayBkNow
    // [SUA RT-TF-01] chot gia dong NGAY ngay khi nen M1 cuoi ngay dong
    int aptDayBkNext = int((time_close - aptAnchorMs) / 86400000)
    if not na(time_close) and aptDayBkNext != aptDayBkNow
        aptPrevDayClose := close
        aptDayBk := aptDayBkNext
    for i = 0 to APT_TFN - 1
        int nB = array.get(aptNb, i)
        int bk = int((time - aptAnchorMs) / (nB * 60000))
        int bkOld = array.get(aptBk, i)
        if na(bkOld) or bkOld != bk
            // du phong (khoang trong phien / lan dau): chot kieu cu
            float hOld = array.get(aptCurH, i)
            float lOld = array.get(aptCurL, i)
            if not na(hOld) and not na(lOld) and bar_index > 0
                f_tfRollClosed(i, nB, bkOld, hOld, lOld, array.get(aptCurO, i), array.get(aptCurV, i), close[1], array.get(aptRvChot, i))
            array.set(aptCurH, i, high)
            array.set(aptCurL, i, low)
            array.set(aptCurO, i, open)
            array.set(aptBk, i, bk)
            array.set(aptCurV, i, nz(volume))
        else
            array.set(aptCurH, i, math.max(nz(array.get(aptCurH, i), high), high))
            array.set(aptCurL, i, math.min(nz(array.get(aptCurL, i), low), low))
            if na(array.get(aptCurO, i))
                array.set(aptCurO, i, open)
            array.set(aptCurV, i, nz(array.get(aptCurV, i)) + nz(volume))
        // [SUA RT-TF-01] nen M1 nay la nen CUOI cua nen TF -> chot NGAY
        int bkNext = na(time_close) ? bk : int((time_close - aptAnchorMs) / (nB * 60000))
        if bkNext != bk
            float hC = array.get(aptCurH, i)
            float lC = array.get(aptCurL, i)
            if not na(hC) and not na(lC)
                f_tfRollClosed(i, nB, bk, hC, lC, array.get(aptCurO, i), array.get(aptCurV, i), close, array.get(aptRvLive, i))
            array.set(aptBk, i, bkNext)
            array.set(aptCurH, i, na)
            array.set(aptCurL, i, na)
            array.set(aptCurO, i, na)
            array.set(aptCurV, i, 0.0)

//══════════════════════════════════════════════════════════════════
// [SUA RT-TF-01 - THEO YEU CAU] GIA TRI SONG THEO TICK (khong ghi trang thai,
//   tinh lai MOI lan script chay -> khong lo roll back):
//   aptRv2Live  : RV2 = EMA(5) cua RV1 voi diem moi nhat la RV1 LIVE
//                 (rv2[0] ben MQL5); aptRv2 = gia tri da chot = rv2[1].
//   aptCurH/L/OLive : H/L/O nen TF dang chay GOM CA nen M1 dang chay.
//     - nen M1 thuoc nen TF dang mo -> gop; vua chot som o tick dong nen
//       (nen M1 nay thuoc nen TF cu) -> na; nen TF moi chua chot (gap) ->
//       chi nen M1 nay.
//══════════════════════════════════════════════════════════════════
array<float> aptRv2Live  = array.new_float(APT_TFN, na)
array<float> aptCurHLive = array.new_float(APT_TFN, na)
array<float> aptCurLLive = array.new_float(APT_TFN, na)
array<float> aptCurOLive = array.new_float(APT_TFN, na)
for i = 0 to APT_TFN - 1
    float e2c = array.get(aptRv2, i)
    float lvR = array.get(aptRvLive, i)
    int nBl = array.get(aptNb, i)
    int bkT = int((time - aptAnchorMs) / (nBl * 60000))
    int bkTc = na(time_close) ? bkT : int((time_close - aptAnchorMs) / (nBl * 60000))
    int bkS = array.get(aptBk, i)
    // tick dong nen vua chot som: RV1 live DA nam trong aptRv2 -> khong cong lai lan 2
    bool justRolled = barstate.isconfirmed and bkTc != bkT and bkS == bkTc
    array.set(aptRv2Live, i, na(e2c) ? na : na(lvR) or justRolled ? e2c : (lvR - e2c) * (2.0 / (APT_EMA_P + 1)) + e2c)
    if not na(bkS) and bkS == bkT
        array.set(aptCurHLive, i, math.max(nz(array.get(aptCurH, i), high), high))
        array.set(aptCurLLive, i, math.min(nz(array.get(aptCurL, i), low), low))
        array.set(aptCurOLive, i, nz(array.get(aptCurO, i), open))
    else if not justRolled
        array.set(aptCurHLive, i, high)
        array.set(aptCurLLive, i, low)
        array.set(aptCurOLive, i, open)

//══════════════════════════════════════════════════════════════════
// [BO SUNG BARLBL-CUR-01 - THEO YEU CAU] TRANG THAI RIENG cua THAN NEN LON
// (khung i_barTF / aptBarNb) cho cum nhan duoi day than nen lon:
//   - aptBcO/H/L/C : O/H/L/C cua nen than nen lon DANG CHAY, cap nhat MOI
//     lan chay (ke ca tick realtime) nen H/L/C luon la gia tri song.
//   - aptBcMaxUp/aptBcMaxDn : port MbcRangeStatCurrent() - % bien do lon
//     nhat (nen tang, >= 0) / am nhat (nen giam, < 0) cua cac nen DA DONG
//     trong cua so: khung <= 4h -> tu dau NGAY, khung > 4h (6h) -> tu dau
//     TUAN (Chu nhat) - dung quy tac MbcRangeStatWinStart() ben MQL5. Nen
//     dang chay duoc gop them o khoi ve (khong ghi vao day).
// Moc chia nen dung DUNG quy uoc (time - aptAnchorMs) cua khoi trang thai
// o tren. KHONG dong den khoi trang thai o tren, KHONG ve duong nao.
//══════════════════════════════════════════════════════════════════
var int aptBcBk = na
var float aptBcO = na
var float aptBcH = na
var float aptBcL = na
var float aptBcC = na
var int aptBcWin = na
var bool aptBcHasUp = false
var bool aptBcHasDn = false
var float aptBcMaxUp = 0.0
var float aptBcMaxDn = 0.0

// MbcBarRangePctAtShift() - % bien do (H-L)/C*100, am khi nen giam (C < O)
f_bcRangePct(float o, float h, float l, float c) =>
    float r = na
    if not na(o) and not na(h) and not na(l) and not na(c) and o > 0.0 and h > 0.0 and l > 0.0 and c > 0.0 and h >= l
        r := (h - l) / c * 100.0
        if c < o
            r := -r
    r

// MbcRangeStatWinStart() - khoa cua so thong ke: so ngay (khung <= 4h) hoac
// ngay Chu nhat dau tuan (khung > 4h). 01/01/1970 la Thu Nam (dow = 4).
f_bcWinKey(int tOpenMs, int nB, int anchorMs) =>
    int dayNum = int(math.floor((tOpenMs - anchorMs) / 86400000.0))
    int r = nB <= 240 ? dayNum : dayNum - ((dayNum + 4) % 7)
    r

if aptTfOk
    int bcPms = aptBarNb * 60000
    int bcBkNow = int(math.floor((time - aptAnchorMs) / bcPms))
    if na(aptBcBk) or aptBcBk != bcBkNow
        float bcPcOld = f_bcRangePct(aptBcO, aptBcH, aptBcL, aptBcC)
        if not na(bcPcOld)
            if bcPcOld >= 0.0
                if not aptBcHasUp or bcPcOld > aptBcMaxUp
                    aptBcMaxUp := bcPcOld
                    aptBcHasUp := true
            else
                if not aptBcHasDn or bcPcOld < aptBcMaxDn
                    aptBcMaxDn := bcPcOld
                    aptBcHasDn := true
        int bcWinNow = f_bcWinKey(bcBkNow * bcPms + aptAnchorMs, aptBarNb, aptAnchorMs)
        if na(aptBcWin) or aptBcWin != bcWinNow
            aptBcWin := bcWinNow
            aptBcHasUp := false
            aptBcHasDn := false
            aptBcMaxUp := 0.0
            aptBcMaxDn := 0.0
        aptBcBk := bcBkNow
        aptBcO := open
        aptBcH := high
        aptBcL := low
    else
        aptBcH := math.max(aptBcH, high)
        aptBcL := math.min(aptBcL, low)
    aptBcC := close

// ElapsedToStr() - "Dd HH:MM" / "HH:MM:SS" / "MM:SS"
f_bcElapsedStr(int secs) =>
    int s = secs < 0 ? 0 : secs
    int d = int(s / 86400)
    int h = int((s % 86400) / 3600)
    int m = int((s % 3600) / 60)
    int ss = s % 60
    string r = d > 0 ? str.tostring(d) + "d " + str.tostring(h, "00") + ":" + str.tostring(m, "00") : h > 0 ? str.tostring(h, "00") + ":" + str.tostring(m, "00") + ":" + str.tostring(ss, "00") : str.tostring(m, "00") + ":" + str.tostring(ss, "00")
    r

// BarRemainSec() - so giay con lai cua nen khung: code > 0 = so phut cua
// khung (5..1440), code = -1 = tuan (W1, bat dau Chu nhat), code = -2 =
// thang (MN1). Dung quy uoc moc (timenow - anchorMs) cua f_remainStr.
f_bcRemainSec(int code, int anchorMs) =>
    int ts = timenow - anchorMs
    int nextTs = na
    if code > 0
        int pms = code * 60000
        nextTs := (int(math.floor(ts / pms)) + 1) * pms
    else if code == -1
        int dayNum = int(math.floor(ts / 86400000.0))
        int wk0 = dayNum - ((dayNum + 4) % 7)
        nextTs := (wk0 + 7) * 86400000
    else
        int yy = year(ts, "UTC")
        int mo = month(ts, "UTC")
        nextTs := timestamp("UTC", mo == 12 ? yy + 1 : yy, mo == 12 ? 1 : mo + 1, 1, 0, 0)
    int rem = na(nextTs) ? na : int((nextTs - ts) / 1000)
    rem

// BuildCountdownWarn() - "<TF>:<giay>s" cua cac khung con duoi nguong, xep tu
// khung lon den khung nho, dung DUNG danh sach g_cdTFList/g_cdTFName ben MQL5.
f_bcCountdown(int thrSec, int maxItems, int anchorMs) =>
    array<int> cdCodes = array.from(-2, -1, 1440, 720, 480, 360, 240, 180, 120, 60, 30, 15, 5)
    array<string> cdNames = array.from("1MN", "1W", "1D", "12H", "8H", "6H", "4H", "3H", "2H", "1H", "30M", "15M", "5M")
    int thr = thrSec <= 0 ? 60 : thrSec
    int lim = maxItems <= 0 ? 13 : math.min(maxItems, 13)
    string res = ""
    int n = 0
    for j = 0 to 12
        if n >= lim
            break
        int rem = f_bcRemainSec(array.get(cdCodes, j), anchorMs)
        if not na(rem) and rem > 0 and rem < thr
            string one = array.get(cdNames, j) + ":" + str.tostring(rem) + "s"
            res := res == "" ? one : res + " " + one
            n := n + 1
    res

//══════════════════════════════════════════════════════════════════
// [BO SUNG - THEO YEU CAU] f_previewPivRsi — XEM TRUOC RSI(5) Wilder + chuoi
//   tang/giam lien tuc cua MOT muc Pivot (khung i, muc k) NHU THE nen TF dang
//   chay dong NGAY BAY GIO, cap nhat THEO TICK (moi lan script chay lai tren
//   nen cuoi, khong doi barstate.isconfirmed). Ham CHI DOC qua array.get(),
//   TUYET DOI KHONG array.set() vao aptEmaLv/aptEmaPrv/aptRsiU/aptRsiD/
//   aptRsiN/aptRsiCur/aptRsiPrv/aptRsiStreak — bay mang trang thai do van
//   CHI duoc ghi trong khoi "if aptTfOk and barstate.isconfirmed" o TREN,
//   GIU NGUYEN 100% tung dong (khong sua mot ky tu nao trong khoi do), tranh
//   dung y het canh bao cua chinh file: ghi var/array ngoai khoi isconfirmed
//   se lam lech chuoi EMA/RSI vi Pine chay lai nhieu lan tren nen dang chay.
//   Cong thuc EMA/RSI ben duoi SAO CHEP y het khoi "4) 19 muc Woodie -> EMA(5)
//   -> RSI(5) Wilder" trong vong cap nhat trang thai (xem tren), CHI khac o
//   cho neo vao gia tri DA CHOT gan nhat (eOld/rsiPrvConfirmed, doc khong
//   sua) thay vi ghi ket qua tro lai. H/L "dang chay" cua khung i lay tu
//   aptCurH/aptCurL (da chot toi M1 gan nhat) GHEP THEM high/low cua CHINH
//   nen M1 dang chay (hai bien nay song theo tick trong Pine) de ra H/L that
//   su tuc thoi cua khung TF, C dung thang close (gia hien tai). Khung dang
//   TAT (f_tfEnabled) hoac chua co RSI da chot (rsiPrvConfirmed = na, tuc con
//   trong giai doan warm-up < APT_RSI_P mau) -> tra na/0, dung y het quy uoc
//   "chua tinh duoc" cua chinh aptRsiCur/aptRsiStreak luc do. KHONG doi mot
//   dong nao cua khoi trang thai/khoi ve da co, KHONG them duong ve, KHONG
//   doi input/setting nao.
f_previewPivRsi(int i, int k) =>
    int gi = i * APT_LVN + k
    float rsiPv = na
    int streakPv = 0
    float eOld = array.get(aptEmaLv, gi)
    float rsiPrvConfirmed = array.get(aptRsiCur, gi)
    float curH = array.get(aptCurHLive, i)
    float curL = array.get(aptCurLLive, i)
    if f_tfEnabled(i) and not na(rsiPrvConfirmed) and not na(eOld) and not na(curH) and not na(curL) and curH >= curL
        float lv = f_woodie(k, curH, curL, close)
        float evPv = (lv - eOld) * (2.0 / (APT_EMA_P + 1)) + eOld
        float u = math.max(evPv - eOld, 0.0)
        float d = math.max(eOld - evPv, 0.0)
        float auPv = (array.get(aptRsiU, gi) * (APT_RSI_P - 1) + u) / APT_RSI_P
        float adPv = (array.get(aptRsiD, gi) * (APT_RSI_P - 1) + d) / APT_RSI_P
        rsiPv := adPv <= 0.0 ? 100.0 : 100.0 - 100.0 / (1.0 + auPv / adPv)
        int prevStreakConfirmed = array.get(aptRsiStreak, gi)
        if rsiPv > rsiPrvConfirmed
            streakPv := prevStreakConfirmed > 0 ? prevStreakConfirmed + 1 : 1
        else if rsiPv < rsiPrvConfirmed
            streakPv := prevStreakConfirmed < 0 ? prevStreakConfirmed - 1 : -1
    [rsiPv, streakPv]

//══════════════════════════════════════════════════════════════════
// [BO SUNG THEO YEU CAU] HANG 8+ — William %R + MA tren RV1(tf)/RV2(tf),
// dung y het WprOnSeries()/SignalMA() cua WPR_rVWAP_Osc.mq5, ap dung
// cho CA 6 khung 1m..2h. Chuoi du lieu "song" = gia live (aptRvLive/
// aptRv2) ghep noi voi lich su da chot (aptRvS/aptRv2S, APT_SAMP_N=12
// mau) — combo index 0 = live (hien tai), index 1..12 = mau da chot
// tu moi (index 1) den cu (index 12).
//══════════════════════════════════════════════════════════════════

// f_rvComboVal: doc gia tri tai combo-index "idx" cua chuoi "song".
//   idx = 0 -> live ; idx = 1..APT_SAMP_N -> hist[tfIdx, idx-1]. Ngoai
//   pham vi -> na (KHONG doc ngoai bien matrix, tranh loi runtime).
f_rvComboVal(float live, matrix<float> hist, int tfIdx, int idx) =>
    float v = na
    if idx == 0
        v := live
    else if idx >= 1 and idx <= APT_SAMP_N
        v := matrix.get(hist, tfIdx, idx - 1)
    v

// [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] f_diffV1V2Str — SAO CHEP
//   y het khoi [SUA DIFFV1V2-01] cua DrawRv2RsiLabels() ben AutoPositionTool_UI.mq5:
//   <diffV1V2> KHONG con la hieu so gia RV1[0]-RV2[0] nua ma la SO NEN LIEN
//   TUC (dem theo combo-index tu 0 lui ve qua khu, dung f_rvComboVal da co
//   san) ma RV1 va RV2 GIU NGUYEN cung mot trang thai so sanh (RV1>=RV2 hay
//   RV1<RV2) so voi trang thai HIEN TAI (combo-index 0) - dem dung khi ca hai
//   chuoi CHUA doi trang thai (thieu du lieu, <= 0, hoac doi chieu thi DUNG
//   dem). Dau: RV1[0]>=RV2[0] -> so DUONG ; RV1[0]<RV2[0] -> so AM. Thieu du
//   lieu tai combo-index 0 -> "-". Gioi han combo-index toi da APT_SAMP_N
//   (dung CHUNG bien voi f_rvComboVal/f_wprShift, KHONG doi hang so nao).
f_diffV1V2Str(float live1, matrix<float> hist1, float live2, matrix<float> hist2, int tfIdx) =>
    string result = "-"
    float v1_0 = f_rvComboVal(live1, hist1, tfIdx, 0)
    float v2_0 = f_rvComboVal(live2, hist2, tfIdx, 0)
    if not na(v1_0) and not na(v2_0) and v1_0 > 0.0 and v2_0 > 0.0
        bool up = v1_0 >= v2_0
        int cnt = 0
        for s = 0 to APT_SAMP_N
            float v1s = f_rvComboVal(live1, hist1, tfIdx, s)
            float v2s = f_rvComboVal(live2, hist2, tfIdx, s)
            bool bad = na(v1s) or na(v2s) or v1s <= 0.0 or v2s <= 0.0 or (v1s >= v2s) != up
            if bad
                break
            cnt := cnt + 1
        result := str.tostring(up ? cnt : -cnt)
    result

// f_wprShift: William %R tai combo-shift "s", nhin lui dung "p" combo-
//   index [s .. s+p-1]. Thieu du lieu (na hoac <= 0 trong cua so) -> na.
f_wprShift(float live, matrix<float> hist, int tfIdx, int s, int p) =>
    bool ok = true
    float hh = na
    float ll = na
    float cur = na
    for j = 0 to p - 1
        float v = f_rvComboVal(live, hist, tfIdx, s + j)
        if na(v) or v <= 0.0
            ok := false
        if not na(v) and (na(hh) or v > hh)
            hh := v
        if not na(v) and (na(ll) or v < ll)
            ll := v
        if j == 0
            cur := v
    float result = na
    if ok
        result := hh == ll ? 0.0 : -100.0 * (hh - cur) / (hh - ll)
    result

// f_wprMa: MA (SMA/EMA) cua chuoi William %R tai combo-shift 0 ("hien
//   tai"), dung "maP" gia tri William %R lien tiep [shift 0..maP-1].
//   EMA seed bang gia tri CU NHAT (khong seed bang SMA cua maP mau nhu
//   MQL5) vi Pine chi co toi da 13 diem/khung — khong du de lam warmup
//   kieu period*4 nhu ben MQL5.
f_wprMa(float live, matrix<float> hist, int tfIdx, int p, int maP, string method) =>
    bool ok = true
    for s = 0 to maP - 1
        if na(f_wprShift(live, hist, tfIdx, s, p))
            ok := false
    float result = na
    if ok
        if method == "SMA"
            float sum = 0.0
            for s = 0 to maP - 1
                sum := sum + f_wprShift(live, hist, tfIdx, s, p)
            result := sum / maP
        else
            float alpha = 2.0 / (maP + 1.0)
            float val = f_wprShift(live, hist, tfIdx, maP - 1, p)
            if maP >= 2
                for s = maP - 2 to 0
                    val := alpha * f_wprShift(live, hist, tfIdx, s, p) + (1.0 - alpha) * val
            result := val
    result

// f_wprTripleStr: go chuoi "{dWPR}/{WPR}/{MA}" — CUNG quy uoc voi
//   WPR_rVWAP_Osc.mq5/AutoPositionTool_UI.mq5: thieu dWPR (shift 1
//   khong tinh duoc) -> bo qua ca dau "/" cua no; MA thieu -> bo qua
//   dau "/" cua rieng no. So nguyen (format "0").
f_wprTripleStr(float live, matrix<float> hist, int tfIdx, int p, int maP, string method) =>
    string txt = ""
    float w0 = f_wprShift(live, hist, tfIdx, 0, p)
    if not na(w0)
        txt := str.tostring(w0, "0")
        float w1 = f_wprShift(live, hist, tfIdx, 1, p)
        if not na(w1)
            txt := str.tostring(w0 - w1, "0") + "/" + txt
        float ma = f_wprMa(live, hist, tfIdx, p, maP, method)
        if not na(ma)
            txt := txt + "/" + str.tostring(ma, "0")
    txt

//══════════════════════════════════════════════════════════════════
// [BO SUNG - THEO YEU CAU] QUET MAU HINH DANG TAO cho 6 khung 1m..2h
// (port logic ChartPatternScanner_Forming). CHI dung OHLC M1 gom theo nB,
// KHONG request.security. Tra ve ten + muc dao + toa do ve (neu co).
//══════════════════════════════════════════════════════════════════
f_tfH(int nB, int sh) =>
    float v = na
    int start = sh * nB
    int span = nB < 1 ? 1 : nB
    for k = 0 to span - 1
        float hk = high[start + k]
        if not na(hk)
            v := na(v) ? hk : math.max(v, hk)
    v

f_tfL(int nB, int sh) =>
    float v = na
    int start = sh * nB
    int span = nB < 1 ? 1 : nB
    for k = 0 to span - 1
        float lk = low[start + k]
        if not na(lk)
            v := na(v) ? lk : math.min(v, lk)
    v

f_tfC(int nB, int sh) =>
    close[sh * nB]

f_tfT(int nB, int sh) =>
    time[sh * nB]

f_patNear(float a, float b, float atr, float tolPct) =>
    float den = math.max(math.abs(a), math.max(math.abs(b), syminfo.mintick))
    float pct = 100.0 * math.abs(a - b) / den
    // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Doi thanh AND cho khop
    // AptPatNearEq() ben AutoPositionTool_UI.mq5 sau [SUA - FIX #3 GIAM SAI
    // DUONG]: phai thoa CA HAI (theo % VA theo ATR) moi coi hai muc gia la
    // gan bang nhau. Ban OR cu qua long tay voi instrument gia cao (XAUUSD:
    // 1.2% cua 3600 = ~43 USD van bi coi la "bang nhau") nen khung 1m khop
    // mau hinh gan nhu lien tuc. Hang so tol GIU NGUYEN 1.2.
    pct <= tolPct and math.abs(a - b) <= atr * 0.35

f_patPct(float a, float b) =>
    float den = math.max(math.abs(a), math.max(math.abs(b), syminfo.mintick))
    100.0 * math.abs(a - b) / den

f_patInWin(int bars, int mn, int mx) =>
    bars >= mn and bars <= mx

f_isPH(int nB, int sh, int leftB, int rightB) =>
    float v = f_tfH(nB, sh)
    // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Doi thanh sh > rightB cho khop
    // AptPatSwingAt() ben MQL5 sau [SUA - FIX #1 CHONG REPAINT]: neu con
    // cho sh == rightB thi pivot gan nhat dung CA nen 0 (dang chay) lam nen
    // xac nhan ben phai -> pivot nhap nhay theo tung tick. Voi sh > rightB,
    // moi pivot chi dung cac nen DA DONG.
    bool ok = not na(v) and sh > rightB
    if ok
        for k = 1 to leftB
            float older = f_tfH(nB, sh + k)
            if not na(older) and older > v
                ok := false
        for k = 1 to rightB
            float newer = f_tfH(nB, sh - k)
            if not na(newer) and newer > v
                ok := false
    ok

f_isPL(int nB, int sh, int leftB, int rightB) =>
    float v = f_tfL(nB, sh)
    // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Xem ghi chu o f_isPH() ngay tren.
    bool ok = not na(v) and sh > rightB
    if ok
        for k = 1 to leftB
            float older = f_tfL(nB, sh + k)
            if not na(older) and older < v
                ok := false
        for k = 1 to rightB
            float newer = f_tfL(nB, sh - k)
            if not na(newer) and newer < v
                ok := false
    ok

// [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Port AptPatTfBars() ben
// AutoPositionTool_UI.mq5 ([SUA - FIX #4 TOI UU DA KHUNG]): quy doi so nen
// pivot / khoang cach swing theo TY LE thoi gian thuc cua tung khung so voi
// M1, thay vi dung nguyen mot bo 5/3/8/80 cho ca 9 khung. MQL5 dung
// scale = sqrt(PeriodSeconds(M1)/PeriodSeconds(tf)); o ban Pine nay tf duoc
// bieu dien bang nB nen M1 => PeriodSeconds(tf) = nB*60 => scale =
// sqrt(1/nB). Khung 1m co nB = 1 -> scale = 1.0 -> ket qua GIONG HET truoc.
f_patTfBars(int baseBars, int nB, int minVal) =>
    int nb = nB < 1 ? 1 : nB
    float scale = math.sqrt(1.0 / nb)
    int v = int(math.round(baseBars * scale))
    v < minVal ? minVal : v

f_patScan(bool on, int nB, float atrIn, float bid) =>
    string name = "-"
    string bias = "BOTH"
    float conf = 0.0
    float revPx = bid
    int mode = 0
    int t1 = na
    int t2 = na
    int t3 = na
    int t4 = na
    float p1 = na
    float p2 = na
    float p3 = na
    float p4 = na
    if on
        // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Bon dong duoi day sao chep y
        // het bon dong dau AptPatScanTF() ben MQL5 (InpPatLeftBars = 5,
        // InpPatRightBars = 3, InpPatMinBars = 8, InpPatMaxBars = 80 la gia
        // tri mac dinh cua nguoi dung, giu nguyen lam "chuan tai M1").
        int leftB = f_patTfBars(5, nB, 2)
        int rightB = f_patTfBars(3, nB, 1)
        int mn = f_patTfBars(8, nB, 3)
        int mx = math.max(mn + 1, f_patTfBars(80, nB, mn + 1))
        float tol = 1.2
        float atr = na(atrIn) or atrIn <= 0.0 ? syminfo.mintick * 10.0 : atrIn
        int maxSh = int(1800 / math.max(1, nB))
        if maxSh > 60
            maxSh := 60
        if maxSh < rightB + 2
            maxSh := rightB + 2
        array<float> hiP = array.new_float()
        array<int> hiS = array.new_int()
        array<float> loP = array.new_float()
        array<int> loS = array.new_int()
        for sh = rightB to maxSh
            if f_isPH(nB, sh, leftB, rightB) and array.size(hiP) < 12
                array.push(hiP, f_tfH(nB, sh))
                array.push(hiS, sh)
            if f_isPL(nB, sh, leftB, rightB) and array.size(loP) < 12
                array.push(loP, f_tfL(nB, sh))
                array.push(loS, sh)
        int nH = array.size(hiP)
        int nL = array.size(loP)
        float h0 = f_tfH(nB, 0)
        float l0 = f_tfL(nB, 0)
        float c0 = f_tfC(nB, 0)
        int tm0 = f_tfT(nB, 0)
        bool candH = true
        bool candL = true
        for k = 1 to leftB
            float hk = f_tfH(nB, k)
            float lk = f_tfL(nB, k)
            if not na(hk) and not na(h0) and hk > h0
                candH := false
            if not na(lk) and not na(l0) and lk < l0
                candL := false
        if nH >= 1 and candH
            int w = array.get(hiS, 0)
            float pH = array.get(hiP, 0)
            if f_patInWin(w, mn, mx) and f_patNear(h0, pH, atr, tol) and h0 <= pH + atr * 0.15
                float mid = f_tfL(1, 0)
                for zz = 1 to math.max(1, w * nB)
                    float mz = low[zz]
                    if not na(mz)
                        mid := math.min(mid, mz)
                if pH - mid >= atr * 0.8 and conf < 70.0
                    name := "2 dinh"
                    bias := "BEAR"
                    conf := 70.0
                    revPx := pH
                    mode := 2
                    t1 := f_tfT(nB, w)
                    p1 := pH
                    t2 := tm0
                    p2 := h0
                    t3 := t1
                    p3 := mid
                    t4 := tm0
                    p4 := mid
        if nL >= 1 and candL
            int w2 = array.get(loS, 0)
            float pL = array.get(loP, 0)
            if f_patInWin(w2, mn, mx) and f_patNear(l0, pL, atr, tol) and l0 >= pL - atr * 0.15
                float mid2 = f_tfH(1, 0)
                for zz2 = 1 to math.max(1, w2 * nB)
                    float mz2 = high[zz2]
                    if not na(mz2)
                        mid2 := math.max(mid2, mz2)
                if mid2 - pL >= atr * 0.8 and conf < 70.0
                    name := "day doi"
                    bias := "BULL"
                    conf := 70.0
                    revPx := pL
                    mode := 2
                    t1 := f_tfT(nB, w2)
                    p1 := pL
                    t2 := tm0
                    p2 := l0
                    t3 := t1
                    p3 := mid2
                    t4 := tm0
                    p4 := mid2
        if nH >= 2
            float a = array.get(hiP, 1)
            float b = array.get(hiP, 0)
            int ba = array.get(hiS, 1)
            int bb = array.get(hiS, 0)
            if f_patInWin(ba - bb, mn, mx) and f_patNear(a, b, atr, tol)
                float neck = f_tfL(1, 0)
                for zn = 1 to math.max(1, ba * nB)
                    float nz = low[zn]
                    if not na(nz)
                        neck := math.min(neck, nz)
                if c0 <= neck + atr * 0.6 and c0 < math.min(a, b) and conf < 80.0
                    name := "2 dinh"
                    bias := "BEAR"
                    conf := 80.0
                    revPx := (a + b) * 0.5
                    mode := 2
                    t1 := f_tfT(nB, ba)
                    p1 := a
                    t2 := f_tfT(nB, bb)
                    p2 := b
                    t3 := t1
                    p3 := neck
                    t4 := tm0
                    p4 := neck
        if nL >= 2
            float a2 = array.get(loP, 1)
            float b2 = array.get(loP, 0)
            int ba2 = array.get(loS, 1)
            int bb2 = array.get(loS, 0)
            if f_patInWin(ba2 - bb2, mn, mx) and f_patNear(a2, b2, atr, tol)
                float neck2 = f_tfH(1, 0)
                for zn2 = 1 to math.max(1, ba2 * nB)
                    float nz2 = high[zn2]
                    if not na(nz2)
                        neck2 := math.max(neck2, nz2)
                if c0 >= neck2 - atr * 0.6 and c0 > math.max(a2, b2) and conf < 80.0
                    name := "day doi"
                    bias := "BULL"
                    conf := 80.0
                    revPx := (a2 + b2) * 0.5
                    mode := 2
                    t1 := f_tfT(nB, ba2)
                    p1 := a2
                    t2 := f_tfT(nB, bb2)
                    p2 := b2
                    t3 := t1
                    p3 := neck2
                    t4 := tm0
                    p4 := neck2
        if nH >= 2 and candH
            float taH = array.get(hiP, 1)
            float tbH = array.get(hiP, 0)
            int saH = array.get(hiS, 1)
            int sbH = array.get(hiS, 0)
            if f_patInWin(saH - sbH, mn, mx) and f_patInWin(sbH, mn, mx) and f_patNear(taH, tbH, atr, tol) and f_patNear(tbH, h0, atr, tol) and conf < 68.0
                name := "3 dinh"
                bias := "BEAR"
                conf := 68.0
                revPx := (taH + tbH + h0) / 3.0
                mode := 3
                t1 := f_tfT(nB, saH)
                p1 := taH
                t2 := f_tfT(nB, sbH)
                p2 := tbH
                t3 := tm0
                p3 := h0
                // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Nhanh mode 3: MQL5 goi
                // AptPatKeep(... , t4 = 0, p4 = 0.0) nen best.t4/p4 luon SACH.
                // Ben Pine phai xoa tay, neu khong se con gia tri thua cua
                // nhanh mode 2 conf thap hon da chay truoc -> f_patTouch doc
                // nham mot muc gia khong thuoc mau hinh dang chon.
                t4 := na
                p4 := na
        if nL >= 2 and candL
            float taL = array.get(loP, 1)
            float tbL = array.get(loP, 0)
            int saL = array.get(loS, 1)
            int sbL = array.get(loS, 0)
            if f_patInWin(saL - sbL, mn, mx) and f_patInWin(sbL, mn, mx) and f_patNear(taL, tbL, atr, tol) and f_patNear(tbL, l0, atr, tol) and conf < 68.0
                name := "3 day"
                bias := "BULL"
                conf := 68.0
                revPx := (taL + tbL + l0) / 3.0
                mode := 3
                t1 := f_tfT(nB, saL)
                p1 := taL
                t2 := f_tfT(nB, sbL)
                p2 := tbL
                t3 := tm0
                p3 := l0
                // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Nhanh mode 3: MQL5 goi
                // AptPatKeep(... , t4 = 0, p4 = 0.0) nen best.t4/p4 luon SACH.
                // Ben Pine phai xoa tay, neu khong se con gia tri thua cua
                // nhanh mode 2 conf thap hon da chay truoc -> f_patTouch doc
                // nham mot muc gia khong thuoc mau hinh dang chon.
                t4 := na
                p4 := na
        if nH >= 3
            float hA = array.get(hiP, 2)
            float hB = array.get(hiP, 1)
            float hC = array.get(hiP, 0)
            if f_patNear(hA, hB, atr, tol) and f_patNear(hB, hC, atr, tol) and conf < 75.0
                name := "3 dinh"
                bias := "BEAR"
                conf := 75.0
                revPx := (hA + hB + hC) / 3.0
                mode := 3
                t1 := f_tfT(nB, array.get(hiS, 2))
                p1 := hA
                t2 := f_tfT(nB, array.get(hiS, 1))
                p2 := hB
                t3 := f_tfT(nB, array.get(hiS, 0))
                p3 := hC
                // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Nhanh mode 3: MQL5 goi
                // AptPatKeep(... , t4 = 0, p4 = 0.0) nen best.t4/p4 luon SACH.
                // Ben Pine phai xoa tay, neu khong se con gia tri thua cua
                // nhanh mode 2 conf thap hon da chay truoc -> f_patTouch doc
                // nham mot muc gia khong thuoc mau hinh dang chon.
                t4 := na
                p4 := na
        if nL >= 3
            float lA = array.get(loP, 2)
            float lB = array.get(loP, 1)
            float lC = array.get(loP, 0)
            if f_patNear(lA, lB, atr, tol) and f_patNear(lB, lC, atr, tol) and conf < 75.0
                name := "3 day"
                bias := "BULL"
                conf := 75.0
                revPx := (lA + lB + lC) / 3.0
                mode := 3
                t1 := f_tfT(nB, array.get(loS, 2))
                p1 := lA
                t2 := f_tfT(nB, array.get(loS, 1))
                p2 := lB
                t3 := f_tfT(nB, array.get(loS, 0))
                p3 := lC
                // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Nhanh mode 3: MQL5 goi
                // AptPatKeep(... , t4 = 0, p4 = 0.0) nen best.t4/p4 luon SACH.
                // Ben Pine phai xoa tay, neu khong se con gia tri thua cua
                // nhanh mode 2 conf thap hon da chay truoc -> f_patTouch doc
                // nham mot muc gia khong thuoc mau hinh dang chon.
                t4 := na
                p4 := na
        float headMin = atr * 0.8
        if nH >= 2 and nL >= 1 and candH
            float ls = array.get(hiP, 1)
            float hd = array.get(hiP, 0)
            int lsB = array.get(hiS, 1)
            int hdB = array.get(hiS, 0)
            if hdB > lsB and hd > ls + headMin and hd > h0 + headMin and f_patPct(ls, h0) <= 35.0 and f_patInWin(hdB - lsB, mn, mx) and f_patInWin(hdB, mn, mx) and conf < 72.0
                name := "VDV"
                bias := "BEAR"
                conf := 72.0
                revPx := hd
                mode := 3
                t1 := f_tfT(nB, lsB)
                p1 := ls
                t2 := f_tfT(nB, hdB)
                p2 := hd
                t3 := tm0
                p3 := h0
                // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Nhanh mode 3: MQL5 goi
                // AptPatKeep(... , t4 = 0, p4 = 0.0) nen best.t4/p4 luon SACH.
                // Ben Pine phai xoa tay, neu khong se con gia tri thua cua
                // nhanh mode 2 conf thap hon da chay truoc -> f_patTouch doc
                // nham mot muc gia khong thuoc mau hinh dang chon.
                t4 := na
                p4 := na
        if nL >= 2 and nH >= 1 and candL
            float ls2 = array.get(loP, 1)
            float hd2 = array.get(loP, 0)
            int lsB2 = array.get(loS, 1)
            int hdB2 = array.get(loS, 0)
            if hdB2 > lsB2 and hd2 < ls2 - headMin and hd2 < l0 - headMin and f_patPct(ls2, l0) <= 35.0 and f_patInWin(hdB2 - lsB2, mn, mx) and f_patInWin(hdB2, mn, mx) and conf < 72.0
                name := "VDV nguoc"
                bias := "BULL"
                conf := 72.0
                revPx := hd2
                mode := 3
                t1 := f_tfT(nB, lsB2)
                p1 := ls2
                t2 := f_tfT(nB, hdB2)
                p2 := hd2
                t3 := tm0
                p3 := l0
                // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Nhanh mode 3: MQL5 goi
                // AptPatKeep(... , t4 = 0, p4 = 0.0) nen best.t4/p4 luon SACH.
                // Ben Pine phai xoa tay, neu khong se con gia tri thua cua
                // nhanh mode 2 conf thap hon da chay truoc -> f_patTouch doc
                // nham mot muc gia khong thuoc mau hinh dang chon.
                t4 := na
                p4 := na
        if nH >= 3
            float ls3 = array.get(hiP, 2)
            float hd3 = array.get(hiP, 1)
            float rs3 = array.get(hiP, 0)
            if hd3 > ls3 + headMin and hd3 > rs3 + headMin and f_patPct(ls3, rs3) <= 35.0 and conf < 82.0
                name := "VDV"
                bias := "BEAR"
                conf := 82.0
                revPx := hd3
                mode := 3
                t1 := f_tfT(nB, array.get(hiS, 2))
                p1 := ls3
                t2 := f_tfT(nB, array.get(hiS, 1))
                p2 := hd3
                t3 := f_tfT(nB, array.get(hiS, 0))
                p3 := rs3
                // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Nhanh mode 3: MQL5 goi
                // AptPatKeep(... , t4 = 0, p4 = 0.0) nen best.t4/p4 luon SACH.
                // Ben Pine phai xoa tay, neu khong se con gia tri thua cua
                // nhanh mode 2 conf thap hon da chay truoc -> f_patTouch doc
                // nham mot muc gia khong thuoc mau hinh dang chon.
                t4 := na
                p4 := na
        if nL >= 3
            float ls4 = array.get(loP, 2)
            float hd4 = array.get(loP, 1)
            float rs4 = array.get(loP, 0)
            if hd4 < ls4 - headMin and hd4 < rs4 - headMin and f_patPct(ls4, rs4) <= 35.0 and conf < 82.0
                name := "VDV nguoc"
                bias := "BULL"
                conf := 82.0
                revPx := hd4
                mode := 3
                t1 := f_tfT(nB, array.get(loS, 2))
                p1 := ls4
                t2 := f_tfT(nB, array.get(loS, 1))
                p2 := hd4
                t3 := f_tfT(nB, array.get(loS, 0))
                p3 := rs4
                // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Nhanh mode 3: MQL5 goi
                // AptPatKeep(... , t4 = 0, p4 = 0.0) nen best.t4/p4 luon SACH.
                // Ben Pine phai xoa tay, neu khong se con gia tri thua cua
                // nhanh mode 2 conf thap hon da chay truoc -> f_patTouch doc
                // nham mot muc gia khong thuoc mau hinh dang chon.
                t4 := na
                p4 := na
        if nH >= 2 and nL >= 2
            float hh1 = array.get(hiP, 1)
            float hh0 = array.get(hiP, 0)
            float ll1 = array.get(loP, 1)
            float ll0 = array.get(loP, 0)
            int hb1 = array.get(hiS, 1)
            int hb0 = array.get(hiS, 0)
            int lb1 = array.get(loS, 1)
            int lb0 = array.get(loS, 0)
            float sh = (hh0 - hh1) / math.max(1, hb1 - hb0)
            float sl = (ll0 - ll1) / math.max(1, lb1 - lb0)
            float startGap = math.abs(hh1 - ll1)
            float endGap = math.abs(hh0 - ll0)
            bool squeeze = endGap < startGap * 0.85 and startGap > atr * 0.8
            bool flatH = math.abs(sh) < atr * 0.02
            bool flatL = math.abs(sl) < atr * 0.02
            float projH = hh0 + sh * (0 - hb0)
            float projL = ll0 + sl * (0 - lb0)
            bool inside = c0 < math.max(projH, hh0) + atr * 0.15 and c0 > math.min(projL, ll0) - atr * 0.15
            int span = math.max(hb0, lb0) - math.min(hb1, lb1)
            if squeeze and inside and f_patInWin(span, mn, mx)
                if flatH and sl > 0.0 and conf < 74.0
                    name := "tam giac tang"
                    bias := "BULL"
                    conf := 74.0
                    revPx := projH
                    mode := 2
                    t1 := f_tfT(nB, hb1)
                    p1 := hh1
                    t2 := tm0
                    p2 := projH
                    t3 := f_tfT(nB, lb1)
                    p3 := ll1
                    t4 := tm0
                    p4 := projL
                else if flatL and sh < 0.0 and conf < 74.0
                    name := "tam giac giam"
                    bias := "BEAR"
                    conf := 74.0
                    revPx := projL
                    mode := 2
                    t1 := f_tfT(nB, hb1)
                    p1 := hh1
                    t2 := tm0
                    p2 := projH
                    t3 := f_tfT(nB, lb1)
                    p3 := ll1
                    t4 := tm0
                    p4 := projL
                else if sh < 0.0 and sl > 0.0 and conf < 72.0
                    name := "tam giac can"
                    bias := "BOTH"
                    conf := 72.0
                    revPx := (projH + projL) * 0.5
                    mode := 2
                    t1 := f_tfT(nB, hb1)
                    p1 := hh1
                    t2 := tm0
                    p2 := projH
                    t3 := f_tfT(nB, lb1)
                    p3 := ll1
                    t4 := tm0
                    p4 := projL
            bool squeezeW = endGap < startGap * 0.8
            bool insideW = c0 <= math.max(projH, hh0) + atr * 0.2 and c0 >= math.min(projL, ll0) - atr * 0.2
            if squeezeW and insideW
                if sh > 0.0 and sl > 0.0 and conf < 66.0
                    name := "nem tang"
                    bias := "BEAR"
                    conf := 66.0
                    revPx := projH
                    mode := 2
                    t1 := f_tfT(nB, hb1)
                    p1 := hh1
                    t2 := tm0
                    p2 := projH
                    t3 := f_tfT(nB, lb1)
                    p3 := ll1
                    t4 := tm0
                    p4 := projL
                else if sh < 0.0 and sl < 0.0 and conf < 66.0
                    name := "nem giam"
                    bias := "BULL"
                    conf := 66.0
                    revPx := projL
                    mode := 2
                    t1 := f_tfT(nB, hb1)
                    p1 := hh1
                    t2 := tm0
                    p2 := projH
                    t3 := f_tfT(nB, lb1)
                    p3 := ll1
                    t4 := tm0
                    p4 := projL
            bool okH = f_patNear(hh0, hh1, atr, tol)
            bool okL = f_patNear(ll0, ll1, atr, tol)
            float height = (hh0 + hh1) * 0.5 - (ll0 + ll1) * 0.5
            bool insideR = c0 <= math.max(hh0, hh1) + atr * 0.15 and c0 >= math.min(ll0, ll1) - atr * 0.15
            int spanR = math.min(hb1, lb1)
            if okH and okL and height > atr * 0.7 and insideR and spanR >= mn and conf < 70.0
                name := "cn tich luy"
                bias := "BOTH"
                conf := 70.0
                revPx := (hh0 + ll0) * 0.5
                mode := 2
                t1 := f_tfT(nB, hb1)
                p1 := hh1
                t2 := tm0
                p2 := hh0
                t3 := f_tfT(nB, lb1)
                p3 := ll1
                t4 := tm0
                p4 := ll0
    [name, bias, conf, revPx, mode, t1, p1, t2, p2, t3, p3, t4, p4]

// [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Port AptPatLinePriceAt() ben
// AutoPositionTool_UI.mq5: gia tren doan (t1,p1)-(t2,p2) tai moc atT, noi
// suy / keo dai TUYEN TINH. Tra na neu doan khong hop le (MQL5 tra 0.0).
f_patSegAt(int t1, float p1, int t2, float p2, int atT) =>
    float px = na
    if not na(t1) and not na(t2) and not na(p1) and not na(p2) and t1 > 0 and t2 > 0 and p1 > 0.0 and p2 > 0.0
        int dt = t2 - t1
        if dt == 0
            px := p2
        else
            // Ep float TRUOC khi chia: trong Pine phep chia hai so int tra ve
            // int (cat phan thap phan) - de nguyen se lam he so noi suy k roi
            // ve 0/1 va duong bi ve sai hoan toan.
            float k = float(atT - t1) / float(dt)
            px := p1 + (p2 - p1) * k
    na(px) or px <= 0.0 ? na : px

// [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Port AptPatTouchPrice() ben MQL5:
// muc gia ma Bid se "cham" vao duong hinh mau, do TAI THOI DIEM HIEN TAI
// (keo dai doan toi timenow), lay DUNG tap doan ma khoi ve dang ve:
//   mode 2 -> L1 (t1,p1)-(t2,p2) + L2 (t3,p3)-(t4,p4)
//   mode 3 -> L1 (t1,p1)-(t2,p2) + L2 (t2,p2)-(t3,p3)
// Mau co nhieu duong thi chon duong SAT BID NHAT. Tra na neu khong do duoc
// (noi goi se roi ve revPx nhu cu, dung y nhanh fallback ben MQL5).
f_patTouch(int mode, int t1, float p1, int t2, float p2, int t3, float p3, int t4, float p4, float bid) =>
    int atT = timenow
    float best = f_patSegAt(t1, p1, t2, p2, atT)
    if mode == 2
        float px2 = f_patSegAt(t3, p3, t4, p4, atT)
        if not na(px2) and (na(best) or math.abs(bid - px2) < math.abs(bid - best))
            best := px2
    else if mode == 3
        float px3 = f_patSegAt(t2, p2, t3, p3, atT)
        if not na(px3) and (na(best) or math.abs(bid - px3) < math.abs(bid - best))
            best := px3
        // MQL5 con xet them p4 (duong nam ngang cua "noc tron"/"day tron").
        // Ban Pine chua port hai mau do nen p4 o mode 3 luon na (xem khoi
        // don t4/p4 trong f_patScan) - nhanh nay giu lai cho khop cau truc.
        if not na(p4) and p4 > 0.0 and (na(best) or math.abs(bid - p4) < math.abs(bid - best))
            best := p4
    best

// [CAP NHAT THEO YEU CAU - MQ5SYNC-01] (LICH SU) Them tham so touchPx cho
// khop AptPatRowText() ben MQL5: khoang cach = Bid - gia tren duong hinh
// mau cua CHINH khung nay tai hien tai; touchPx khong do duoc thi roi ve
// revPx.
// [BO SUNG - THEO YEU CAU] (LICH SU) Them tham so asymVal (ket qua
// f_tickPressureAsym() cua CHINH khung nay, tinh o noi goi va truyen vao) -
// noi THEM " A<+/-x.xx>" vao CUOI CUNG chuoi hien thi khi asymVal KHONG na.
// [CAP NHAT PAT-MOVE-01 - THEO YEU CAU] BO <khoang cach gia> (str.tostring
// (bid - px, ...)) VA CAT <ten mau hinh> (name) RA KHOI nhan Pattern - name
// CHUYEN sang nhan RV1 (hang 2 cua rieng khung 1m, xem khoi "[CAP NHAT
// PAT-MOVE-01]" trong vong lap "for i" o (6) COT NHAN PATTERN, ngay sau
// dong "string txtPat = f_patTxt(...)"). Pine KHONG co bo quet nen dao
// chieu tuong duong AptCdlScanTF/SAptCdl ben MQL5 nen KHONG co gi tuong
// duong "<TenNenDaoChieu><mui ten>" de chuyen cho nhan RV1 cua khung 5m
// tro len (ben MQL5 CHI phan do duoc chuyen cho 5m tro len, con <ten mau
// hinh> von CHI danh cho hang 2 cua 1m) - KHONG bia them tinh nang moi.
// Tham so revPx/touchPx/bid VAN duoc tham so hoa/truyen vao nhu cu (KHONG
// doi chu ky ham, KHONG doi noi goi f_patTxt() o (6)); bien px VAN duoc
// tinh (chi con dung de xet dieu kien hop le "na(px)", KHONG con dung de
// in ra chuoi). name=="-" VAN dung de phan biet "co pattern"/"khong co
// pattern" (giu dau "-", chi khong con in TEN pattern). Truong <asym>
// KHONG doi, van noi vao CUOI CUNG nhu truoc.
f_patTxt(string tfn, string name, float revPx, float touchPx, float bid, float asymVal) =>
    float px = na(touchPx) or touchPx <= 0.0 ? revPx : touchPx
    string base = na(px) or name == "-" ? tfn + " -" : tfn
    string result = na(asymVal) ? base : base + " " + "A" + (asymVal >= 0 ? "+" : "") + str.tostring(asymVal, "0.00")
    result

f_patClr(string bias) =>
    bias == "BULL" ? color.lime : bias == "BEAR" ? color.orange : color.silver

//══════════════════════════════════════════════════════════════════
// [SUA MQL5SYNC-02 - THEO YEU CAU] HAM PORT MOI tu AutoPositionTool_UI.mq5 (ban hien tai) - phuc vu 3 nhan:
//   NHAN PIVOT : <TF>[ <lamtron>] (<Pivotdiff>/<Pivotdiff2>)<diffpv> <SpR2>/<SpR1> <RV1MD>/<RV1OW>(<so nen>/<diffV1V2>) <TenMuc> <RSI> <RSI5>/<xu huong>
//   NHAN RV1   : <TF> {<T>}[<W%>]<pls><IMB>{<erh>/<erhdiff> <erl>/<erldiff>}[ <SigBrk><brkD>(<streak>)]<FVG>
//   NHAN RV2   : <TF> <MA1> /<MA2> [<RV1W%>] <RV1erh>/<..> <RV1erl>/<..> [<RV2W%>] <RV2erh>/<..> <RV2erl>/<..>
// Tat ca CHI DOC du lieu da co (aptHb* = lich su nen TF da dong, aptRvS/aptRv2S = lich su RV1/RV2), KHONG ve gi.
//══════════════════════════════════════════════════════════════════

// --- Dinh dang so co dinh N chu so thap phan (thay cho DoubleToString) ---
f_fixed(float v, int dec) =>
    string out = "-"
    if not na(v)
        float p = math.pow(10.0, dec)
        float a = math.round(math.abs(v) * p)
        float ip = math.floor(a / p)
        float fp = a - ip * p
        string fs = str.tostring(int(fp))
        while str.length(fs) < dec
            fs := "0" + fs
        out := (v < 0.0 and a > 0.0 ? "-" : "") + str.tostring(int(ip)) + (dec > 0 ? "." + fs : "")
    out

// --- AptBrkAccSecToStr: giay -> "30s" / "1.30s" ---
f_secStr(float secs) =>
    int s = int(math.max(secs, 0.0))
    string r = ""
    if s < 60
        r := str.tostring(s) + "s"
    else
        int m = int(s / 60)
        int ss = s % 60
        r := str.tostring(m) + "." + (ss < 10 ? "0" : "") + str.tostring(ss) + "s"
    r

// --- FormatRemain(g_barTF): thoi gian con lai den nen moi cua khung than nen lon ---
f_formatRemain(int nBmin, int anchorMs) =>
    int rem = f_bcRemainSec(nBmin, anchorMs)
    string r = "--"
    if not na(rem)
        int remain = math.max(rem, 0)
        if nBmin * 60 >= 900
            int h = int(remain / 3600)
            int m = int((remain % 3600) / 60)
            r := h > 0 ? str.tostring(h) + "h" + (m < 10 ? "0" : "") + str.tostring(m) + "m" : str.tostring(m) + "m"
        else if remain >= 60
            r := str.tostring(int(remain / 60)) + "." + str.tostring(remain % 60) + "s"
        else
            r := str.tostring(remain) + "s"
    r

// --- AptRoundNearStr: <lamtron> cua muc R1..R9 / S1..S9 (R: boi so nho nhat >= gia, cach <= W; S: boi so lon nhat < gia, cach <= W) ---
f_roundNear(string tenMuc, float lvlPx) =>
    string r = ""
    if str.length(tenMuc) == 2 and not na(lvlPx) and lvlPx > 0.0
        string c0 = str.substring(tenMuc, 0, 1)
        float c1 = str.tonumber(str.substring(tenMuc, 1, 2))
        if not na(c1) and c1 >= 1.0 and c1 <= 9.0
            float stp = i_rndStep
            float q = math.ceil(lvlPx / stp - 1e-9)
            float v = na
            if c0 == "R"
                v := q * stp
                if v - lvlPx > i_rndRange
                    v := na
            else if c0 == "S"
                v := (q - 1.0) * stp
                if lvlPx - v > i_rndRange
                    v := na
            if not na(v)
                r := str.tostring(int(math.round(v)))
    r

// --- round((a - b) / spread) dang chuoi so nguyen; thieu -> "-" ---
f_spRound(float a, float b) =>
    na(a) or na(b) or aptSpreadPx <= 0.0 ? "-" : str.tostring(math.round((a - b) / aptSpreadPx))

// --- (a - b) / spread, 1 chu so thap phan (M1_ELP_LBL_DIF1_DIGITS = 1) ---
f_spDiff1(float a, float b) =>
    na(a) or na(b) or aptSpreadPx <= 0.0 ? "-" : str.tostring((a - b) / aptSpreadPx, "0.0")

// --- Kenh HH/LL cua n nen TF DA DONG bat dau tu shift startShift (AptBrkDAt / AptBrkWAt) ---
f_chanHL(int i, int n, int startShift) =>
    float hh = na
    float ll = na
    bool ok = n >= 1
    if ok
        for j = 0 to n - 1
            float hj = f_hbGet(aptHbH, i, startShift + j)
            float lj = f_hbGet(aptHbL, i, startShift + j)
            if na(hj) or na(lj)
                ok := false
                break
            hh := na(hh) ? hj : math.max(hh, hj)
            ll := na(ll) ? lj : math.min(ll, lj)
    [ok ? hh : na, ok ? ll : na]

// --- AptBrkWAt: W% = (HH - Close)/(HH - LL) * -100 (px = gia hien tai) ---
f_brkW(int i, int n, float px) =>
    [hh, ll] = f_chanHL(i, n, 1)
    float r = na
    if not na(hh) and not na(ll) and not na(px) and px > 0.0 and hh - ll > 0.0
        r := math.round((hh - px) / (hh - ll) * -100.0)
    r

// --- AptBrkStreakCount: so nen LIEN TIEP (gom nen hien tai) brkD o vung cuc tri ---
//   brkNow >= 50 -> so nen co brkD > 90 ; brkNow < 50 -> so nen co brkD < 10 ; nen hien tai khong thoa -> 0
f_brkStreakM(int i, int n, int brkNow) =>
    int hiC = 0
    int loC = 0
    bool hiA = true
    bool loA = true
    for k = 1 to APT_BRKD_STRK_MAX
        [hh, ll] = f_chanHL(i, n, k + 1)
        float ck = f_hbGet(aptHbC, i, k)
        if na(hh) or na(ll) or na(ck) or hh - ll <= 0.0
            break
        float b = math.round((ck - ll) / (hh - ll) * 100.0)
        if hiA
            if b > 90.0
                hiC += 1
            else
                hiA := false
        if loA
            if b < 10.0
                loC += 1
            else
                loA := false
        if not hiA and not loA
            break
    int tot = 0
    if brkNow >= 50
        if brkNow > 90
            tot := hiC + 1
    else
        if brkNow < 10
            tot := loC + 1
    math.min(tot, APT_BRKD_STRK_MAX)

// --- AptHHLLStrengthStr: <T> = suc manh chuoi 5 kenh HH/LL (chu ky p) ---
f_hhllStr(int i, int p) =>
    string out = ""
    float wSum = 0.0
    float hh0 = na
    float ll0 = na
    float hh4 = na
    float ll4 = na
    bool ok = true
    for k = 0 to 4
        [h, l] = f_chanHL(i, p, 1 + k)
        if na(h) or na(l)
            ok := false
        else
            wSum += h - l
            if k == 0
                hh0 := h
                ll0 := l
            if k == 4
                hh4 := h
                ll4 := l
    float wAvg = wSum / 5.0
    if ok and wAvg > 0.0
        float t = ((hh0 - hh4) + (ll0 - ll4)) / (2.0 * wAvg)
        t := math.round(t * 10.0) / 10.0 + 0.0
        out := (t >= 0.0 ? "+" : "") + str.tostring(t, "0.0")
    out

// --- AptRsiEmaLast: EMA(RSI(src, p), p) tai phan tu moi nhat + gia tri lien truoc (src: cu nhat -> moi nhat) ---
f_rsiEmaLast(array<float> src, int m, int p) =>
    float outV = na
    float outP = na
    if p >= 2 and m >= 2 * p + 1
        float ag = 0.0
        float al = 0.0
        for t = 1 to p
            float d0 = array.get(src, t) - array.get(src, t - 1)
            if d0 > 0.0
                ag += d0
            else
                al -= d0
        ag := ag / p
        al := al / p
        float alpha = 2.0 / (p + 1.0)
        float ema = 0.0
        float prevEma = 0.0
        float rsiSum = 0.0
        int rsiCnt = 0
        for t = p to m - 1
            if t > p
                float d = array.get(src, t) - array.get(src, t - 1)
                float g = d > 0.0 ? d : 0.0
                float ls = d < 0.0 ? -d : 0.0
                ag := (ag * (p - 1) + g) / p
                al := (al * (p - 1) + ls) / p
            float rsi = al <= 0.0 ? (ag > 0.0 ? 100.0 : 50.0) : 100.0 - 100.0 / (1.0 + ag / al)
            rsiCnt += 1
            if rsiCnt <= p
                rsiSum += rsi
                if rsiCnt == p
                    ema := rsiSum / p
            else
                prevEma := ema
                ema := ema + alpha * (rsi - ema)
        outV := ema
        outP := prevEma
    [outV, outP]

// --- erh/erl: hs/ls = chuoi cu nhat -> moi nhat (cnt phan tu); cua so truot p -> HH/LL; "<erh>/<erhdiff> <erl>/<erldiff>" ---
f_erCore(array<float> hs, array<float> ls, int cnt, int p) =>
    string res = ""
    int m = cnt - p + 1
    if p >= 2 and m >= 2 * p + 1
        array<float> hhS = array.new_float(m, na)
        array<float> llS = array.new_float(m, na)
        for a = 0 to m - 1
            float hmx = array.get(hs, a)
            float lmn = array.get(ls, a)
            for b = a + 1 to a + p - 1
                hmx := math.max(hmx, array.get(hs, b))
                lmn := math.min(lmn, array.get(ls, b))
            array.set(hhS, a, hmx)
            array.set(llS, a, lmn)
        [erh, erhP] = f_rsiEmaLast(hhS, m, p)
        [erl, erlP] = f_rsiEmaLast(llS, m, p)
        if not na(erh) and not na(erhP) and not na(erl) and not na(erlP)
            int dh = int(math.round(erh - erhP))
            int dl = int(math.round(erl - erlP))
            res := str.tostring(int(math.round(erh))) + "/" + (dh > 0 ? "+" : "") + str.tostring(dh) + " " + str.tostring(int(math.round(erl))) + "/" + (dl > 0 ? "+" : "") + str.tostring(dl)
    res

// --- AptErhErlStr: erh/erl cua kenh brkD GIA (High/Low nen TF da dong) ---
f_priceEr(int i, int p) =>
    string r = ""
    int closed = array.get(aptHbCnt, i)
    int m = math.min(4 * p + 1, closed - p)
    if p >= 2 and m >= 2 * p + 1
        int cnt = p + m - 1
        if cnt <= closed
            array<float> hs = array.new_float(0)
            array<float> ls = array.new_float(0)
            bool ok = true
            for j = 0 to cnt - 1
                float h = f_hbGet(aptHbH, i, cnt - j)
                float l = f_hbGet(aptHbL, i, cnt - j)
                if na(h) or na(l)
                    ok := false
                array.push(hs, nz(h))
                array.push(ls, nz(l))
            if ok
                r := f_erCore(hs, ls, cnt, p)
    r

// --- So mau RV lien tiep hop le (>0) tu combo-index 0 (live) lui ve qua khu ---
f_rvValid(float live, matrix<float> hist, int tfIdx) =>
    int cnt = 0
    for s = 0 to APT_SAMP_N
        float v = f_rvComboVal(live, hist, tfIdx, s)
        if na(v) or v <= 0.0
            break
        cnt += 1
    cnt

// --- AptRvChanW: [W%] cua RV hien tai trong kenh p gia tri RV da dong truoc do (khong kep) ---
f_rvChanW(float live, matrix<float> hist, int tfIdx, int valid, int p) =>
    string out = "-"
    if p >= 1 and valid >= p + 1
        float cur = f_rvComboVal(live, hist, tfIdx, 0)
        float hh = na
        float ll = na
        for j = 1 to p
            float v = f_rvComboVal(live, hist, tfIdx, j)
            hh := na(hh) ? v : math.max(hh, v)
            ll := na(ll) ? v : math.min(ll, v)
        if hh - ll > 0.0
            out := str.tostring(int(math.round((hh - cur) / (hh - ll) * -100.0)))
    out

// --- AptRvChanErStr: erh/erl tinh tren chuoi RV (rv[1..cnt], khong gom rv[0]) ---
f_rvChanEr(float live, matrix<float> hist, int tfIdx, int valid, int p) =>
    string out = "-/- -/-"
    int m = math.min(4 * p + 1, valid - p)
    if p >= 2 and m >= 2 * p + 1
        int cnt = p + m - 1
        if cnt <= APT_SAMP_N
            array<float> vals = array.new_float(0)
            for j = 0 to cnt - 1
                array.push(vals, f_rvComboVal(live, hist, tfIdx, cnt - j))
            string r = f_erCore(vals, vals, cnt, p)
            if r != ""
                out := r
    out

// --- Wpr8UnclampedAt: William %R KHONG kep, HH/LL tren p phan tu TRUOC [s+1 .. s+p] (khong gom phan tu hien tai) ---
f_wprUn(float live, matrix<float> hist, int tfIdx, int s, int p, int valid) =>
    float r = na
    if s >= 0 and p >= 1 and s + 1 + p <= valid
        float hh = na
        float ll = na
        for j = 1 to p
            float v = f_rvComboVal(live, hist, tfIdx, s + j)
            hh := na(hh) ? v : math.max(hh, v)
            ll := na(ll) ? v : math.min(ll, v)
        float cur = f_rvComboVal(live, hist, tfIdx, s)
        r := hh == ll ? 0.0 : -100.0 * (hh - cur) / (hh - ll)
    r

// --- Wpr8BuildMaStr: <MA> cua William %R (SMA/EMA; EMA seed = SMA cac mau CU NHAT, nhu MQL5), so nguyen; thieu -> "" ---
f_wprMaM(float live, matrix<float> hist, int tfIdx, int p, int maP, string method, int valid) =>
    string out = ""
    float w0 = f_wprUn(live, hist, tfIdx, 0, p, valid)
    if not na(w0)
        int needW = math.max(maP * 4, maP + 2)
        array<float> wArr = array.new_float(0)
        for j = 0 to needW - 1
            float v = f_wprUn(live, hist, tfIdx, j, p, valid)
            if na(v)
                break
            array.push(wArr, v)
        int vw = array.size(wArr)
        float ma = na
        if maP <= 1
            ma := vw >= 1 ? array.get(wArr, 0) : na
        else if vw >= maP
            if method == "SMA"
                float sm = 0.0
                for j = 0 to maP - 1
                    sm += array.get(wArr, j)
                ma := sm / maP
            else if vw >= maP + 1
                float seed = 0.0
                for s = vw - 1 to vw - maP
                    seed += array.get(wArr, s)
                float ev = seed / maP
                float alpha = 2.0 / (maP + 1.0)
                for s = vw - maP - 1 to 0
                    ev := alpha * array.get(wArr, s) + (1.0 - alpha) * ev
                ma := ev
        if not na(ma)
            out := str.tostring(ma, "0")
    out

// --- AptOpenLwma: OW = LWMA(Open, n) cua n nen TF DA DONG (trong so n..1, nen moi nhat nang nhat) ---
f_owLwma(int i, int n) =>
    float r = na
    if n >= 2 and array.get(aptHbCnt, i) >= n + 1
        float sw = 0.0
        float sv = 0.0
        bool ok = true
        for j = 0 to n - 1
            float o = f_hbGet(aptHbO, i, j + 1)
            if na(o)
                ok := false
                break
            float w = n - j
            sw += w
            sv += w * o
        if ok and sw > 0.0
            r := sv / sw
    r

// --- MD = trung binh Open cua n nen TF DA DONG gan nhat ---
f_mdAvg(int i, int n) =>
    float r = na
    if n >= 2 and array.get(aptHbCnt, i) >= n
        float sm = 0.0
        bool ok = true
        for j = 1 to n
            float o = f_hbGet(aptHbO, i, j)
            if na(o)
                ok := false
                break
            sm += o
        if ok
            r := sm / n
    r

// --- EMA Pivot (muc k) cua khung i: gia tri LIVE (them nen TF dang chay) va gia tri DA CHOT lien truoc ---
f_pvEmaLive(int i, int k) =>
    int gi = i * APT_LVN + k
    float eOld = array.get(aptEmaLv, gi)
    float curH = array.get(aptCurHLive, i)
    float curL = array.get(aptCurLLive, i)
    float ev0 = na
    if f_tfEnabled(i) and not na(eOld) and not na(curH) and not na(curL) and curH >= curL
        float lv = f_woodie(k, curH, curL, close)
        ev0 := (lv - eOld) * (2.0 / (APT_EMA_P + 1)) + eOld
    [ev0, eOld]

// --- Theo doi thoi diem Pivot vua cat LWMA(Open) NGAY TRONG nen TF dang chay (g_aptRvXC0Bar/Side/T/Px ben MQL5) ---
varip array<int> aptCutBar = array.new_int(APT_TFN, -1)
varip array<int> aptCutSide = array.new_int(APT_TFN, 0)
varip array<float> aptCutT = array.new_float(APT_TFN, na)
varip array<float> aptCutPx = array.new_float(APT_TFN, na)

// --- AptRv1LwmaCrossCnt(kind=1) + AptPlsStr: tra [<so nen>, <pls>] ---
//   Pivot = EMA(5) cua muc lvl (nen s>=1 dung H/L/C cua nen s+1 - y het AptPivotUiEmaSeries); LWMA(Open) tai nen k dung Open cua nen k..k+n-1.
//   <so nen> = so nen TF lien tiep Pivot o CUNG phia LWMA (gom nen dang chay); duong = Pivot tren LWMA. cnt = na khi thieu du lieu.
//   <pls> = |Bid - Pivot luc cat| / so giay tu luc cat (dau theo huong cat); khong co diem cat -> "-".
f_pivCross(int i, int n, int lvl, float bid) =>
    int cntOut = na
    string plsOut = "-"
    int cl = array.get(aptHbCnt, i)
    float aE = 2.0 / (APT_EMA_P + 1.0)
    if n >= 2 and cl >= n + 2 and f_tfEnabled(i)
        int jMax = cl - 1
        array<float> pe = array.new_float(jMax + 2, na)
        float e = na
        for j = jMax to 1
            float hB = f_hbGet(aptHbH, i, j + 1)
            float lB = f_hbGet(aptHbL, i, j + 1)
            float cB = f_hbGet(aptHbC, i, j + 1)
            if not na(hB) and not na(lB) and not na(cB)
                float raw = f_woodie(lvl, hB, lB, cB)
                e := na(e) ? raw : aE * raw + (1.0 - aE) * e
            array.set(pe, j, e)
        float lw1 = na
        int side1 = 0
        int run = 0
        bool found = false
        bool bad = false
        int kMax = math.min(jMax, cl - n + 1)
        if kMax >= 1
            for k = 1 to kMax
                float sv = 0.0
                float sw = 0.0
                for j = 0 to n - 1
                    float o = f_hbGet(aptHbO, i, k + j)
                    if na(o)
                        bad := true
                        break
                    float w = n - j
                    sv += w * o
                    sw += w
                if bad or sw <= 0.0
                    bad := true
                    break
                float lw = sv / sw
                float ek = array.get(pe, k)
                if na(ek) or not (lw > 0.0)
                    bad := true
                    break
                int side = ek > lw ? 1 : ek < lw ? -1 : 0
                if k == 1
                    lw1 := lw
                    side1 := side
                    run := 1
                else
                    if side != side1
                        found := true
                        break
                    run += 1
        float ek1 = array.get(pe, 1)
        float curH = array.get(aptCurHLive, i)
        float curL = array.get(aptCurLLive, i)
        if not bad and not na(lw1) and not na(ek1) and not na(curH) and not na(curL) and curH >= curL
            float curV = aE * f_woodie(lvl, curH, curL, close) + (1.0 - aE) * ek1
            int sideNow = curV > lw1 ? 1 : curV < lw1 ? -1 : 0
            if sideNow == 0
                cntOut := 0
                array.set(aptCutBar, i, -1)
            else
                int cnt = 1
                if sideNow == side1
                    cnt += run
                    array.set(aptCutBar, i, -1)
                else
                    int bk = nz(array.get(aptBk, i), -1)
                    if array.get(aptCutBar, i) != bk or array.get(aptCutSide, i) != sideNow
                        array.set(aptCutBar, i, bk)
                        array.set(aptCutSide, i, sideNow)
                        array.set(aptCutT, i, timenow)
                        array.set(aptCutPx, i, curV)
                cntOut := sideNow * cnt
                float cutPx = na
                float cutT = na
                if cnt == 1
                    if array.get(aptCutBar, i) != -1 and array.get(aptCutSide, i) == sideNow
                        cutPx := array.get(aptCutPx, i)
                        cutT := array.get(aptCutT, i)
                else if found and side1 == sideNow
                    cutPx := array.get(pe, run)
                    cutT := run == 1 ? float(nz(array.get(aptBk, i), 0)) * array.get(aptNb, i) * 60000 + aptAnchorMs : f_hbGet(aptHbT, i, run - 1)
                if not na(cutPx) and not na(cutT) and cutPx > 0.0 and not na(bid) and bid > 0.0
                    float secs = math.max(1.0, (timenow - cutT) / 1000.0)
                    plsOut := (sideNow > 0 ? "+" : "-") + f_fixed(math.abs(bid - cutPx) / secs, aptDigits + 1)
    [cntOut, plsOut]

// --- AptFvgPushStr: Bid DANG nam trong vung FVG con hieu luc -> "<pct>G" (tang) / "-<pct>G" (giam), ngoai vung -> "" ---
f_fvgPush(int i, float bid) =>
    string out = ""
    int closed = array.get(aptHbCnt, i)
    int maxi = math.min(120, closed - 3)
    if maxi >= 3 and not na(bid) and bid > 0.0
        float atr = 0.0
        int atrCnt = 0
        for a = 1 to math.min(14, closed)
            float ha = f_hbGet(aptHbH, i, a)
            float la = f_hbGet(aptHbL, i, a)
            if not na(ha) and not na(la) and ha > 0.0 and la > 0.0
                atr += ha - la
                atrCnt += 1
        if atrCnt > 0
            atr := atr / atrCnt
        int zones = 0
        for k2 = 1 to maxi
            if zones >= 20 or out != ""
                break
            float hA = f_hbGet(aptHbH, i, k2 + 2)
            float lA = f_hbGet(aptHbL, i, k2 + 2)
            float hC = f_hbGet(aptHbH, i, k2)
            float lC = f_hbGet(aptHbL, i, k2)
            if na(hA) or na(lA) or na(hC) or na(lC)
                continue
            float gLo = na
            float gHi = na
            int d = 0
            if hA < lC
                gLo := hA
                gHi := lC
                d := 1
            else if lA > hC
                gLo := hC
                gHi := lA
                d := -1
            else
                continue
            if gHi - gLo < math.max(atr * 0.10, syminfo.mintick)
                continue
            bool broken = false
            if k2 >= 2
                for kk = k2 - 1 to 1
                    float ck = f_hbGet(aptHbC, i, kk)
                    if not na(ck) and ck > 0.0
                        if d > 0 ? ck < gLo : ck > gHi
                            broken := true
                            break
            if broken
                continue
            zones += 1
            if bid >= gLo and bid <= gHi and gHi - gLo > 0.0
                int pct = int(math.round((bid - gLo) / (gHi - gLo) * 100.0))
                out := (d > 0 ? "" : "-") + str.tostring(pct) + "G"
    out

// --- AptImbalanceForTF (day du): "<+-pct>% <thoi gian>" (da bo ngoac); thoi gian = tu luc Bid ra ngoai Value Area (do nguoc nen 1m dong) ---
f_imbMq(float vah, float val, bool ok, float bid) =>
    string res = ""
    if ok and not na(bid) and bid > 0.0
        float width = vah - val
        int dir = bid > vah ? 1 : bid < val ? -1 : 0
        if width > 0.0 and dir != 0
            float pct = dir > 0 ? (bid - vah) / width * 100.0 : (val - bid) / width * 100.0
            float startMs = timenow
            int lim = math.min(1440, bar_index)
            if lim >= 1
                for sh = 1 to lim
                    float c = close[sh]
                    if na(c)
                        break
                    bool outSide = dir > 0 ? c > vah : c < val
                    if not outSide
                        break
                    startMs := time[sh]
            int sec = math.max(0, int((timenow - startMs) / 1000))
            int dd = int(sec / 86400)
            int hh = int((sec % 86400) / 3600)
            int mm = int((sec % 3600) / 60)
            int ss = sec % 60
            string sSS = (ss < 10 ? "0" : "") + str.tostring(ss)
            string sMM = (mm < 10 ? "0" : "") + str.tostring(mm)
            string sHH = (hh < 10 ? "0" : "") + str.tostring(hh)
            string sDur = dd > 0 ? str.tostring(dd) + "." + sHH + "." + sMM + "." + sSS + "s" : hh > 0 ? str.tostring(hh) + "." + sMM + "." + sSS + "s" : str.tostring(mm) + "." + sSS + "s"
            res := (dir > 0 ? "+" : "-") + str.tostring(int(math.round(pct))) + "% " + sDur
    res

// --- AptNormCdf + AptCmfVpinCore (cua so nB nen 1m cua chart): CMF, VPIN, huong ---
f_normCdf(float x) =>
    float z = math.abs(x) / math.sqrt(2.0)
    float t = 1.0 / (1.0 + 0.3275911 * z)
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * math.exp(-z * z)
    x >= 0.0 ? 0.5 * (1.0 + y) : 0.5 * (1.0 - y)

f_cmfVpin(int nB) =>
    float cmf = na
    float vpin = na
    int dir = 0
    float num = 0.0
    float den = 0.0
    for s = 0 to nB - 1
        float v = nz(volume[s])
        if v > 0.0
            float rg = high[s] - low[s]
            float clv = rg > 0.0 ? ((close[s] - low[s]) - (high[s] - close[s])) / rg : 0.0
            num += clv * v
            den += v
    if den > 0.0
        cmf := num / den
        float sum = 0.0
        float sum2 = 0.0
        for s = 0 to nB - 1
            float dP = close[s] - close[s + 1]
            sum += dP
            sum2 += dP * dP
        float mean = sum / nB
        float variance = sum2 / nB - mean * mean
        if variance > 0.0
            float sig = math.sqrt(variance)
            int nBk = math.min(50, nB)
            float vb = den / nBk
            float eps = vb * 1e-9
            float bBuy = 0.0
            float bSell = 0.0
            float bFill = 0.0
            float sumAbs = 0.0
            float totDelta = 0.0
            for s = nB - 1 to 0
                float v = nz(volume[s])
                if v > 0.0
                    float fb = f_normCdf((close[s] - close[s + 1]) / sig)
                    float rem = v
                    int guard = 0
                    while rem > 0.0 and guard < 200
                        guard += 1
                        float room = vb - bFill
                        float take = math.min(rem, room)
                        if take > 0.0
                            bBuy += take * fb
                            bSell += take * (1.0 - fb)
                            bFill += take
                            rem -= take
                        if vb - bFill <= eps
                            sumAbs += math.abs(bBuy - bSell)
                            totDelta += bBuy - bSell
                            bBuy := 0.0
                            bSell := 0.0
                            bFill := 0.0
            if bFill > 0.0
                sumAbs += math.abs(bBuy - bSell)
                totDelta += bBuy - bSell
            vpin := sumAbs / den
            dir := totDelta > 0.0 ? 1 : totDelta < 0.0 ? -1 : 0
    [cmf, vpin, dir]

// --- AptRv2SlopeDir: do doc RV2 cua khung k (RV2 song vs RV2 nen TF truoc): +1 len / -1 xuong / 0 bang; na = thieu du lieu ---
f_rv2Dir(int k) =>
    float a = array.get(aptRv2Live, k)
    float b = matrix.get(aptRv2S, k, 0)
    int d = na
    if not na(a) and not na(b)
        float df = a - b
        float eps = syminfo.mintick * 0.5
        d := df > eps ? 1 : df < -eps ? -1 : 0
    d

// --- AptRv2TrendRowText: hang tong hop RV2 cho cum nhan duoi than nen lon ---
f_rv2TrendRow(int bigIdx) =>
    string out = ""
    int bigDir = f_rv2Dir(bigIdx)
    if not na(bigDir)
        int nUp = 0
        int nDn = 0
        int nFl = 0
        for k = 0 to APT_TFN - 1
            if array.get(aptNb, k) >= array.get(aptNb, bigIdx)
                continue
            int dk = f_rv2Dir(k)
            if na(dk)
                continue
            if dk > 0
                nUp += 1
            else if dk < 0
                nDn += 1
            else
                nFl += 1
        int nSm = nUp + nDn + nFl
        string bigTxt = bigDir > 0 ? "TANG" : bigDir < 0 ? "GIAM" : "DI NGANG"
        string smTxt = "lan lon"
        int smBias = 0
        if nSm == 0
            smTxt := "chua co khung nho"
        else if nUp == nSm
            smTxt := "CUNG DOC LEN"
            smBias := 1
        else if nDn == nSm
            smTxt := "CUNG DOC XUONG"
            smBias := -1
        else if nUp > nDn
            smTxt := "nghieng tang"
            smBias := 1
        else if nDn > nUp
            smTxt := "nghieng giam"
            smBias := -1
        string concl = ""
        if bigDir == 0
            concl := "CHUA CO CHIEU"
        else if smBias == 0
            concl := bigDir > 0 ? "TANG (dieu chinh chua ro)" : "GIAM (dieu chinh chua ro)"
        else if bigDir > 0
            concl := smBias < 0 ? "DIEU CHINH GIAM" : "TANG TIEP"
        else
            concl := smBias > 0 ? "DIEU CHINH TANG" : "GIAM TIEP"
        out := "RV2 " + array.get(aptTfName, bigIdx) + " : " + bigTxt + " | nho " + str.tostring(nUp) + "len/" + str.tostring(nDn) + "xuong: " + smTxt + " -> " + concl
    out

// --- Bo dem giay cong don (varip): Pine chi dem duoc tu luc script chay live (khong co lich su tick) ---
varip float aptAccLast = na
varip int aptAccM5Key = -1
varip int aptAccBarKey = -1
varip float aptAccBrkUp = 0.0
varip float aptAccBrkDn = 0.0
varip float aptAccCmfUp = 0.0
varip float aptAccCmfDn = 0.0
varip float aptAccUpD = 0.0
varip float aptAccDnD = 0.0

// --- OW<khung> <so nen>: so nen TF lien tiep RV1 o CUNG phia LWMA(Open) (AptRv1LwmaCrossCnt kind=0); duong = RV1 tren OW ---
f_rv1OwCnt(int i, int n, float live) =>
    int cntOut = na
    int cl = array.get(aptHbCnt, i)
    if n >= 2 and not na(live) and live > 0.0 and cl >= n + 1 and f_tfEnabled(i)
        float lw1 = na
        int side1 = 0
        int run = 0
        bool bad = false
        int kMax = math.min(APT_SAMP_N, cl - n + 1)
        for k = 1 to kMax
            float rvk = f_rvComboVal(live, aptRvS, i, k)
            if na(rvk) or rvk <= 0.0
                if k == 1
                    bad := true
                break
            float sv = 0.0
            float sw = 0.0
            for j = 0 to n - 1
                float o = f_hbGet(aptHbO, i, k + j)
                if na(o)
                    bad := true
                    break
                float w = n - j
                sv += w * o
                sw += w
            if bad
                break
            float lw = sv / sw
            int side = rvk > lw ? 1 : rvk < lw ? -1 : 0
            if k == 1
                lw1 := lw
                side1 := side
                run := 1
            else
                if side != side1
                    break
                run += 1
        if not bad and not na(lw1)
            int sideNow = live > lw1 ? 1 : live < lw1 ? -1 : 0
            if sideNow == 0
                cntOut := 0
            else
                cntOut := sideNow * (sideNow == side1 ? 1 + run : 1)
    cntOut

