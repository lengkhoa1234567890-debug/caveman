    if on and not na(x1) and not na(x2) and not na(y1) and not na(y2)
        if na(ln)
            ln := line.new(x1, y1, x2, y2, xloc=xloc.bar_time, color=c, width=2)
            array.set(arr, idx, ln)
        else
            line.set_xy1(ln, x1, y1)
            line.set_xy2(ln, x2, y2)
            line.set_color(ln, c)
    else if not na(ln)
        line.set_color(ln, color.new(color.black, 100))
    int _d = 0
    _d

