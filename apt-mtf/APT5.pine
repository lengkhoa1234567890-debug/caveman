//══════════════════════════════════════════════════════════════════
// [BO SUNG MQL5SYNC-01 - THEO YEU CAU] HAM PORT TU AutoPositionTool_UI.mq5
//   f_cdlScan    = AptCdlScanTF      (mau nen dao chieu cua nen TF da dong)
//   f_imbVA      = AptImbCalcValueArea + AptImbValueAreaFromRates (VAH/VAL)
//   f_imbStr     = AptImbalanceForTF (chuoi "<±pct>%")
//   f_vimbFind   = AptVImbFindTF     (vung Volume Imbalance chua lap)
//   f_vimbDistStr= AptVImbCenterDistStr ("<±d>/<±ty le>")
//   f_pairTier   = AptPairTrendEvidence (CHI phan tierSum, BO phan giay)
// Tat ca CHI DOC du lieu, KHONG ve gi, KHONG doi bien/setting nao da co.
//══════════════════════════════════════════════════════════════════
const int   APT_IMB_VA_BARS  = 20
const int   APT_IMB_BINS     = 50
const float APT_IMB_VA_PCT   = 70.0
const int   APT_IMB_M1_MAX   = 4400
const int   APT_VIMB_LB      = 120
const int   APT_VIMB_ATRN    = 14
const float APT_VIMB_MINATR  = 0.02

f_cdlAtr(int i, int period) =>
    int n = math.max(2, period)
    float sum = 0.0
    int cnt = 0
    for k = 1 to n
        float h = f_hbGet(aptHbH, i, k)
        float l = f_hbGet(aptHbL, i, k)
        float pc = f_hbGet(aptHbC, i, k + 1)
        if not na(h) and not na(l) and h > 0.0 and l > 0.0
            float tr = h - l
            if not na(pc) and pc > 0.0
                tr := math.max(tr, math.max(math.abs(h - pc), math.abs(l - pc)))
            sum += tr
            cnt += 1
    cnt <= 0 ? syminfo.mintick : sum / cnt

f_cdlTrend(int i, int fromShift, int bars, float atr, bool down) =>
    bool res = false
    if atr > 0.0 and bars >= 1
        float cFar = f_hbGet(aptHbC, i, fromShift + bars)
        float cNear = f_hbGet(aptHbC, i, fromShift)
        if not na(cFar) and not na(cNear) and cFar > 0.0 and cNear > 0.0
            res := down ? cFar - cNear >= atr * i_cdlTrendAtrMult : cNear - cFar >= atr * i_cdlTrendAtrMult
    res

f_cdlScan(int i, bool on) =>
    string bName = ""
    string bArrow = ""
    float bConf = 0.0
    if on and i_cdlEnable and array.get(aptHbCnt, i) >= 2
        float atr = f_cdlAtr(i, i_cdlAtrLen)
        float o0 = f_hbGet(aptHbO, i, 1)
        float h0 = f_hbGet(aptHbH, i, 1)
        float l0 = f_hbGet(aptHbL, i, 1)
        float c0 = f_hbGet(aptHbC, i, 1)
        float tol = syminfo.mintick
        if atr > 0.0 and not na(o0) and not na(h0) and not na(l0) and not na(c0) and h0 > 0.0 and l0 > 0.0 and h0 >= l0
            float body0 = math.abs(c0 - o0)
            float range0 = h0 - l0
            float upW0 = h0 - math.max(o0, c0)
            float loW0 = math.min(o0, c0) - l0
            if range0 > 0.0 and body0 > 0.0
                bool isHammer = loW0 >= body0 * 2.0 and upW0 <= body0 * i_cdlWickTolPct + tol
                bool isShoot = upW0 >= body0 * 2.0 and loW0 <= body0 * i_cdlWickTolPct + tol
                if isHammer and f_cdlTrend(i, 1, i_cdlTrendBars, atr, true) and 65.0 + 0.0001 >= bConf
                    bName := "Hammer"
                    bArrow := i_cdlUpArrow
                    bConf := 65.0
                if isShoot and f_cdlTrend(i, 1, i_cdlTrendBars, atr, false) and 65.0 + 0.0001 >= bConf
                    bName := "Shooting"
                    bArrow := i_cdlDnArrow
                    bConf := 65.0
            float o1 = f_hbGet(aptHbO, i, 2)
            float h1 = f_hbGet(aptHbH, i, 2)
            float l1 = f_hbGet(aptHbL, i, 2)
            float c1 = f_hbGet(aptHbC, i, 2)
            if not na(o1) and not na(h1) and not na(l1) and not na(c1) and h1 > 0.0 and l1 > 0.0 and h1 >= l1
                bool prevBear = c1 < o1
                bool prevBull = c1 > o1
                float body1 = math.abs(c1 - o1)
                if prevBear and c0 > o0 and o0 <= c1 and c0 >= o1 and body0 >= body1 and f_cdlTrend(i, 2, i_cdlTrendBars, atr, true) and 75.0 + 0.0001 >= bConf
                    bName := "Bullish"
                    bArrow := i_cdlUpArrow
                    bConf := 75.0
                if prevBull and c0 < o0 and o0 >= c1 and c0 <= o1 and body0 >= body1 and f_cdlTrend(i, 2, i_cdlTrendBars, atr, false) and 75.0 + 0.0001 >= bConf
                    bName := "Bearish"
                    bArrow := i_cdlDnArrow
                    bConf := 75.0
                if prevBear and c0 > o0 and o0 < c1 and c0 > (o1 + c1) * 0.5 and c0 < o1 and f_cdlTrend(i, 2, i_cdlTrendBars, atr, true) and 70.0 + 0.0001 >= bConf
                    bName := "Piercing"
                    bArrow := i_cdlUpArrow
                    bConf := 70.0
                if prevBull and c0 < o0 and o0 > c1 and c0 < (o1 + c1) * 0.5 and c0 > o1 and f_cdlTrend(i, 2, i_cdlTrendBars, atr, false) and 70.0 + 0.0001 >= bConf
                    bName := "Dark"
                    bArrow := i_cdlDnArrow
                    bConf := 70.0
                float o2 = f_hbGet(aptHbO, i, 3)
                float h2 = f_hbGet(aptHbH, i, 3)
                float l2 = f_hbGet(aptHbL, i, 3)
                float c2 = f_hbGet(aptHbC, i, 3)
                if not na(o2) and not na(h2) and not na(l2) and not na(c2) and h2 > 0.0 and l2 > 0.0 and h2 >= l2
                    float body2 = math.abs(c2 - o2)
                    if c2 < o2 and body2 > 0.0 and body1 <= body2 * i_cdlSmallBodyPct + tol and c0 > o0 and c0 > (o2 + c2) * 0.5 and f_cdlTrend(i, 3, i_cdlTrendBars, atr, true) and 82.0 + 0.0001 >= bConf
                        bName := "Morning"
                        bArrow := i_cdlUpArrow
                        bConf := 82.0
                    if c2 > o2 and body2 > 0.0 and body1 <= body2 * i_cdlSmallBodyPct + tol and c0 < o0 and c0 < (o2 + c2) * 0.5 and f_cdlTrend(i, 3, i_cdlTrendBars, atr, false) and 82.0 + 0.0001 >= bConf
                        bName := "Evening"
                        bArrow := i_cdlDnArrow
                        bConf := 82.0
                    float upW1 = h1 - math.max(o1, c1)
                    if c2 > o2 and c1 > o1 and c0 > o0 and c1 > c2 and c0 > c1 and o1 >= o2 and o1 <= c2 and o0 >= o1 and o0 <= c1 and upW0 <= body0 * i_cdlWickTolPct + tol and upW1 <= body1 * i_cdlWickTolPct + tol and f_cdlTrend(i, 3, i_cdlTrendBars, atr, true) and 78.0 + 0.0001 >= bConf
                        bName := "Three"
                        bArrow := i_cdlUpArrow
                        bConf := 78.0
                    float loW1 = math.min(o1, c1) - l1
                    if c2 < o2 and c1 < o1 and c0 < o0 and c1 < c2 and c0 < c1 and o1 <= o2 and o1 >= c2 and o0 <= o1 and o0 >= c1 and loW0 <= body0 * i_cdlWickTolPct + tol and loW1 <= body1 * i_cdlWickTolPct + tol and f_cdlTrend(i, 3, i_cdlTrendBars, atr, false) and 78.0 + 0.0001 >= bConf
                        bName := "Three"
                        bArrow := i_cdlDnArrow
                        bConf := 78.0
    [bName, bArrow]

f_imbVAFrom(array<float> hs, array<float> ls, array<float> vs) =>
    float vah = na
    float val = na
    int cnt = array.size(hs)
    if cnt >= 3
        float hi = array.max(hs)
        float lo = array.min(ls)
        if hi > lo
            float bs = (hi - lo) / APT_IMB_BINS
            array<float> vol = array.new_float(APT_IMB_BINS, 0.0)
            float tot = 0.0
            for k = 0 to cnt - 1
                float h = array.get(hs, k)
                float l = array.get(ls, k)
                float v = array.get(vs, k)
                if na(v) or v <= 0.0
                    v := 1.0
                int b0 = int(math.floor((l - lo) / bs))
                int b1 = int(math.floor((h - lo) / bs))
                b0 := math.max(0, math.min(APT_IMB_BINS - 1, b0))
                b1 := math.min(APT_IMB_BINS - 1, b1)
                if b1 < b0
                    b1 := b0
                float share = v / (b1 - b0 + 1)
                for b = b0 to b1
                    array.set(vol, b, array.get(vol, b) + share)
                tot += v
            if tot > 0.0
                int poc = 0
                for b = 1 to APT_IMB_BINS - 1
                    if array.get(vol, b) > array.get(vol, poc)
                        poc := b
                int up = poc
                int dn = poc
                float acc = array.get(vol, poc)
                float tgt = tot * APT_IMB_VA_PCT / 100.0
                while acc < tgt and (up < APT_IMB_BINS - 1 or dn > 0)
                    float vUp = up < APT_IMB_BINS - 1 ? array.get(vol, up + 1) : -1.0
                    float vDn = dn > 0 ? array.get(vol, dn - 1) : -1.0
                    if vUp >= vDn
                        up += 1
                        acc += array.get(vol, up)
                    else
                        dn -= 1
                        acc += array.get(vol, dn)
                vah := lo + (up + 1) * bs
                val := lo + dn * bs
    [vah, val, not na(vah) and not na(val) and vah > val]

f_imbVA(int i, bool on) =>
    array<float> hs = array.new_float(0)
    array<float> ls = array.new_float(0)
    array<float> vs = array.new_float(0)
    int nB = array.get(aptNb, i)
    int n = math.min(APT_IMB_VA_BARS, array.get(aptHbCnt, i))
    if on and n >= 3
        float tStart = f_hbGet(aptHbT, i, n)
        int bkNow = array.get(aptBk, i)
        float tEnd = na(bkNow) ? na : float(bkNow) * nB * 60000 + aptAnchorMs
        if nB * (APT_IMB_VA_BARS + 1) <= APT_IMB_M1_MAX and not na(tStart) and not na(tEnd)
            int kMax = math.min(nB * (n + 1), APT_IMB_M1_MAX)
            float tOld = na
            for k = 0 to kMax
                float tk = time[k]
                if na(tk) or tk < tStart
                    break
                if tk < tEnd and not na(high[k]) and not na(low[k])
                    array.push(hs, high[k])
                    array.push(ls, low[k])
                    array.push(vs, nz(volume[k]))
                    tOld := tk
            if array.size(hs) < 3 or na(tOld) or tOld >= tStart + nB * 60000
                array.clear(hs)
                array.clear(ls)
                array.clear(vs)
        if array.size(hs) < 3
            for s = 1 to n
                float hS = f_hbGet(aptHbH, i, s)
                float lS = f_hbGet(aptHbL, i, s)
                if not na(hS) and not na(lS)
                    array.push(hs, hS)
                    array.push(ls, lS)
                    array.push(vs, nz(f_hbGet(aptHbV, i, s)))
    f_imbVAFrom(hs, ls, vs)

f_imbStr(float vah, float val, bool ok, float bid) =>
    string res = ""
    if ok and not na(bid) and bid > 0.0
        float width = vah - val
        int dir = bid > vah ? 1 : bid < val ? -1 : 0
        if width > 0.0 and dir != 0
            float pct = dir > 0 ? (bid - vah) / width * 100.0 : (val - bid) / width * 100.0
            res := (dir > 0 ? "+" : "-") + str.tostring(math.round(pct)) + "%"
    res

f_vimbFind(int i) =>
    float zLo = na
    float zHi = na
    bool found = false
    int cnt = array.get(aptHbCnt, i)
    int maxi = math.min(APT_VIMB_LB, cnt - 1)
    if maxi >= 1
        float atr = 0.0
        int atrCnt = 0
        for a = 1 to math.min(APT_VIMB_ATRN, cnt)
            float ha = f_hbGet(aptHbH, i, a)
            float la = f_hbGet(aptHbL, i, a)
            if not na(ha) and not na(la)
                atr += ha - la
                atrCnt += 1
        if atrCnt > 0
            atr := atr / atrCnt
        float minH = math.max(atr * APT_VIMB_MINATR, syminfo.mintick)
        float hCur = nz(array.get(aptCurHLive, i), high)
        float lCur = nz(array.get(aptCurLLive, i), low)
        for s = 1 to maxi
            float oA = f_hbGet(aptHbO, i, s + 1)
            float cA = f_hbGet(aptHbC, i, s + 1)
            float hA = f_hbGet(aptHbH, i, s + 1)
            float lA = f_hbGet(aptHbL, i, s + 1)
            float oB = f_hbGet(aptHbO, i, s)
            float cB = f_hbGet(aptHbC, i, s)
            float hB = f_hbGet(aptHbH, i, s)
            float lB = f_hbGet(aptHbL, i, s)
            if not na(oA) and not na(cA) and not na(hA) and not na(lA) and not na(oB) and not na(cB) and not na(hB) and not na(lB)
                float bLoA = math.min(oA, cA)
                float bHiA = math.max(oA, cA)
                float bLoB = math.min(oB, cB)
                float bHiB = math.max(oB, cB)
                float gLo = na
                float gHi = na
                if bLoB > bHiA and lB <= hA
                    gLo := bHiA
                    gHi := bLoB
                else if bHiB < bLoA and hB >= lA
                    gLo := bHiB
                    gHi := bLoA
                if not na(gLo) and not na(gHi) and gHi - gLo >= minH
                    bool filled = lCur < gHi and hCur > gLo
                    if not filled and s > 1
                        for k = s - 1 to 1
                            float hk = f_hbGet(aptHbH, i, k)
                            float lk = f_hbGet(aptHbL, i, k)
                            if not na(hk) and not na(lk) and lk < gHi and hk > gLo
                                filled := true
                                break
                    if not filled
                        zLo := gLo
                        zHi := gHi
                        found := true
                        break
    [zLo, zHi, found]

f_vimbDistStr(int i, float vah, float val, bool vaOk, bool on) =>
    string res = "-"
    if on and vaOk
        [zLo, zHi, zOk] = f_vimbFind(i)
        float halfW = (vah - val) * 0.5
        if zOk and halfW > 0.0
            float d = (zLo + zHi) * 0.5 - (vah + val) * 0.5
            float r = d / halfW
            res := (d >= 0.0 ? "+" : "") + str.tostring(d, "0.0") + "/" + (r >= 0.0 ? "+" : "") + str.tostring(r, "0.0")
    res

f_pairTier(int i, float bid) =>
    int tier = 0
    float bd = f_brkD(i, i_brkDBars, bid)
    float rv1 = array.get(aptRvLive, i)
    if not na(bd) and not na(rv1) and rv1 > 0.0 and aptSpreadPx > 0.0
        int bdI = int(math.round(bd))
        int spR = int(math.round((bid - rv1) / aptSpreadPx))
        if spR >= 2
            tier += bdI > 110 ? 5 : bdI > 100 ? 4 : bdI > 90 ? 3 : bdI > 80 ? 2 : bdI > 70 ? 1 : 0
        else if spR <= -2
            tier -= bdI < -20 ? 5 : bdI < -10 ? 4 : bdI < 10 ? 3 : bdI < 20 ? 2 : bdI < 30 ? 1 : 0
    int bestP = -1
    float bestPD = 0.0
    for k = 0 to APT_LVN - 1
        float ev = array.get(aptEmaLv, i * APT_LVN + k)
        if not na(ev)
            float dd = math.abs(bid - ev)
            if bestP < 0 or dd < bestPD
                bestP := k
                bestPD := dd
    if bestP >= 0
        float rsiP = array.get(aptRsiCur, i * APT_LVN + bestP)
        if not na(rsiP)
            float rsiR = math.round(rsiP)
            if rsiR > 50.0
                tier += rsiR > 90.0 ? 5 : rsiR > 80.0 ? 4 : rsiR > 70.0 ? 3 : rsiR > 60.0 ? 2 : 1
            else if rsiR < 50.0
                tier -= rsiR < 10.0 ? 5 : rsiR < 20.0 ? 4 : rsiR < 30.0 ? 3 : rsiR < 40.0 ? 2 : 1
        if bestP >= 1 and bestP <= 9
            tier += bestP
        else if bestP >= 10 and bestP <= 18
            tier -= bestP - 9
    tier

float aptAtr = ta.atr(14)
int aptPivIdxRaw = array.indexof(aptLvName, i_pivLvl)
int aptPivIdx = aptPivIdxRaw < 0 ? 10 : aptPivIdxRaw

//══════════════════════════════════════════════════════════════════
// [BO SUNG DSS-PINE-01 - THEO YEU CAU] Port tinh toan Call / Flip / Put cua NGAY
// va 3 hang "Ca ngay / Swing / Cau truc" tu AutoPositionTool_UI.mq5 (DssCompute,
// DssZigZag, DssPathLen, DssShapeOf, DssVolumeLevels, DssWallFromPivots,
// DssCountTouches, DssTfRange). Cach tinh GIU NGUYEN ban MQL5 (cac hang so DSS_*
// ben MQL5 duoc dat thanh hang so o day, KHONG them input moi, KHONG ve duong):
//   - ZigZag theo bien do (ATR x K, K = 0.5 / 1 / 2 / 4 / 8) tren nen 1m tu dau NGAY.
//   - ATR = SMA(TR, 96) nen 15m DA DONG truoc 00:00 (dau ngay theo i_anchorMin),
//     ATR D1 = SMA(TR, 14) nen ngay da dong. Chot MOT lan luc sang ngay moi.
//   - Flip~ = POC; Call~/Put~ = cum dinh/day bi tu choi nhieu lan nhat tren/duoi
//     Flip~, khong co cum >= 2 lan cham -> VAH/VAL. Muc tuong duong tu volume
//     cua nen 1m, KHONG phai gamma that.
// KHAC BIET so voi MQL5 (do gioi han cua Pine, da chon cach gan nhat):
//   (a) Trang thai (ZigZag, volume profile) chi ghi o NEN DA DONG (barstate.
//       isconfirmed, giong cac khoi trang thai khac cua file) nen ket qua tinh
//       den nen 1m vua dong; gia hien tai/H/L cua nen dang chay van duoc dung
//       cho cac cau chu ("gia tren Call"...) nhung chua vao ZigZag/volume.
//   (b) Luoi gia cua volume profile co dinh (goc = Low nen dau ngay, rong = 0.1 x
//       ATR M15) thay vi goc = Low cua ca ngay nhu MQL5 -> POC lech toi da < 1 bin.
//   (c) Volume dung `volume` cua TradingView (xap xi tick volume); thieu volume
//       thi moi nen tinh la 1, giong MQL5.
//   (d) ATR D1 lay theo nen "D" cua san TradingView, co the lech moc ngay so voi MT5.
//══════════════════════════════════════════════════════════════════
const int   DSS_MIN_LEG_MS     = 600000
const int   DSS_STRUCT_MIN_LEGS = 3
const float DSS_ER_TREND       = 0.50
const float DSS_ER_RANGE       = 0.30
const float DSS_NARROW_DAY     = 0.60
const float DSS_EXPAND_RATIO   = 1.20
const float DSS_CONTRACT_RATIO = 0.80
const float DSS_EQUAL_TOL      = 0.25
const int   DSS_EXP_PREV_LEGS  = 3
const float DSS_COVERAGE       = 0.60
const int   DSS_LEG_BARS_MIN   = 3
const int   DSS_LEG_BARS_MAX   = 12
const float DSS_VP_BIN_ATR     = 0.10
const float DSS_VALUE_AREA     = 0.70
const int   DSS_LV_WIN         = 60
const int   DSS_LV_STABLE      = 15
const int   DSS_LV_CROSS       = 3
const float DSS_LV_VOLHI       = 1.20
const int   DSS_LV_VOLWIN      = 30
const int   DSS_VP_HALF        = 2000

type DssZz
    array<float> pP
    array<int> pT
    array<int> pTy
    int dir = 0
    float candP
    int candT
    float maxP
    float minP
    int maxT
    int minT

// ATR nen 15m / D1 DA DONG ngay truoc nen hien tai (khong repaint)
float dssAtrM15 = request.security(syminfo.tickerid, "15", ta.sma(ta.tr(true), 96)[1], lookahead = barmerge.lookahead_on)
float dssAtrD1 = request.security(syminfo.tickerid, "D", ta.sma(ta.tr(true), 14)[1], lookahead = barmerge.lookahead_on)

var array<float> dssScales = array.from(0.5, 1.0, 2.0, 4.0, 8.0)
var array<int> dssTfMin = array.from(1, 5, 15, 30, 60, 240, 1440)
var array<string> dssTfNm = array.from("M1", "M5", "M15", "M30", "H1", "H4", "D1")
var array<DssZz> dssZzs = array.new<DssZz>()
var array<float> dssVp = array.new_float(2 * DSS_VP_HALF + 1, 0.0)
var int dssBinLo = 2 * DSS_VP_HALF + 1
var int dssBinHi = -1
var float dssTot = 0.0
var float dssBin = na
var float dssOrigin = na
var int dssDayKey = na
var int dssDayStart = na
var float dssAtr = na
var float dssAtrDv = na
var float dssDayOpen = na
var float dssHi = na
var float dssLo = na
var int dssCnt = 0
var float dssRngSum = 0.0
var bool dssPartial = false

// Mot buoc cua DssZigZag() cho MOT nen (cu -> moi); trang thai nam trong z.
f_dssZzStep(DssZz z, float T, int minMs, float h, float l, int t) =>
    int n = z.pP.size()
    if z.dir == 0
        if na(z.maxP)
            z.maxP := h
            z.minP := l
            z.maxT := t
            z.minT := t
        else
            if h > z.maxP
                z.maxP := h
                z.maxT := t
            if l < z.minP
                z.minP := l
                z.minT := t
        if z.maxP - z.minP >= T
            if z.maxT < z.minT
                z.pP.push(z.maxP)
                z.pT.push(z.maxT)
                z.pTy.push(1)
                z.dir := -1
                z.candP := z.minP
                z.candT := z.minT
            else if z.minT < z.maxT
                z.pP.push(z.minP)
                z.pT.push(z.minT)
                z.pTy.push(-1)
                z.dir := 1
                z.candP := z.maxP
                z.candT := z.maxT
    else if z.dir == 1
        if h > z.candP
            z.candP := h
            z.candT := t
        else if z.candP - l >= T
            if z.candT - z.pT.get(n - 1) >= minMs
                z.pP.push(z.candP)
                z.pT.push(z.candT)
                z.pTy.push(1)
                z.dir := -1
                z.candP := l
                z.candT := t
            else if l < z.pP.get(n - 1)
                z.pP.set(n - 1, l)
                z.pT.set(n - 1, t)
                z.candP := h
                z.candT := t
    else
        if l < z.candP
            z.candP := l
            z.candT := t
        else if h - z.candP >= T
            if z.candT - z.pT.get(n - 1) >= minMs
                z.pP.push(z.candP)
                z.pT.push(z.candT)
                z.pTy.push(-1)
                z.dir := 1
                z.candP := h
                z.candT := t
            else if h > z.pP.get(n - 1)
                z.pP.set(n - 1, h)
                z.pT.set(n - 1, t)
                z.candP := l
                z.candT := t
    z.dir

// DssPathLen()
f_dssPathLen(DssZz z, float dayOpen, float closeV) =>
    int n = z.pP.size()
    float s = 0.0
    if n == 0
        s := math.abs(closeV - dayOpen)
    else
        s := math.abs(z.pP.get(0) - dayOpen)
        if n > 1
            for j = 1 to n - 1
                s += math.abs(z.pP.get(j) - z.pP.get(j - 1))
        if z.dir != 0
            s += math.abs(z.candP - z.pP.get(n - 1)) + math.abs(closeV - z.candP)
        else
            s += math.abs(closeV - z.pP.get(n - 1))
    s

// DssShapeOf(): doc day dinh / day day qua toi da 3 dinh + 3 day trong [idx0, idx1)
f_dssShape(DssZz z, int idx0, int idx1, float tol) =>
    array<float> tops = array.new_float()
    array<float> bots = array.new_float()
    int i = idx1 - 1
    while i >= idx0 and (tops.size() < 3 or bots.size() < 3)
        int ty = z.pTy.get(i)
        if ty == 1 and tops.size() < 3
            tops.push(z.pP.get(i))
        if ty == -1 and bots.size() < 3
            bots.push(z.pP.get(i))
        i -= 1
    bool ok = tops.size() >= 2 and bots.size() >= 2
    int sT = 0
    int sB = 0
    float tHi = na
    float bMin = na
    if ok
        float dTop = tops.get(0) - tops.get(tops.size() - 1)
        float dBot = bots.get(0) - bots.get(bots.size() - 1)
        sT := dTop > tol ? 1 : (dTop < -tol ? -1 : 0)
        sB := dBot > tol ? 1 : (dBot < -tol ? -1 : 0)
        tHi := tops.max()
        bMin := bots.min()
    [ok, sT, sB, tHi, bMin]

// chi so pivot dau tien co thoi gian >= tMs (n neu khong co)
f_dssFirstIdx(DssZz z, int tMs) =>
    int n = z.pT.size()
    int i = 0
    while i < n and z.pT.get(i) < tMs
        i += 1
    i

// DssWallFromPivots(): cum dinh (ty=1) / day (ty=-1) cham nhieu lan nhat, tren/duoi ref
f_dssWall(DssZz z, int ty, float tol, float refP, bool above) =>
    int touch = 0
    float lvl = 0.0
    int n = z.pP.size()
    if n > 0
        for i = 0 to n - 1
            if z.pTy.get(i) == ty
                float pv = z.pP.get(i)
                bool skip = above ? pv <= refP : pv >= refP
                if not skip
                    int c = 0
                    float s = 0.0
                    for j = 0 to n - 1
                        if z.pTy.get(j) == ty and math.abs(z.pP.get(j) - pv) <= tol
                            c += 1
                            s += z.pP.get(j)
                    if c >= touch
                        touch := c
                        lvl := s / c
    [touch >= 2, lvl]

// DssCountTouches()
f_dssTouches(DssZz z, int ty, float lvl, float tol) =>
    int c = 0
    int n = z.pP.size()
    if n > 0
        for i = 0 to n - 1
            if z.pTy.get(i) == ty and math.abs(z.pP.get(i) - lvl) <= tol
                c += 1
    c

// DssVolumeLevels(): POC + vung gia tri tu phan bo volume nen 1m cua ngay
f_dssVolLevels(float lo, float hi) =>
    bool ok = false
    float poc = na
    float vHi = na
    float vLo = na
    if dssBinHi >= dssBinLo and not na(dssBin) and not na(dssOrigin) and hi > lo and dssTot > 0.0
        int ip = dssBinLo
        float best = -1.0
        for i = dssBinLo to dssBinHi
            float sm = dssVp.get(i) + (i > 0 ? dssVp.get(i - 1) : 0.0) + (i < 2 * DSS_VP_HALF ? dssVp.get(i + 1) : 0.0)
            if sm > best
                best := sm
                ip := i
        poc := dssOrigin + (ip - DSS_VP_HALF + 0.5) * dssBin
        float need = dssTot * DSS_VALUE_AREA
        float acc = dssVp.get(ip)
        int a0 = ip
        int a1 = ip
        while acc < need and (a0 > dssBinLo or a1 < dssBinHi)
            float dnV = a0 > dssBinLo ? dssVp.get(a0 - 1) : -1.0
            float upV = a1 < dssBinHi ? dssVp.get(a1 + 1) : -1.0
            if upV >= dnV
                a1 += 1
                acc += dssVp.get(a1)
            else
                a0 -= 1
                acc += dssVp.get(a0)
        vHi := math.min(dssOrigin + (a1 - DSS_VP_HALF + 1.0) * dssBin, hi)
        vLo := math.max(dssOrigin + (a0 - DSS_VP_HALF) * dssBin, lo)
        ok := true
    [ok, poc, vHi, vLo]

// DssTfRange(): khoang khung ma 1 song dai "minutes" phut chiem 3..12 nen
f_dssTfRange(float minutes) =>
    string r = "--"
    if minutes > 0.0
        int lo = -1
        int hi = -1
        for i = 0 to 6
            float bars = minutes / dssTfMin.get(i)
            if bars >= DSS_LEG_BARS_MIN and bars <= DSS_LEG_BARS_MAX
                if lo < 0
                    lo := i
                hi := i
        if lo < 0
            float mid = math.sqrt(DSS_LEG_BARS_MIN * DSS_LEG_BARS_MAX)
            float bd = 1.0e18
            for i = 0 to 6
                float d = math.abs(math.log(minutes / dssTfMin.get(i) / mid))
                if d < bd
                    bd := d
                    lo := i
            hi := lo
        r := lo == hi ? dssTfNm.get(lo) : dssTfNm.get(lo) + "-" + dssTfNm.get(hi)
    r

// DssCompute(): tra [ok, 6 hang chu, Call, Flip, Put, so lan cham Call, so lan cham Put]
// hiNow/loNow = High/Low ca ngay (gom nen dang chay), closeNow = gia hien tai,
// cnt = so nen 1m cua ngay (gom nen dang chay), liveRng = (High-Low) nen dang chay chua vao dssRngSum.
f_dssCompute(float hiNow, float loNow, float closeNow, int cnt, float liveRng) =>
    bool ok = false
    string r0 = " "
    string r1 = " "
    string r2 = " "
    string r3 = " "
    string r4 = " "
    string r5 = " "
    float oCall = na
    float oFlip = na
    float oPut = na
    int oCT = 0
    int oPT = 0
    float atr = dssAtr
    float atrD = nz(dssAtrDv, 0.0)
    float dayOpen = dssDayOpen
    if not na(atr) and atr > 0.0 and cnt >= 2 and dssZzs.size() == 5 and hiNow > loNow and not na(dayOpen)
        float tol = DSS_EQUAL_TOL * atr

        //=== quet moi muc K
        array<int> sLegs = array.new_int()
        array<int> sPiv = array.new_int()
        array<int> sDir = array.new_int()
        array<float> sAvg = array.new_float()
        array<float> sCov = array.new_float()
        float basePath = 0.0
        for s = 0 to 4
            DssZz zq = dssZzs.get(s)
            int qn = zq.pP.size()
            float qPath = f_dssPathLen(zq, dayOpen, closeNow)
            if s == 0
                basePath := qPath
            sLegs.push(math.max(0, qn - 1))
            sPiv.push(qn)
            sDir.push(zq.dir)
            sAvg.push(qn >= 2 ? (zq.pT.get(qn - 1) - zq.pT.get(0)) / 60000.0 / (qn - 1) : 0.0)
            sCov.push(basePath > 0.0 ? qPath / basePath : 0.0)

        //--- tang CAU TRUC
        int stIdx = -1
        for s = 4 to 0
            if stIdx < 0 and sLegs.get(s) >= DSS_STRUCT_MIN_LEGS
                stIdx := s
        if stIdx < 0
            for s = 4 to 0
                if stIdx < 0 and sLegs.get(s) >= 1
                    stIdx := s

        if stIdx >= 0
            //--- tang DAO DONG
            int inIdx = -1
            if stIdx > 0
                for s = 0 to stIdx - 1
                    if sLegs.get(s) >= 2 and sCov.get(s) >= DSS_COVERAGE
                        inIdx := s
                if inIdx < 0
                    for s = 0 to stIdx - 1
                        if inIdx < 0 and sLegs.get(s) >= 2
                            inIdx := s
            if inIdx < 0
                inIdx := stIdx

            //--- tang PHA
            int phIdx = stIdx
            if stIdx < 4
                bool phFound = false
                for s = 4 to stIdx + 1
                    if not phFound and sPiv.get(s) >= 1 and sDir.get(s) != 0
                        phIdx := s
                        phFound := true

            DssZz zs = dssZzs.get(stIdx)
            DssZz zi = dssZzs.get(inIdx)
            DssZz zp = dssZzs.get(phIdx)
            int sn = zs.pP.size()
            int inN = zi.pP.size()
            int pn = zp.pP.size()
            int pD = zp.dir

            //=== hang 6: CA NGAY
            float sPath = f_dssPathLen(zs, dayOpen, closeNow)
            float er = sPath > 0.0 ? math.abs(closeNow - dayOpen) / sPath : 0.0
            float rng = hiNow - loNow
            float rngD = atrD > 0.0 ? rng / atrD : 0.0
            float cpos = rng > 0.0 ? (closeNow - loNow) / rng : 0.5
            float elapsedSec = (time - dssDayStart) / 1000.0
            if elapsedSec < 3600.0
                elapsedSec := 3600.0
            if elapsedSec > 86400.0
                elapsedSec := 86400.0
            float narrowThr = DSS_NARROW_DAY * math.sqrt(elapsedSec / 86400.0)
            string trendTxt = ""
            if atrD > 0.0 and rngD < narrowThr
                trendTxt := "DI NGANG - bien do hep"
            else if er >= DSS_ER_TREND
                trendTxt := closeNow > dayOpen ? "MOT CHIEU TANG" : "MOT CHIEU GIAM"
            else if er <= DSS_ER_RANGE
                trendTxt := cpos >= 0.7 ? "BIEN DONG 2 CHIEU - nghieng tang" : cpos <= 0.3 ? "BIEN DONG 2 CHIEU - nghieng giam" : "BIEN DONG 2 CHIEU - can bang"
            else
                trendTxt := closeNow > dayOpen ? "NGHIENG TANG (chua ro)" : "NGHIENG GIAM (chua ro)"

            //=== hang 7: SWING - bien do (tang dao dong)
            string expShort = "CHUA DU SONG"
            int nLegs = inN - 1
            if nLegs >= 2
                float recent = 0.0
                float prev = 0.0
                int nRec = nLegs >= 3 ? 2 : 1
                int nPrev = math.min(math.max(1, DSS_EXP_PREV_LEGS), nLegs - nRec)
                for j = 0 to nRec - 1
                    recent += math.abs(zi.pP.get(inN - 1 - j) - zi.pP.get(inN - 2 - j))
                for j = nRec to nRec + nPrev - 1
                    prev += math.abs(zi.pP.get(inN - 1 - j) - zi.pP.get(inN - 2 - j))
                recent := recent / nRec
                prev := prev / nPrev
                float lastLeg = math.abs(zi.pP.get(inN - 1) - zi.pP.get(inN - 2))
                if zi.dir != 0 and nRec == 2
                    float live0 = math.abs(zi.candP - zi.pP.get(inN - 1))
                    if live0 > lastLeg
                        recent := (live0 + lastLeg) / 2.0
                float ratio = prev > 0.0 ? recent / prev : 0.0
                string lab = ratio >= DSS_EXPAND_RATIO ? "MO RONG" : ratio <= DSS_CONTRACT_RATIO ? "THU HEP" : "ON DINH"
                expShort := lab + " " + str.tostring(ratio, "0.00") + "x"

            //=== hang 7: SWING - chieu (dinh/day cua PHA hien tai)
            int phStart = dssDayStart
            int phExtT = 0
            if pn >= 1 and pD != 0
                phStart := zp.pT.get(pn - 1)
                phExtT := nz(zp.candT, 0)
            bool okShape = false
            int shT = 0
            int shB = 0
            float tHi = na
            float bMin = na
            if phExtT > 0
                int w0a = f_dssFirstIdx(zi, phExtT)
                if inN - w0a >= 3
                    [oa, sTa, sBa, tHa, bMa] = f_dssShape(zi, w0a, inN, tol)
                    if oa
                        okShape := true
                        shT := sTa
                        shB := sBa
                        tHi := tHa
                        bMin := bMa
            if not okShape and pD != 0
                int w0b = f_dssFirstIdx(zi, phStart)
                [ob, sTb, sBb, tHb, bMb] = f_dssShape(zi, w0b, inN, tol)
                if ob
                    okShape := true
                    shT := sTb
                    shB := sBb
                    tHi := tHb
                    bMin := bMb
            if not okShape
                [oc, sTc, sBc, tHc, bMc] = f_dssShape(zs, 0, sn, tol)
                if oc
                    okShape := true
                    shT := sTc
                    shB := sBc
                    tHi := tHc
                    bMin := bMc
            string dirTxt = "CHUA RO"
            if okShape
                int shSum = shT + shB
                if shT == 1 and shB == -1
                    dirTxt := "LOA"
                else if shT == -1 and shB == 1
                    dirTxt := "NEN"
                else if shSum > 0
                    dirTxt := "TANG"
                else if shSum < 0
                    dirTxt := "GIAM"
                else
                    dirTxt := "NGANG"
                if closeNow > tHi + tol
                    dirTxt := (shSum >= 0 ? "TANG" : "DAO LEN") + ", dang pha dinh " + str.tostring(tHi, format.mintick)
                else if closeNow < bMin - tol
                    dirTxt := (shSum <= 0 ? "GIAM" : "DAO XUONG") + ", dang pha day " + str.tostring(bMin, format.mintick)

            //=== hang 9 + 3 muc ngay: Put~ / Flip~ / Call~
            [vOk, poc, vHiL, vLoL] = f_dssVolLevels(loNow, hiNow)
            if vOk
                float cw = vHiL
                float pw = vLoL
                [wcOk, wcLv] = f_dssWall(zi, 1, tol, poc, true)
                if wcOk
                    cw := wcLv
                [wpOk, wpLv] = f_dssWall(zi, -1, tol, poc, false)
                if wpOk
                    pw := wpLv
                oCall := cw
                oPut := pw
                oFlip := poc
                oCT := f_dssTouches(zi, 1, cw, tol)
                oPT := f_dssTouches(zi, -1, pw, tol)

                r0 := "Ca ngay  : " + trendTxt
                r1 := "Swing    : " + dirTxt + " | " + expShort
                r2 := "Cau truc : " + f_dssTfRange(sAvg.get(stIdx))

                //=== hang 9..11: hanh vi gia so voi Call~ / Flip~ / Put~ (khong in gia muc)
                int winN = math.min(cnt, DSS_LV_WIN)

                //--- Call~
                int upRun = 0
                int ui = 0
                while ui < cnt and close[ui] > cw
                    upRun += 1
                    ui += 1
                bool cPoke = false
                for i = 0 to winN - 1
                    if high[i] > cw + tol
                        cPoke := true
                string callTxt = ""
                if closeNow > cw + tol
                    callTxt := upRun >= DSS_LV_STABLE ? "gia on dinh tren Call - tiep tuc tang" : "gia vua vuot Call - cho xac nhan"
                else if closeNow >= cw - tol
                    callTxt := "gia sat Call - dang thu, de bi day lai"
                else if cPoke
                    callTxt := "vuot Call that bai - bi day xuong"
                else
                    callTxt := "gia duoi Call - Call la khang cu"

                //--- Put~
                int dnRun = 0
                int di = 0
                while di < cnt and close[di] < pw
                    dnRun += 1
                    di += 1
                bool pPoke = false
                for i = 0 to winN - 1
                    if low[i] < pw - tol
                        pPoke := true
                string putTxt = ""
                if closeNow < pw - tol
                    putTxt := dnRun >= DSS_LV_STABLE ? "gia on dinh duoi Put - tiep tuc giam, de roi sau" : "gia vua thung Put - cho xac nhan"
                else if closeNow <= pw + tol
                    putTxt := "gia sat Put - dang thu, de duoc do len"
                else if pPoke
                    putTxt := "thung Put that bai - bat len lai"
                else
                    putTxt := "gia tren Put - Put la ho tro"

                //--- Flip~: so lan cat qua Flip trong cua so + bien do M1 gan day so voi TB ngay
                int crosses = 0
                int prevSide = 0
                for i = winN - 1 to 0
                    int sd = close[i] > poc + tol ? 1 : (close[i] < poc - tol ? -1 : 0)
                    if sd != 0
                        if prevSide != 0 and sd != prevSide
                            crosses += 1
                        prevSide := sd
                float rngAll = dssRngSum + liveRng
                int nV = math.min(DSS_LV_VOLWIN, cnt)
                float rngRec = 0.0
                for i = 0 to nV - 1
                    rngRec += high[i] - low[i]
                float volRatio = rngAll > 0.0 and nV > 0 ? (rngRec / nV) / (rngAll / cnt) : 1.0
                string flipTxt = ""
                if math.abs(closeNow - poc) <= tol or crosses >= DSS_LV_CROSS
                    flipTxt := "quanh Flip - dao dong hep, hay quay ve"
                else if closeNow > poc
                    flipTxt := volRatio >= DSS_LV_VOLHI ? "tren Flip - gia chay manh len" : "tren Flip - dao dong hep, giu gia"
                else
                    flipTxt := volRatio >= DSS_LV_VOLHI ? "duoi Flip - gia chay manh, de roi sau" : "duoi Flip - giam cham, co the hoi ve Flip"

                r3 := "Call     : " + callTxt
                r4 := "Flip     : " + flipTxt
                r5 := "Put      : " + putTxt
                ok := true
    [ok, r0, r1, r2, r3, r4, r5, oCall, oFlip, oPut, oCT, oPT]

// Cap nhat trang thai NGAY: CHI o nen da dong (barstate.isconfirmed), giong cac khoi trang thai khac
if aptTfOk and barstate.isconfirmed
    if dssZzs.size() == 0
        for s = 0 to 4
            dssZzs.push(DssZz.new(pP = array.new_float(), pT = array.new_int(), pTy = array.new_int(), dir = 0))
    int dssDkNow = int(math.floor((time - aptAnchorMs) / 86400000.0))
    if na(dssDayKey) or dssDkNow != dssDayKey
        dssDayKey := dssDkNow
        dssDayStart := dssDkNow * 86400000 + aptAnchorMs
        // Ngay dau tien trong lich su chart ma chart bat dau giua ngay -> du lieu thieu, khong tinh
        dssPartial := bar_index == 0 and (time - dssDayStart) > 14400000
        dssAtr := dssAtrM15
        dssAtrDv := dssAtrD1
        dssBin := na(dssAtr) ? na : DSS_VP_BIN_ATR * dssAtr
        for s = 0 to 4
            DssZz zr = dssZzs.get(s)
            zr.pP.clear()
            zr.pT.clear()
            zr.pTy.clear()
            zr.dir := 0
            zr.candP := na
            zr.candT := na
            zr.maxP := na
            zr.minP := na
            zr.maxT := na
            zr.minT := na
        if dssBinHi >= dssBinLo
            for b = dssBinLo to dssBinHi
                dssVp.set(b, 0.0)
        dssBinLo := 2 * DSS_VP_HALF + 1
        dssBinHi := -1
        dssTot := 0.0
        dssOrigin := low
        dssDayOpen := open
        dssHi := high
        dssLo := low
        dssCnt := 0
        dssRngSum := 0.0
    dssHi := math.max(dssHi, high)
    dssLo := math.min(dssLo, low)
    if not dssPartial and not na(dssAtr) and dssAtr > 0.0 and not na(dssBin) and dssBin > 0.0
        for s = 0 to 4
            f_dssZzStep(dssZzs.get(s), dssScales.get(s) * dssAtr, DSS_MIN_LEG_MS, high, low, time)
        int dssB0 = math.max(0, math.min(2 * DSS_VP_HALF, int(math.floor((low - dssOrigin) / dssBin)) + DSS_VP_HALF))
        int dssB1 = math.max(0, math.min(2 * DSS_VP_HALF, int(math.floor((high - dssOrigin) / dssBin)) + DSS_VP_HALF))
        float dssV = volume > 0.0 ? volume : 1.0
        float dssPer = dssV / (dssB1 - dssB0 + 1)
        for b = dssB0 to dssB1
            dssVp.set(b, dssVp.get(b) + dssPer)
        dssBinLo := math.min(dssBinLo, dssB0)
        dssBinHi := math.max(dssBinHi, dssB1)
        dssTot += dssV
    dssCnt += 1
    dssRngSum += high - low

//══════════════════════════════════════════════════════════════════
// VE — toan bo phan dung chuoi chi chay o nen cuoi
//══════════════════════════════════════════════════════════════════
if barstate.islast
    if not aptTfOk
        if na(aptLbWarn)
            aptLbWarn := label.new(time, close, "APT-MTF: chi chay dung tren chart 1m", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white)
        else
            label.set_xy(aptLbWarn, time, close)
    else
        //──────────────────────────────────────────────────────────
        // Nhip thoi gian cho bo dem cong don (giay)
        //──────────────────────────────────────────────────────────

        float bid = close
        float step = na(aptAtr) or aptAtr <= 0.0 ? syminfo.mintick * 50 : aptAtr * i_crlStep
        array.fill(aptPivYAdj, na)
        // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Dat lai mang settled
        // cua cot RV1/RV2 CUNG nhip voi aptPivYAdj o tren, moi lan ve deu bat
        // dau lai tu dau (khong giu tri chong cheo cua nhip truoc).
        array.fill(aptRv1YAdj, na)
        array.fill(aptRv2YAdj, na)
        // [SUA PVORDERFIX-01 / SUA RVORDERFIX-01 - THEO YEU CAU] Dat lai mang
        // gia THAT goc (raw) CUNG nhip voi ba mang settled o tren, moi lan ve
        // deu bat dau lai tu dau.
        array.fill(aptPivYRaw, na)
        array.fill(aptRv1YRaw, na)
        array.fill(aptRv2YRaw, na)
        float stepSafe = na(step) or step <= 0.0 ? syminfo.mintick * 50 : step
        int xPiv = time + i_gapPiv * 60000
        int xRv1 = time + i_gapRv1 * 60000
        int xRv2 = time + i_gapRv2 * 60000
        int xCrl = time + i_gapCrl * 60000
        // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Moc thoi gian RIENG
        // cho cot nhan RV1 cua khung 1m (nhan "hang 1" txtRv1 tai i == 0 VA
        // toan bo cum 6 hang ngay duoi no) - CACH nen 1m hien tai DUNG 12 nen
        // 1m ve TUONG LAI (KHONG con dung chung xPiv/i_gapPiv cua cot Pivot
        // nua). 12 la SO CO DINH theo yeu cau, KHONG them input moi.
        int xRv1m1 = time + i_gapRv1m1 * 60000
        // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Moc goc (gia RV1
        // that cua khung 1m = hang 1 cua cum RV1-1m) cho COT NHAN WPR1 MOI o
        // (5) — duoc GAN trong vong lap chinh o nhanh "i == 0" cua muc (2), va
        // DOC LAI o nhanh ve COT NHAN WPR1 MOI cho CA 6 khung (i == 0 gan
        // TRUOC, i == 1..5 dung lai gia tri do vi vong lap chay TANG DAN tu 0).
        string patBarBias = "BOTH"
        int patBarMode = 0
        int patBarT1 = na
        int patBarT2 = na
        int patBarT3 = na
        int patBarT4 = na
        float patBarP1 = na
        float patBarP2 = na
        float patBarP3 = na
        float patBarP4 = na
        // [CAP NHAT THEO YEU CAU - PATAUTO-01] Co danh dau da CHOT duoc khung
        // ve 2 canh (chi dung khi i_patAutoTF BAT). Vi vong lap ve chay TANG
        // DAN i = 0..APT_TFN-1 nen khung du dieu kien SOM NHAT cung la khung
        // THAP NHAT — khoa lai ngay, cac khung cao hon khong ghi de nua.
        bool patBarLocked = false

        //──────────────────────────────────────────────────────────
        // TSF + LAM (AptTickPressureCalc) — cua so nB=5 tren chart 1m
        //──────────────────────────────────────────────────────────
        [tpTsf, tpLam] = f_tickPressure(APT_TP_NB)

        // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] brkScore tinh MOT LAN
        // cho ca vong lap (no gom 5 khung 1m..1h nen KHONG phu thuoc bien dem i),
        // dat TRUOC vong lap de nhan RV1 cua khung 1m (i == 0, duoc dung SOM nhat
        // trong vong) da co san gia tri. Dung bid - CUNG muc gia ma brk%/brkD cua
        // tung khung dang dung.
        float brkScoreV = f_brkScore(i_brkDBars, bid)
        string sBrkScore = na(brkScoreV) ? "" : str.tostring(brkScoreV, "0.00")
        // [BO SUNG BARLBL-CUR-01 - THEO YEU CAU] Chuoi hang 1/hang 2 cua cum
        // nhan duoi day than nen lon, ghi trong vong lap tai i == aptBarIdx.
        string bcRow1V1V2 = "-"
        string bcRow1S1 = "-"
        string bcRow2 = "-"
        // [BO SUNG MQL5SYNC-01] hang 3 cua cum duoi day than nen lon (= CUR2 MQL5, bo bo dem)
        string bcRow3 = "-"
        for i = 0 to APT_TFN - 1
            string tfn = array.get(aptTfName, i)
            float rvL = array.get(aptRvLive, i)
            float rv2 = array.get(aptRv2Live, i)
            float pH = array.get(aptPrvH, i)
            float pL = array.get(aptPrvL, i)
            float tfO = array.get(aptCurOLive, i)

            //──────────────────────────────────────────────────────
            // brk% — y het WrvBuildBrkStr(): (Close - prevLow)/(prevHigh - prevLow)*100
            //──────────────────────────────────────────────────────
            float rng = na(pH) or na(pL) ? na : pH - pL
            float brkVal = na(rng) or rng <= 0.0 ? na : (bid - pL) / rng * 100.0
            bool brkUp = na(tfO) ? false : bid >= tfO
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] brkD + streak cua
            // khung nay tai nen dang chay. brkVal (brk% neo tren MOT nen truoc)
            // GIU NGUYEN dong tinh o tren - no van la nguon cho codeClr/rowClr va
            // cho <sigbrk> cua cot Pivot, dung y het ben MQL5 (noi BrkTextForTF()
            // giu nguyen 1 nen, chi cot WPR1COL doi sang brkD).
            float brkDVal = f_brkD(i, i_brkDBars, bid)
            int brkDStrk = na(brkDVal) ? 0 : f_brkStreak(i, brkDVal)
            int codeClr = f_brkCode(brkVal, brkUp)
            color rowClr = f_codeToColor(codeClr, brkUp)

            //──────────────────────────────────────────────────────
            // Q1 va RV1slope — y het AptRv1DiffAndQ1() + AptRvQCalc()
            //──────────────────────────────────────────────────────

            float diffRv1 = na(rvL) ? na : bid - rvL
            float diffRv2 = na(rv2) ? na : bid - rv2

            //──────────────────────────────────────────────────────
            // Muc Pivot GAN BID NHAT — y het AptS1RsiTextForTF()
            //──────────────────────────────────────────────────────
            int best = -1
            float bestD = 0.0
            for k = 0 to APT_LVN - 1
                float ev = array.get(aptEmaLv, i * APT_LVN + k)
                if not na(ev)
                    float dd2 = math.abs(bid - ev)
                    if best < 0 or dd2 < bestD
                        best := k
                        bestD := dd2
                // [BO SUNG - THEO YEU CAU] Xem truoc RSI(5)/streak cua muc
                //   "TenMuc" (best) THEO TICK, dung f_previewPivRsi() moi
                //   (dinh nghia trong khoi TRANG THAI o tren) - KHONG doi
                //   cach tinh rNowConfirmed/aptRsiCur/aptRsiStreak da co, chi
                //   THEM nhanh doc preview truoc, lui ve rNowConfirmed khi
                //   preview chua san sang (warm-up hoac khung dang tat).
                // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Doi
                // <dRsiNear> sang SO NEN RSI da tang/giam LIEN TUC
                // (aptRsiStreak, cap nhat dan o khoi trang thai o tren) -
                // khop CalcRsiTrendBars() ma AptS1RsiTextForTF()/AptS1RsiDiffTextForTF()
                // ben MQL5 dang dung cho <RSI>/<±dRSI> cua <TenMuc>.

            //──────────────────────────────────────────────────────
            // BO DEM CONG DON — y het khoi accum trong CheckAlerts()
            //   khung <= 30m reset theo chinh khung, khung > 30m reset theo M30
            //──────────────────────────────────────────────────────

            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Tinh SOM bo ba
            // WPR1/WPR2 (tripleRv1c/tripleRv2c) TAI DAY — truoc ca ba cot (1)
            // Pivot/(2) RV1/(3) RV2 — vi tripleRv1c/tripleRv2c duoc cot RV1 o
            // (2) doc toi (dinh dang MOI cua nhan RV1, xem ghi chu canh dong
            // ghep txtRv1 o (2) phia duoi) va tripleRv1c con duoc cot WPR1 MOI
            // o (5) doc toi, khong con la rieng cua CRL o (4) nhu truoc day.
            // Cong thuc/tham so tinh (f_wprTripleStr,
            // i_wprPeriod/i_maPeriod/i_maMethod) GIU NGUYEN 100% — CHI doi VI
            // TRI tinh trong vong lap tu SAU (4) CRL ra TRUOC (1) Pivot.
            // [CAP NHAT THEO YEU CAU] Bo qua tinh bo ba WPR1/WPR2 khi khung bi
            // tat (chi 3h/4h/6h moi co cong tac, xem f_tfEnabled) - day la
            // khoi ton tai thu hai (sau vong 19 muc Woodie o khoi trang thai)
            // trong PHAN VE, giam tai dung y yeu cau. Gia tri mac dinh "" khi
            // tat, GIONG HET quy uoc "thieu du lieu -> chuoi rong" cua chinh
            // f_wprTripleStr(). Cong thuc tinh KHONG doi mot dong nao khi
            // khung dang BAT.
            bool tfOnI = f_tfEnabled(i)

            //──────────────────────────────────────────────────────
            // (1) COT NHAN PIVOT — muc Pivot DUOC CHON
            //   Uu tien khung nho truoc, khung lon bi day tuyen tinh len neu trung vi tri
            //   [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Dinh dang MOI
            //   (cap <UpB>/<DnB> da CAT sang cum CRL; <Q1>/<RV1slope> doi thanh
            //   <diffrv1>/<RV1slope>, THEM <diffrv2>/<RV2slope>, <diffpv>/<brk%>
            //   va <TenMuc> o cuoi):
            //   "<TF> <RSI> / <±dRSI>(<UpA>/<DnA> | <Up>/<Dn>)<diffrv1>/<RV1slope>  <diffrv2>/<RV2slope>  <diffpv>/<brk%><TenMuc>"
            //   [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] VI TRI (pivY,
            //   qua gp/pivYBase) VA <TenMuc> gio DUNG CHUNG mot muc voi cum CRL o
            //   (4): khi i_pivFollowNear bat (mac dinh, khop mac dinh
            //   g_pivotFollowDisplayedLvl=true ben MQL5), moi khung tu chon chi
            //   so "best" (muc GAN BID NHAT cua CHINH no, da tinh o khoi
            //   "Muc Pivot GAN BID NHAT" phia tren - CUNG chi so ma <TenMuc> cua
            //   CRL/sNearLvl dang dung) thay vi luon dung CHUNG aptPivIdx co
            //   dinh; tat i_pivFollowNear, hoac best < 0 (khung do chua tinh
            //   duoc muc nao) -> fallback ve aptPivIdx (dinh dang CU, dung y het
            //   quy tac fallback "g_pivotLevelIdx" ben MQL5 khi
            //   AptWoodieDisplayLvlForTF() that bai). pivYBase/pivRsi/pivRsiP/
            //   diffPv o duoi deu doc qua "gp" nay nen TU DONG khop theo muc vua
            //   chon, KHONG can sua them noi nao khac.
            int pivLvlUsed = i_pivFollowNear and best >= 0 ? best : aptPivIdx
            int gp = i * APT_LVN + pivLvlUsed
            // [SUA MQL5SYNC-02] Nhan Pivot dat tai gia ema[0] LIVE cua muc (DrawEmaSeries: OBJ_TEXT tai ema[0]; g_pivotLvlValCache = gia nhan), khong phai EMA da chot.
            [pivLiveE0, pivLiveE1] = f_pvEmaLive(i, pivLvlUsed)
            float pivYBase = na(pivLiveE0) ? array.get(aptEmaLv, gp) : pivLiveE0
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Doi sang DUNG
            // f_priorityPushY() (khop [SUA PVM1-01]/[SUA PVM1-03] ben MQL5):
            // khung dung TRUOC (i nho hon, uu tien cao hon) LUON giu DUNG vi
            // tri gia that; khung sau neu cham nhan da chot cua khung truoc
            // thi bi DAY XUONG (khong con day LEN nhu ban cu) vua du thoat
            // cham, lap lai toi da APT_TFN lan. aptPivYAdj[] tiep tuc dong
            // vai tro mang settled, ghi lai NGAY SAU khi goi ham, y het truoc.
            float pivY = f_priorityPushY(pivYBase, aptPivYAdj, aptPivYRaw, i, stepSafe)
            array.set(aptPivYAdj, i, pivY)
            array.set(aptPivYRaw, i, pivYBase)
            float pivRsiConfirmed = array.get(aptRsiCur, gp)
            // [BO SUNG - THEO YEU CAU] Xem truoc RSI(5)/streak cua muc Pivot
            //   DANG DUNG (gp/pivLvlUsed) THEO TICK, dung CHUNG ham
            //   f_previewPivRsi() voi cum "TenMuc" o tren - KHONG doi cach
            //   tinh pivRsiConfirmed/aptRsiCur/aptRsiStreak da co, chi THEM
            //   nhanh doc preview truoc, lui ve pivRsiConfirmed khi preview
            //   chua san sang (warm-up hoac khung dang tat).
            [pivRsiPreview, pivDltPreview] = f_previewPivRsi(i, pivLvlUsed)
            float pivRsi = na(pivRsiPreview) ? pivRsiConfirmed : pivRsiPreview
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Doi <pivDlt>
            // (chinh la <+/-diffRSI> cua nhan Pivot) sang SO NEN RSI da
            // tang/giam LIEN TUC (aptRsiStreak) - khop CalcRsiTrendBars() ma
            // DrawEmaSeries() ben MQL5 dang dung, thay cho hieu so RSI 1 nen
            // truoc day.
            float pivDlt = na(pivRsi) ? na : (na(pivRsiPreview) ? float(array.get(aptRsiStreak, gp)) : float(pivDltPreview))
            // [BO SUNG RSIEXTREME-01 - THEO YEU CAU] <±dRSI> cua nhan Pivot
            //   (dung trong sPivBaseCdl o duoi, KHONG dung trong sPivBase o
            //   tren - bien do da bi [SUA PIVLBL-CDLS1MOVE-01] cho "nghi",
            //   xem chu thich "Bien sPivBase GIU NGUYEN dong tinh" canh
            //   sPivBaseCdl) doi sang uu tien dem SO NEN tu khi RSI (CHINH
            //   muc dang chon gp) dat MAX, roi MIN, trong i_rsiExtLookback
            //   nen gan nhat - port [SUA RSIEXTREME-01] ben
            //   AutoPositionTool_UI.mq5. _rsiExtShift = 0 khi pivRsi la gia
            //   tri DA CHOT (aptRsiCur, da nam san trong aptRsiHist cot 0), = 1
            //   khi pivRsi la gia tri XEM TRUOC theo tick (pivRsiPreview,
            //   dung Y HET dieu kien pivDlt o tren dang tach live-preview vs
            //   confirmed) - dam bao bars-ago cua Max/Min khop DUNG voi nen
            //   ma <RSI> dang hien thi. KHONG hop le (ca hai deu vuot
            //   i_rsiExtCountLimit, hoac pivRsi dang na) -> GIU NGUYEN dinh
            //   dang cu <±dRSI> (pivDlt). KHONG doi pivRsi/pivDlt/aptRsiCur/
            //   aptRsiStreak, CHI THEM bien PHAN HIEN THI moi (sPivDlt).
            string sRv2Df = na(diffRv2) ? "-" : str.tostring(diffRv2, "0.0")
            string sDiff1 = na(diffRv1) ? "-" : str.tostring(diffRv1, "0.0")
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] sBrk doi tu
            // "<brk%>" sang "<brkD>(<streak>)" - khop [SUA BRKW1-01] ben MQL5
            // (_w1BrkStr). Chi con MOT noi doc sBrk la cot WPR1COL nen doi o day
            // la du. brkD chua co (khung chua du N nen TF dong) -> lui ve DUNG
            // chuoi cu, khong thua mot ky tu nao.
            // [SUA MQL5SYNC-02] <streak> = AptBrkStreakCount (so nen DA DONG lien tiep brkD > 90 / < 10 + nen hien tai), thay cho dem cung phia cu.
            string sBrk = na(brkDVal) ? (na(brkVal) ? "-" : str.tostring(brkVal, "0")) : str.tostring(brkDVal, "0") + "(" + str.tostring(f_brkStreakM(i, i_brkDBars, int(math.round(brkDVal)))) + ")"
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Hai gia tri MOI
            // cho dinh dang Pivot MOI: rv2Slope = RV2[0]-RV2[1] (dung lich su
            // aptRv2S da co san, CUNG cach RV1slope/"slope" o tren dang dung
            // aptRvS), diffPv = RV1[0] - <gia tri muc Pivot dang chon> (pivYBase
            // vua tinh o tren). Ca hai dung CHUNG dinh dang 1 chu so thap phan
            // "0.0" nhu diffrv1/RV1slope/rv2diff (M1_ELP_LBL_DIF1_DIGITS/
            // M1_ELP_LBL_DIF23_DIGITS ben MQL5 deu = 1).
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] <diffV1V2> - xem
            // f_diffV1V2Str() (khop [SUA DIFFV1V2-01] ben MQL5): SO NEN LIEN TUC
            // RV1 va RV2 giu nguyen cung trang thai so sanh, KHONG con la hieu
            // so gia nhu ban truoc.
            string sDiffV1V2 = f_diffV1V2Str(rvL, aptRvS, rv2, aptRv2S, i)
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Khop [SUA S1EMA5-01]
            // ben MQL5: <cdlS1> tu nay dung EMA(5) cua chuoi S1 Woodie CUA CHINH
            // khung dang duyet (_rqS1Ema ben MQL5) thay cho S1 tho shift 1 -
            // CHINH gia tri EMA(5) ma duong "S1 (1m)" o cuoi file dang plot
            // (array.get(aptEmaLv, i * APT_LVN + 10), muc S1 = chi so 10 trong
            // aptLvName/g_lvlName), TRU gia dong NGAY HOM TRUOC (aptPrevDayClose)
            // - dinh dang hien thi (str.tostring 1 chu so thap phan) va quy uoc
            // thieu du lieu -> "-" GIU NGUYEN 100%. Bien s1EmaCur nay con duoc
            // DUNG LAI cho <S1onS1>/<S1onRV2> ngay ben duoi (khop _rqS1Ema ben
            // MQL5), KHONG tinh EMA(5) hai lan.
            float s1EmaCur = array.get(aptEmaLv, i * APT_LVN + 10)
            float cdlS1 = na(s1EmaCur) or s1EmaCur <= 0.0 or na(aptPrevDayClose) or aptPrevDayClose <= 0.0 ? na : s1EmaCur - aptPrevDayClose
            string sCdlS1 = na(cdlS1) ? "-" : str.tostring(cdlS1, "0.0")
            // [BO SUNG - THEO YEU CAU] <S1onS1>/<S1onRV2> - khop [SUA S1ONTF-RAW-02]/
            // [SUA S1EMA5-01]/[SUA S1ONTF-SYM-04] ben MQL5: hai KY HIEU tam giac
            // so sanh EMA(5) cua S1 khung nay (s1EmaCur vua tinh o tren) voi
            // EMA(5) cua S1 (S1onS1) va voi RV2 (S1onRV2) cua khung LON HON lien
            // ke (i+1 trong aptTfName/aptEmaLv/aptRv2 - CUNG thu tu khung ma ca
            // file dang dung, dung Y HET quy uoc "khung sau = khung lon hon lien
            // ke" cua cac cap UpA/DnA, UpB/DnB...). S1onS1: s1EmaCur >
            // EMA(5) S1 khung i+1 -> "▲", nguoc lai -> "▼". S1onRV2: s1EmaCur >
            // RV2 khung i+1 (array.get(aptRv2, i+1), CHINH gia tri RV2 "song"
            // ma ca hang dang dung cho rv2/sRv2Df/sRv2Slope o tren) -> "▲",
            // nguoc lai -> "▼". Khung cuoi cung (i+1 >= APT_TFN, khong co khung
            // lon hon) hoac thieu du lieu (EMA(5) <= 0, hoac RV2 <= 0) -> "-",
            // KHONG doan gia tri. Hai ky hieu DOC LAP nhau: thieu RV2 thi S1onS1
            // van hien binh thuong. KHONG ve them duong line nao, KHONG doi
            // input/setting nao.
                    // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Khop
                    // [SUA S1ONTF-NUM-05] ben MQL5: <S1onS1> doi tu KY HIEU
                    // tam giac sang GIA TRI SO = EMA(5) S1 khung nay -
                    // EMA(5) S1 khung lon hon lien ke, in 1 chu so thap phan
                    // (khop DoubleToString(..., M1_ELP_LBL_DIF1_DIGITS = 1)).
                    // Dung DUNG hai bien s1EmaCur/s1EmaNx da tinh o tren,
                    // KHONG doi cach tinh cua ban than chung, KHONG doc them
                    // du lieu nao. Thieu du lieu van giu mac dinh "-".
                    // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Khop
                    // [SUA S1ONTF-NUM-06] ben MQL5: <S1onRV2> doi tu KY HIEU
                    // tam giac sang GIA TRI SO = EMA(5) S1 khung nay - RV2
                    // cua khung lon hon lien ke, in 1 chu so thap phan. Gia
                    // tri rv2Nx (array.get(aptRv2, i + 1)) GIU NGUYEN, KHONG
                    // tinh lai RV2. Thieu du lieu van giu mac dinh "-".
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Dinh dang MOI
            // (khop cac ban [SUA PIVLBL-FMT-02]..[SUA PIVLBL-FMT-06]/[SUA
            // PIVLBL-FMT-05] ben MQL5): BO HAN <brk%> (sBrk) va cum <TenMuc>
            // <RSI>/<±dRSI> (sNearLvl/sNearRsi/sNearDlt) khoi chuoi hien thi -
            // ca bon bien nay CHUYEN sang nhan RV1 (xem txtRv1 o duoi), VAN duoc
            // tinh nguyen o tren cho muc dich do, chi khong con noi vao txtPiv.
            // THEM <diffV1V2> (sDiffV1V2) dan LIEN NGAY sau dau ")" (khong dau
            // cach), roi MOT dau cach, roi <diffpv> (sDiffPv, KHONG con ghep
            // chung voi <brk%> qua dau "/" nua - da tach rieng), roi MOT dau
            // cach, roi <cdlS1> (sCdlS1) o cuoi cung. Nhan Pivot tu nay KET THUC
            // ngay sau <cdlS1>.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Khop [SUA S1EMA5-01]/
            // [SUA S1ONTF-RAW-02]/[SUA S1ONTF-SYM-04]/[SUA PIVLBL-DELPLUS-01] ben
            // MQL5: CHEN hai ky hieu tam giac <S1onS1> (sS1onS1) va <S1onRV2>
            // (sS1onRv2) dan LIEN nhau, dan LIEN NGAY sau <diffV1V2> (khong dau
            // cach - dung Y HET _rv1PivAppend = " " + _rv1DiffV1V2Str +
            // _rv1S1onS1Str + _rv1S1onRv2Str + " " + _rv1CdlS1Str ben MQL5), dau
            // cach truoc <cdlS1> GIU NGUYEN. <cdlS1> (sCdlS1) nay dung EMA(5) cua
            // S1 thay vi S1 tho (xem khoi tinh s1EmaCur/sCdlS1 o tren). Dinh dang
            // MOI cua nhan Pivot:
            //   "<TF> <RSI5> / <+/-diffRSI> <diffV1V2><S1onS1><S1onRV2> <cdlS1>"
            // Gia tri/cach tinh cua sPivBase/sDiffV1V2 KHONG doi mot chu so nao.
            // KHONG tao/xoa object nao, KHONG ve them duong line nao, KHONG doi
            // bat ky input/setting nao.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] THEM <DiffRv2>
            // va <sigbrk> vao nhan Pivot, dung LAI DUNG cong thuc/nguong da co
            // san cua cot WPR1COL (sDiffRv2/sSigBrk, khai bao o khoi (5) ben
            // duoi) - khai bao RIENG hai bien sDiffRv2Piv/sSigBrkPiv (cung
            // cong thuc, KHONG dinh nghia lai gi khac) vi sDiffRv2/sSigBrk
            // cua WPR1COL nam SAU diem nay trong vong lap nen chua co gia tri
            // luc txtPiv duoc go. <DiffRv2> dan LIEN giua <S1onS1> va
            // <S1onRV2>: so sanh RV2 cua CHINH khung nay (rv2) voi RV2 cua
            // khung cao hon lien ke (array.get(aptRv2, i + 1)) - rv2 > RV2
            // khung tren -> "▲", nguoc lai -> "▼"; thieu du lieu hoac la khung
            // cao nhat (i + 1 >= APT_TFN) -> "" (khong doan gia tri). <sigbrk>
            // dan LIEN ngay TRUOC <cdlS1>: dung LAI DUNG brkVal da tinh SAN o
            // dau vong lap (brk%, KHONG tinh lai cong thuc nao khac) - brkVal
            // >= 110 -> "▲"; <= -10 -> "▼"; con lai (ke ca brkVal la na) ->
            // MOT dau cach " ". Dinh dang MOI cua nhan Pivot:
            //   "<TF> <RSI5> / <+/-diffRSI> <diffV1V2><S1onS1><DiffRv2><S1onRV2><sigbrk><cdlS1>"
            //   [SUA PIVLBL-ORDER-01 - THEO YEU CAU] Thu tu tren DA DOI thanh:
            //   "<TF> <RSI5> / <+/-diffRSI> <diffV1V2><DiffRv2><S1onS1><S1onRV2><sigbrk><cdlS1>"
            // KHONG tao/xoa object nao, KHONG ve them duong line nao, KHONG
            // doi bat ky input/setting nao.
            // [CAP NHAT THEO YEU CAU - DONG BO MQL5] Ban numeric MOI cua
            // <DiffRv2> danh RIENG cho nhan Pivot - khop khoi "[SUA
            // PIVLBL-DIFFPVRV-01]" ben AutoPositionTool_UI.mq5 (cat <DiffRv2>
            // tu nhan RV2 chuyen VE nhan Pivot, CHEN NGAY SAU <diffV1V2>).
            // DUNG LAI DUNG rv2/rv2NextPiv da tinh san NGAY TREN (KHONG doc
            // them du lieu, KHONG goi array.get() them lan nao) - CHI khac
            // sDiffRv2Piv o cho la GIA TRI SO (str.tostring(rv2 - rv2NextPiv,
            // "0.0")) thay vi ky hieu tam giac, dung Y HET cong thuc
            // sDiffRv2R2Lbl (3) COT NHAN RV2 dang dung. KHONG tao/xoa label
            // nao, KHONG ve them duong line nao, KHONG doi input/setting nao.
            // [SUA PIVLBL-ORDER-01 - THEO YEU CAU] DOI THU TU hai ky hieu
            // <DiffRv2> (sDiffRv2Piv) va <S1onS1> (sS1onS1): <DiffRv2> gio
            // dung NGAY SAU <diffV1V2>, roi moi den <S1onS1>, roi <S1onRV2>.
            // Dinh dang MOI cua nhan Pivot:
            //   "<TF> <RSI5> / <+/-diffRSI> <diffV1V2><DiffRv2><S1onS1><S1onRV2><sigbrk><cdlS1>"
            // CHI doi THU TU noi chuoi - cong thuc/cach tinh cua sPivBase,
            // sDiffV1V2, sS1onS1, sDiffRv2Piv, sS1onRv2, sSigBrkPiv, sCdlS1
            // KHONG doi mot chu so nao. KHONG tao/xoa object nao, KHONG ve
            // them duong line nao, KHONG doi bat ky input/setting nao.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Dong bo voi
            // ban AutoPositionTool_UI.mq5 moi nhat, GOM BA thay doi:
            //   1) [SUA PIVLBL-DELDIFFRV2-01] CAT <DiffRv2> (sDiffRv2Piv) RA
            //      KHOI nhan Pivot - truong nay CHUYEN VE nhan RV2 o (3)
            //      duoi dang GIA TRI SO. Hai dong tinh rv2NextPiv/
            //      sDiffRv2Piv o tren GIU NGUYEN (KHONG xoa), CHI khong con
            //      noi vao chuoi nhan nua - dung tinh than "khong bo sot code
            //      goc" ma ban MQL5 dang lam voi _rv1DiffRv2Sym.
            //   2) [SUA S1ONTF-NUM-05/06] <S1onS1>/<S1onRV2> nay la SO (co
            //      the am, co phan thap phan) chu khong con la ky hieu tam
            //      giac rong 1 ky tu, nen chen MOT dau cach TRUOC tung truong
            //      de day so khong dinh nhau thanh chuoi khong doc duoc.
            //   3) [SUA PIVLBL-CDLS1MOVE-01] <cdlS1> (sCdlS1) chuyen tu CUOI
            //      chuoi len NGAY SAU <TF>, ngan cach voi cum <RSI5> /
            //      <±dRSI> bang " |". Ben MQL5 phan goc nhan la mot chuoi da
            //      cache nen phai tach bang StringFind/StringSubstr; ben Pine
            //      cac thanh phan (tfn, pivRsi, pivDlt) van con nguyen bien
            //      nen go THANG chuoi moi sPivBaseCdl - cong thuc/dieu kien
            //      na(pivRsi) COPY Y HET dong sPivBase o tren, KHONG doi mot
            //      chu so nao. Bien sPivBase GIU NGUYEN dong tinh (KHONG
            //      xoa) du tu nay khong con noi vao txtPiv.
            // <sigbrk> (sSigBrkPiv) GIU NGUYEN o CUOI chuoi - ben MQL5 no nam
            // ngay truoc dau "]" cua cum ngoac vuong, ma cum do Pine khong co
            // (thieu bon cap bo dem giay), nen cuoi chuoi CHINH LA vi tri
            // tuong duong. Dinh dang MOI cua nhan Pivot:
            //   "<TF> <cdlS1> |<RSI5> / <±dRSI> <diffV1V2> <S1onS1> <S1onRV2><sigbrk>"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG
            // doi bat ky input/setting nao.
            // [SUA PIVLBL-CDLS1SEP-02 - THEO YEU CAU] Doi DAU NGAN CACH giua
            // <cdlS1> va cum <RSI5> / <±dRSI> tu " |" sang " $". CHI doi DUNG
            // MOT ky tu ngan cach o CA HAI nhanh cua bieu thuc ba ngoi (nhanh
            // na(pivRsi) va nhanh con lai) - vi tri cac truong, dieu kien
            // na(pivRsi), cong thuc/cach tinh cua tfn, sCdlS1, pivRsi, pivDlt
            // va dinh dang str.tostring(..., "0") KHONG doi mot chu so nao.
            // Dinh dang MOI cua nhan Pivot:
            //   "<TF> <cdlS1> $<RSI5> / <±dRSI> <diffV1V2> <S1onS1> <S1onRV2><sigbrk>"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG
            // doi bat ky input/setting nao.
            // [CAP NHAT THEO YEU CAU] Doi dinh dang nhan Pivot sang:
            //   "<TF> <cdlS1> $<RSI> / <±dRSI> <diffV1V2> {<S1onS1> <S1onRV2><sigbrk>}"
            //   BOC cap <S1onS1> <S1onRV2><sigbrk> (sS1onS1 + " " + sS1onRv2 +
            //   sSigBrkPiv) vao TRONG mot cap ngoac nhon "{ }": dau "{" dan
            //   LIEN NGAY SAU dau cach dung SAU <diffV1V2> (thay cho dau cach
            //   tung dung truoc <S1onS1>), dau "}" dan LIEN NGAY SAU <sigbrk>
            //   (khong dau cach o diem noi, dung vi tri cuoi chuoi ma <sigbrk>
            //   dang dung). Dau cach GIUA <S1onS1> va <S1onRV2> GIU NGUYEN MOT
            //   dau cach. Day THUAN TUY la ky tu trang tri trong chuoi hien
            //   thi (khop cach lam cua "{ }" boc <S1onS1> <S1onRV2> ben
            //   AutoPositionTool_UI.mq5, [SUA PIVLBL-S1BRACE-04]) - hai ky tu
            //   "{" va "}" nam BEN TRONG chuoi hang nen KHONG anh huong den
            //   can bang ngoac nhon cua ma nguon Pine. Gia tri/cach tinh cua
            //   sPivBaseCdl/sDiffV1V2/sS1onS1/sS1onRv2/sSigBrkPiv KHONG doi
            //   mot chu so nao. KHONG tao/xoa label nao, KHONG ve them duong
            //   line nao, KHONG doi bat ky input/setting nao.
            // [SUA RSIEXTREME-01 - THEO YEU CAU] (pivDlt >= 0 ? "+" : "") +
            //   str.tostring(pivDlt, "0") thay bang sPivDlt (tinh o khoi
            //   [BO SUNG RSIEXTREME-01] canh sPivBase o tren) - CHI doi PHAN
            //   HIEN THI <±dRSI>, moi thanh phan/dieu kien/dau ngan cach khac
            //   cua sPivBaseCdl (na(pivRsi), tfn, sCdlS1, " $", pivRsi) GIU
            //   NGUYEN 100% mot chu so nao.
            // [SUA MQL5SYNC-01 - THEO YEU CAU] Khop MQL5 moi: "$" dan LIEN sau
            //   <cdlS1>, dau cach SAU "$"; <±dRSI> LUON la "+x"/"-x" (MQL5 da BO
            //   dang MaxN/MinN - hai input i_rsiExt* van giu, chi khong con dung).
            string sPivDltSync = na(pivDlt) ? "-" : (pivDlt >= 0 ? "+" : "") + str.tostring(pivDlt, "0")
            // [CAP NHAT THEO YEU CAU - DONG BO MQL5] Dinh dang MOI cua nhan
            // Pivot, khop DUNG ban AutoPositionTool_UI.mq5 moi nhat: CHEN
            // <DiffRv2> (sDiffRv2PivNum, tinh o tren) NGAY SAU <diffV1V2> va
            // NGAY TRUOC dau "{"; BO <sigbrk> (sSigBrkPiv) khoi trong ngoac
            // nhon; THEM cum "<diffpv> <diffrv2> <diffrv1>" (sDiffPv/sRv2Df/
            // sDiff1 - BA bien nay DA co san, tinh o tren cung vong lap
            // khung, KHONG tinh lai) vao NGAY SAU dau "}". sPivBaseCdl/
            // sDiffV1V2/sS1onS1/sS1onRv2 KHONG doi mot chu so nao. Dinh dang
            // MOI:
            //   "<TF> <cdlS1>$ <RSI> / <±dRSI> <diffV1V2> <DiffRv2>{ <S1onS1> <S1onRv2>} <diffpv> <diffrv2> <diffrv1>"
            // Bien sSigBrkPiv GIU NGUYEN dong khai bao (KHONG xoa), chi khong
            // con noi vao txtPiv nua. KHONG tao/xoa label nao, KHONG ve them
            // duong line nao, KHONG doi bat ky input/setting nao da co.
            // [CAP NHAT PIVLBL-DIFF2RV1-01 - THEO YEU CAU] CAT cum "<diffpv> <diffrv2> <diffrv1>" (sDiffPv/sRv2Df/sDiff1) RA KHOI nhan Pivot, CHUYEN
            // sang nhan RV1 (dat NGAY SAU dau "{", xem khoi cung ten o (2) COT NHAN RV1 ben duoi). Ba bien sDiffPv/sRv2Df/sDiff1 va cach tinh GIU
            // NGUYEN, CHI khong con noi vao txtPiv. Dau cach sau "}" cung bo theo cum da cat. Dinh dang MOI:
            //   "<TF> <cdlS1> $<RSI> / <±dRSI> <diffV1V2> <DiffRv2>{ <S1onS1> <S1onRV2>}"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi bat ky input/setting nao da co.
            // [CAP NHAT LAM2RV1-PINE-01 - THEO YEU CAU] CAT <diffV1V2> (sDiffV1V2) ra KHOI nhan Pivot, CHUYEN VE nhan RV1. sDiffV1V2 GIU NGUYEN cach tinh. Dinh dang MOI: "<TF> <cdlS1> $<RSI> / <±dRSI> <DiffRv2>{ <S1onS1> <S1onRV2>}"
            // [SUA MQL5SYNC-01 - THEO YEU CAU] Cum { ... } = cum CAT tu nhan RV2
            //   ben MQL5 ([SUA RV2TOPIV-01]): "<WPR1>(<V1V2>) <diffrv1> <WPR2> <diffrv2>".
            // [CAP NHAT THEO MQL5 MOI NHAT - THEO YEU CAU] Dinh dang MOI nhan Pivot (khop MQL5):
            //   "<TF><cdlS1> { <WPR1> <WPR2>}<UpB>/<DnB> <Up>/<Dn> <UpC>/<DnC> <UpA>/<DnA>"
            //   Pine KHONG co bon cap bo dem giay (da LOAI BO, xem khoi varip dau file) nen KHONG them cap nao.
            //   <RSI5> /<+-dRSI> va <diffV1V2>/<diffrv1>/<diffrv2> da chuyen khoi nhan Pivot (xem txtRv1/txtRv2).
            //   Cac bien sPivBaseCdl/sPivSegSync GIU NGUYEN dong tinh, chi khong con noi vao txtPiv.
            // ═══════════════════════════════════════════════════════════════════════════════════════════════════════
            // [SUA MQL5SYNC-02 - THEO YEU CAU] DONG BO 3 NHAN Pivot / RV1 / RV2 THEO DUNG "BANG FORMAT NHAN HIEN TAI" + DrawRv2RsiLabels()
            // cua AutoPositionTool_UI.mq5 ban hien tai (xem ghi chu dau file MQL5). Ghi chu cac ban cu o tren (dinh dang "<cdlS1> $ ...",
            // "{WPR1 WPR2}", "<TF> (<V1V2>) <diffrv1>/<diffrv2>"...) CHI la lich su - dinh dang DANG DUNG la 3 chuoi duoi day.
            // BO QUA nhan/cot PATTERN theo yeu cau (khong dong vao f_patTxt / aptLbPat). Pine khong co bo dem giay UpA..DnC nen mau nhan van la rowClr.
            //
            //   NHAN PIVOT: <TF>[ <lamtron>] (<Pivotdiff>/<Pivotdiff2>)<diffpv> <SpR2>/<SpR1> <RV1MD>/<RV1OW>(<so nen>/<diffV1V2>) <TenMuc> <RSI> <RSI5>/<xu huong>
            //   NHAN RV1  : <TF> {<T>}[<W%>]<pls><IMB>{<erh>/<erhdiff> <erl>/<erldiff>}[ <SigBrk><brkD>(<streak>)]<FVG>
            //   NHAN RV2  : <TF> <MA1> /<MA2> [<RV1W%>] <RV1erh>/.. <RV1erl>/.. [<RV2W%>] <RV2erh>/.. <RV2erl>/..
            // ═══════════════════════════════════════════════════════════════════════════════════════════════════════
            int nBi = array.get(aptNb, i)
            int bP = i_brkDBars
            // <TenMuc> = muc Woodie GAN BID NHAT cua khung (AptWoodieDisplayLvlForTF), g_aptWdLastVal = EMA cua muc do.
            string sTenMuc = best >= 0 ? array.get(aptLvName, best) : ""
            float tenMucVal = best >= 0 ? array.get(aptEmaLv, i * APT_LVN + best) : na
            // <lamtron>: chi khi khung >= 5m va <TenMuc> la R1..R9 / S1..S9 (AptRoundNearStr)
            string sRnd = nBi >= 5 and sTenMuc != "" ? f_roundNear(sTenMuc, tenMucVal) : ""
            array.set(aptRndRS, i, sRnd != "" ? str.tonumber(sRnd) : na)
            // <Pivotdiff> = (EMA0 - EMA1)/spread cua muc Pivot dang chon; <Pivotdiff2> = nhu vay cho muc <TenMuc>
            float pvE0 = pivLiveE0
            float pvE1 = pivLiveE1
            string sPvDiff1 = f_spDiff1(pvE0, pvE1)
            string sPvDiff2 = "-"
            if best >= 0
                [tmE0, tmE1] = f_pvEmaLive(i, best)
                sPvDiff2 := f_spDiff1(tmE0, tmE1)
            // <diffpv> = (RV1 - gia nhan Pivot)/spread ; <SpR2>/<SpR1> = round((Bid-RV2)/spread) / round((Bid-RV1)/spread)
            string sDiffPvM = f_spDiff1(rvL, pvE0)
            string sSpR2 = f_spRound(bid, rv2)
            string sSpR1 = na(rvL) or aptSpreadPx <= 0.0 ? "0" : str.tostring(math.round((bid - rvL) / aptSpreadPx))
            // <RV1MD>/<RV1OW> = (Bid - MD)/spread , (Bid - OW)/spread ; MD = TB Open, OW = LWMA(Open) cua n = brkDBars nen DA DONG
            string sMd = f_spRound(bid, f_mdAvg(i, bP))
            string sOw = f_spRound(bid, f_owLwma(i, bP))
            // <so nen> = so nen TF tu khi Pivot (muc UI) cat OW ; <pls> = |Bid - Pivot luc cat| / so giay
            [pvCrossCnt, sPls] = f_pivCross(i, bP, aptPivIdx, bid)
            string sCntOw = na(pvCrossCnt) ? "-" : str.tostring(pvCrossCnt)
            string sMidTxt = "(" + sPvDiff1 + "/" + sPvDiff2 + ")" + sDiffPvM + " " + sSpR2 + "/" + sSpR1 + " " + sMd + "/" + sOw + "(" + sCntOw + "/" + sDiffV1V2 + ")"
            // <RSI> = RSI/dRSI cua muc <TenMuc> (AptS1RsiTextForTF) ; <RSI5>/<xu huong> = RSI(5) cua EMA muc Pivot / so nen RSI cung chieu
            string sTenRsi = "-"
            if best >= 0
                float rTC = array.get(aptRsiCur, i * APT_LVN + best)
                float rTP = array.get(aptRsiPrv, i * APT_LVN + best)
                if not na(rTC)
                    float rTD = na(rTP) ? 0.0 : rTC - rTP
                    sTenRsi := str.tostring(rTC, "0") + "/" + (rTD >= 0 ? "+" : "") + str.tostring(rTD, "0")
            string sRsi5 = na(pivRsi) ? "-" : str.tostring(pivRsi, "0") + "/" + sPivDltSync
            string txtPiv = tfn + (sRnd != "" ? " " + sRnd : "") + " " + sMidTxt + " " + sTenMuc + " " + sTenRsi + " " + sRsi5

            // ---- NHAN RV1 ----
            string sT1 = f_hhllStr(i, bP)
            if sT1 == ""
                sT1 := "-"
            string sW1 = ""
            if not na(brkDVal)
                float wv1 = f_brkW(i, bP, bid)
                if not na(wv1)
                    sW1 := "[" + str.tostring(int(wv1)) + "]"
            string sPlsR = sPls != "" ? sPls : "-"
            [imbVah, imbVal, imbOk] = f_imbVA(i, tfOnI)
            string sImbM = f_imbMq(imbVah, imbVal, imbOk, bid)
            string sErP = f_priceEr(i, bP)
            if sErP == ""
                sErP := "-/- -/-"
            float sigV = na(brkDVal) ? brkVal : brkDVal
            string sSigC = na(sigV) ? "" : math.round(sigV) >= 110 ? "▲" : math.round(sigV) <= -10 ? "▼" : ""
            string sSegM = sSigC + sBrk
            string sFvgM = f_fvgPush(i, bid)
            string txtRv1M = tfn + " {" + sT1 + "}" + sW1 + sPlsR + sImbM + "{" + sErP + "}" + (sSegM != "" ? " " + sSegM : "") + sFvgM

            // ---- NHAN RV2 ----
            int vld1 = f_rvValid(rvL, aptRvS, i)
            int vld2 = f_rvValid(rv2, aptRv2S, i)
            string sMa1 = f_wprMaM(rvL, aptRvS, i, i_wprPeriod, i_maPeriod, i_maMethod, vld1)
            string sMa2 = f_wprMaM(rv2, aptRv2S, i, i_wprPeriod, i_maPeriod, i_maMethod, vld2)
            string txtRv2M = tfn + " " + (sMa1 != "" ? sMa1 : "-") + " /" + (sMa2 != "" ? sMa2 : "-") + " [" + f_rvChanW(rvL, aptRvS, i, vld1, bP) + "] " + f_rvChanEr(rvL, aptRvS, i, vld1, bP) + " [" + f_rvChanW(rv2, aptRv2S, i, vld2, bP) + "] " + f_rvChanEr(rv2, aptRv2S, i, vld2, bP)
            // [CAP NHAT THEO YEU CAU] "and tfOnI" o cuoi: an nhan cua khung
            // dang bi TAT (chi 3h/4h/6h moi co cong tac, xem f_tfEnabled) thay
            // vi hien du lieu dong bang - i_showPiv (bat/tat ca cot) GIU
            // NGUYEN y het truoc.
            f_setLbl(aptLbPiv, i, xPiv, pivY, txtPiv, rowClr, i_showPiv and tfOnI, label.style_label_left, text.align_left)

            //──────────────────────────────────────────────────────
            // (2) COT NHAN RV1 — dat tai gia RV1 khung 1m DUNG muc gia that,
            //     khong day tuyen tinh. Nhan 1m duoc tach sang vi tri xat ben
            //     canh cot Pivot. AP DUNG DONG NHAT cho CA 6 khung (ke ca 1m).
            //     [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] BO cap
            //     <UpC>/<DnC> khoi nhan RV1, THAY bang cum <brk%><TenMuc>
            //     <RSI>/<±dRSI> vua cat tu nhan Pivot (sBrk, sNearLvl, sNearRsi,
            //     sNearDlt - da tinh san o cac khoi phia tren, KHONG tinh lai):
            //     <brk%> (sBrk) noi NGAY SAU <TF> qua MOT dau cach, roi <TenMuc>
            //     (sNearLvl) dan LIEN NGAY sau sBrk (khong dau cach), roi MOT
            //     dau cach, roi <RSI>/<±dRSI> (sNearRsi/sNearDlt). Dinh dang
            //     MOI: "<TF> <brk%><TenMuc> <RSI>/<±dRSI>".
            //──────────────────────────────────────────────────────
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Nhan RV1 khung
            // 1m doi sang moc RIENG xRv1m1 (cach nen 1m hien tai dung 12 nen
            // 1m ve tuong lai), tach han khoi xPiv/i_gapPiv cua cot Pivot.
            int xRv1Use = i == 0 ? xRv1m1 : xRv1
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] CAT cum
            // "<brk%><TenMuc> <RSI>/<±dRSI>" ra KHOI nhan RV1: nhan RV1 tu nay
            // CHI con lai <TF> - khop [SUA WPR1COL-RV1RV2-01] ben
            // AutoPositionTool_UI.mq5 (txt1Base = g_tfName[i]). Cum vua cat
            // duoc CHUYEN VE cot WPR1COL (xem khoi "(5) COT NHAN WPR1 MOI" ben
            // duoi, noi tai su dung DUNG cac bien sBrk/sNearLvl/sNearRsi/
            // sNearDlt da tinh san o dau vong lap - KHONG tinh lai). Bon bien
            // sBrk/sNearLvl/sNearRsi/sNearDlt GIU NGUYEN dong tinh (KHONG xoa)
            // du tu nay khong con noi vao txtRv1 nua - dung theo yeu cau khong
            // bo sot code goc. KHONG tao/xoa label nao, KHONG ve them duong
            // line nao, KHONG doi input/setting nao.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] (LICH SU - xem
            // [CAP NHAT BRKSCORE-MOVE-01] ngay duoi de biet trang thai HIEN
            // TAI) RIENG nhan RV1 cua khung 1m (i == 0) noi them diem brkScore
            // vao sau ten khung, thanh dung format  tf + " " + brkScore
            // (vi du: "1m 0.73") - khop [SUA BRKSCORE-01] ben MQL5. In 2 chu
            // so thap phan vi mien gia tri chi la [-1.00, +1.00]. Cac khung
            // con lai GIU NGUYEN "<TF>" thuan, khong thua mot ky tu nao.
            // brkScore la na (ca cac khung dang tham gia deu chua du lich su
            // kenh) -> nhan 1m cung giu nguyen dang cu.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] CHUYEN cum ngoac
            // nhon "{<brk><sigbrk><diffpv> <diffrv2> <diffrv1>}" TU nhan RV2 (xem
            // khoi "[CAP NHAT RV2LBL-ADDBRKPVDIFF-01]" canh dong ghep txtRv2 o (3)
            // ben duoi, CUNG vong lap khung nay) SANG nhan RV1, noi NGAY SAU <TF> -
            // khop [SUA RV1RV2-MOVEBRK-01] ben AutoPositionTool_UI.mq5. Bon truong
            // <brk>/<diffpv>/<diffrv2>/<diffrv1> dung LAI DUNG bien sBrk/sDiffPv/
            // sRv2Df/sDiff1 da tinh san o dau vong lap "for i" (xem (1), KHONG
            // tinh lai). Rieng <sigbrk> can DUNG CONG THUC uu tien brkDVal (giong
            // sSigBrkR2Lbl o (3), KHAC sSigBrkPiv o (1) chi dung brkVal) nhung
            // sSigBrkR2Lbl/sSigBrk goc deu nam SAU diem nay trong CUNG vong lap
            // (chua co gia tri luc txtRv1 duoc go) - dung Y HET ly do
            // rv2NextR2Lbl/sDiffRv2R2Lbl va sSigBrkR2Lbl o (3) da phai tach rieng
            // ban sao thay vi doc thang bien cua (5) - PHAI khai bao RIENG mot ban
            // sao MOI (sSigBrkRv1Lbl) ngay tai day, tinh DOC LAP tu CHINH
            // brkVal/brkDVal da co san (CUNG hai bien ma sBrk o tren dang dung),
            // KHONG dinh nghia lai nguong nao, KHONG doc them du lieu nao. Nhan RV1
            // cua khung 1m (i == 0) tung noi them " " + brkScore NGAY SAU cum
            // ngoac nhon nay (dung dieu kien i == 0 and sBrkScore != "" - xem
            // [CAP NHAT BRKSCORE-MOVE-01] ngay duoi de biet trang thai HIEN
            // TAI). Pine KHONG co UpbrkScore/DnbrkScore tuong ung ben MQL5 -
            // bon cap bo dem giay da LOAI BO tu truoc (xem ghi chu tai khoi varip
            // dau file) nen KHONG bia them cum do. Dinh dang CU cua nhan RV1
            // (truoc [CAP NHAT BRKSCORE-MOVE-01]):
            //   khung 1m:         "<TF>{<brk><sigbrk><diffpv> <diffrv2> <diffrv1>} <brkScore>"
            //   khung 5m tro len: "<TF>{<brk><sigbrk><diffpv> <diffrv2> <diffrv1>}"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao.
            // [CAP NHAT RV1LBL-ADDTENMUCRSI-01 - THEO YEU CAU] CAT cum
            // "<TenMuc> <RSI5>/<diff>" ra KHOI cot WPR1COL (xem khoi
            // "[CAP NHAT WPR1COL-DROPBRKBLOCK-01]" o (5) phia duoi, CUNG vong
            // lap khung nay - noi cum nay bi CAT khoi txtWpr1Col) CHUYEN VE
            // nhan RV1 nay - khop [SUA RV1LBL-ADDTENMUCRSI-01] ben
            // AutoPositionTool_UI.mq5. Cum nay (sNearLvl + " " + sNearRsi +
            // "/" + sNearDlt) chen NGAY SAU dau "{" va NGAY TRUOC <brk>, moi
            // dau noi mot dau cach. sNearLvl/sNearRsi/sNearDlt da tinh san o
            // dau vong lap "for i" (xem (1), CUNG bien ma cot WPR1COL tung
            // dung) - KHONG tinh lai, KHONG khai bao bien moi. AP DUNG DONG
            // NHAT cho CA 6 khung (ke ca 1m) - xem [CAP NHAT BRKSCORE-MOVE-01]
            // ngay duoi ve viec khung 1m KHONG con noi them " " + sBrkScore
            // phia SAU dau "}" nua. Dinh dang CU cua nhan RV1 (truoc [CAP NHAT
            // BRKSCORE-MOVE-01]):
            //   khung 1m:         "<TF>{<TenMuc> <RSI5>/<diff> <brk><sigbrk><diffpv> <diffrv2> <diffrv1>} <brkScore>"
            //   khung 5m tro len: "<TF>{<TenMuc> <RSI5>/<diff> <brk><sigbrk><diffpv> <diffrv2> <diffrv1>}"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao da co.
            // [CAP NHAT BRKSCORE-MOVE-01 - THEO YEU CAU] CAT " " + sBrkScore RA
            // KHOI txtRv1 (hang 1 cua cum RV1 khung 1m) - hang 1 tu nay dung
            // CHUNG DUNG MOT cong thuc cho CA 6 khung (khong con nhanh
            // "i == 0 and sBrkScore != ..." rieng cho khung 1m), khong thua
            // mot ky tu nao. Noi dung sBrkScore vua cat CHUYEN xuong VE HANG 2
            // cua cum RV1 khung 1m (nhan aptLbRv1m2, truoc gio khai bao "var
            // label aptLbRv1m2 = na" nhung KHONG BAO GIO duoc f_setOne() gan
            // gia tri - xem khoi "[GIU NGUYEN - KHONG XOA] Ban CU (ca cum 6
            // hang dung CHUNG moc xPiv...)" ngay duoi ham nay: dong
            // "aptLbRv1m2 := f_setOne(...)" nam TRONG comment, chua tung duoc
            // kich hoat - vi tri hang 2 tren chart vi vay dang TRONG THAT, y
            // het vi tri TSFLAM ben AutoPositionTool_UI.mq5). Xem khoi ve
            // "[CAP NHAT BRKSCORE-MOVE-01]" ngay duoi (trong nhanh "if i == 0")
            // de biet noi ve. Cong thuc brkScore (f_brkScore(), sBrkScore)
            // GIU NGUYEN 100%, CHI doi noi hien thi. KHONG tao/xoa label nao o
            // day, KHONG ve them duong line nao, KHONG doi input/setting nao.
            // [CAP NHAT THEO YEU CAU - DONG BO MQL5] _rv1SpRatio = diffrv1 /
            // spread, lam tron SO NGUYEN ("gap bao nhieu lan"). Pine KHONG co
            // du lieu spread song theo tung nen (khac MT5 CopySpread) nen
            // DUNG LAI DUNG input i_asymSpreadPts (Spread co dinh, mac dinh
            // 0.3, DA CO SAN trong file tu truoc - xem khoi khai bao dau
            // file - KHONG tao input moi) thay cho spread song ben MQL5.
            // diffRv1 DA co san (tinh o dau vong lap khung, dong "float
            // diffRv1 = na(rvL) ? na : bid - rvL"), KHONG tinh lai. Thieu du
            // lieu -> "0", KHONG doan gia tri.
            // [BO SUNG BARLBL-CUR-01 - THEO YEU CAU] Khung than nen lon (aptBarIdx):
            //   hang 1 = "<V1V2> <RSI5> / <±dRSI>" (RSI cua muc S1 CO DINH, k = 10,
            //   cung cach lay preview/confirmed nhu nhan Pivot);
            //   hang 2 = "<diffpv>  <DiffV1V2> <Bid-RV2> <Bid-RV1><sig><brk><spRatio>"
            //   dung lai DUNG cac chuoi da tinh cho nhan RV1, KHONG tinh lai.
            // [CAP NHAT THEO YEU CAU - DONG BO MQL5] Dinh dang MOI cua nhan
            // RV1, khop DUNG ban AutoPositionTool_UI.mq5 moi nhat NHUNG chi
            // giu lai truong Pine DANG CO (UpC/DnC - Pine da CHU DONG bo
            // Up/Dn va UpA/DnA/UpB/DnB tu truoc, xem ghi chu tai khoi khai
            // bao varip dau file, KHONG dung lai o day): BO cum <diffpv>
            // <diffrv2> <diffrv1> (sDiffPv/sRv2Df/sDiff1) va dau "}" dong o
            // cuoi; THEM cum <UpC>/<DnC> (sUpCs/sDnCs, DA co san, tinh o dau
            // vong lap khung, KHONG tinh lai) NGAY SAU <sigbrk>; CHUYEN
            // <brk%> (sBrk) RA CUOI cung, dan LIEN NGAY TRUOC _rv1SpRatio
            // (khong dau cach). Dinh dang MOI:
            //   "<TF>{<TenMuc> <RSI>/<Δ> <sigbrk><UpC>/<DnC> <brkD>(<streak>)<_rv1SpRatio>"
            // sNearLvl/sNearRsi/sNearDlt/sSigBrkRv1Lbl KHONG doi mot chu so
            // nao. Bien sDiffPv/sRv2Df/sDiff1 GIU NGUYEN dong tinh (KHONG
            // xoa, van dung cho nhan Pivot o (1)), CHI khong con noi vao
            // txtRv1 nua. KHONG tao/xoa label nao, KHONG ve them duong line
            // nao, KHONG doi bat ky input/setting nao da co.
            // [CAP NHAT THEO YEU CAU MOI] Dinh dang MOI cua nhan RV1 - cap
            // <UpC>/<DnC> (sUpCs/sDnCs) BO HAN khoi chuoi hien thi (xem khoi
            // "BO DEM CONG DON" va khoi varip dau file - da loai bo ca tinh
            // lan hien thi); THEM cum bo ba WPR1/WPR2 va cac hieu so
            // <diffV1V2>/<diffrv1>/<diffrv2> (tripleRv1c/sDiffV1V2/sDiff1/
            // tripleRv2c/sRv2Df - CAT tu nhan RV2 o (3), noi NGAY SAU dau "{"
            // mo dau, TRUOC cum <TenMuc> <RSI>/<Δ> <sigbrk> <brk%(streak)>
            // <_rv1SpRatio> da co san) vao nhan RV1. Cac bien
            // tripleRv1c/sDiffV1V2/sDiff1/tripleRv2c/sRv2Df da tinh SAN o dau
            // vong lap "for i" (xem khoi "BO DEM CONG DON" phia tren va khoi
            // (3) COT NHAN RV2 ben duoi), KHONG tinh lai, KHONG doc them du
            // lieu nao. sNearLvl/sNearRsi/sNearDlt/sSigBrkRv1Lbl/sBrk/
            // sRv1SpRatio GIU NGUYEN cong thuc, KHONG doi mot chu so nao.
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG
            // doi bat ky input/setting nao da co. Dinh dang MOI:
            //   "<TF>{{dWPR1}/{WPR1}/{MA1}/<diffV1V2> <diffrv1> {dWPR2}/{WPR2}/{MA2} <diffrv2> <TenMuc> <RSI>/<Δ> <sigbrk> <brk%(streak)><_rv1SpRatio>"
            // [CAP NHAT RV1LBL-MOVESIGBRK-FRONT-01 - THEO YEU CAU] Doi cho cum <sigbrk><brk%(streak)><_rv1SpRatio>
            // tu CUOI cau len NGAY SAU dau "{" (truoc cum WPR1). Dinh dang MOI:
            //   "<TF>{<sigbrk><brk%(streak)><_rv1SpRatio> {dWPR1}/{WPR1}/{MA1}/<diffV1V2> <diffrv1> {dWPR2}/{WPR2}/{MA2} <diffrv2> <TenMuc> <RSI>/<Δ> "
            // [CAP NHAT RV1-TENMUC2WPR1COL-01 - THEO YEU CAU] CAT cum
            // "<TenMuc> <RSI>/<Δ>" (sNearLvl + " " + sNearRsi + "/" + sNearDlt)
            // RA KHOI nhan RV1, CHUYEN sang cot WPR1COL (xem khoi cung ten o
            // (5) ben duoi, CUNG vong lap "for i") - khop [SUA
            // RV1-TENMUC2WPR1COL-01] ben AutoPositionTool_UI.mq5. Ba bien
            // sNearLvl/sNearRsi/sNearDlt va cach tinh GIU NGUYEN, CHI khong con
            // noi vao txtRv1. Dau cach cuoi chuoi giu nguyen nhu ban cu. Dinh
            // dang MOI:
            //   "<TF>{<sigbrk><brk%(streak)><_rv1SpRatio> {dWPR1}/{WPR1}/{MA1}/<diffV1V2> <diffrv1> {dWPR2}/{WPR2}/{MA2} <diffrv2> "
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // bat ky input/setting nao da co.
            // [CAP NHAT PIVLBL-DIFF2RV1-01 - THEO YEU CAU] Nhan cum "<diffpv> <diffrv2> <diffrv1>" (sDiffPv/sRv2Df/sDiff1 - DA co san, tinh o dau
            // vong lap khung, KHONG tinh lai) CAT tu nhan Pivot o (1) ve, dat NGAY SAU dau "{", truoc <sigbrk>. <diffrv1> (sau <diffV1V2>) va
            // <diffrv2> (sau bo ba WPR2) BO khoi vi tri cu, cac dau cach bao quanh GIU NGUYEN. Ap dung DONG NHAT cho CA cac khung (1m va 5m tro len).
            // Dinh dang MOI:
            //   "<TF>{<diffpv> <diffrv2> <diffrv1> <sigbrk><brk%(streak)><_rv1SpRatio> {dWPR1}/{WPR1}/{MA1}/<diffV1V2>  {dWPR2}/{WPR2}/{MA2}  "
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi bat ky input/setting nao da co.
            // [SUA RV1LBL-NEWFMT-PINE-01 - THEO YEU CAU] Dinh dang MOI:
            //   <TF>{<TenMuc> <RSI>/<+-dRSI> <diffpv> <Bid-RV2> <Bid-RV1> <SigBrk><Brk>(<Streak>)<SpRatio> <WPR1d>/<WPR1>/<MA1>/<DiffV1V2>  <WPR2d>/<WPR2>/<MA2>
            // Chen <TenMuc> <RSI>/<dRSI> (sNearLvl/sNearRsi/sNearDlt - DA TINH SAN) ngay sau "{", bo 2 dau cach thua o cuoi.
            // [CAP NHAT LAM2RV1-PINE-01 - THEO YEU CAU] CAT CHUYEN <Lambda><▲▼> (sLamStrNoSpc/sPushStr) tu cot WPR1COL va <diffV1V2> (sDiffV1V2) tu nhan Pivot VE nhan RV1.
            // Cach tinh sLamStr/sPushStr/sLamStrNoSpc GIU NGUYEN (chi doi VI TRI khai bao len day). KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi input/setting nao.
            // Dinh dang MOI:
            //   <TF>{<Lambda><▲▼> <TenMuc> <RSI>/<±dRSI> {<diffpv>/<diffV1V2>} <Bid-RV2>/<Bid-RV1> <SigBrk><Brk>(<Streak>)<SpRatio> {dWPR1}/{WPR1}/{MA1}/<diffV1V2>  {dWPR2}/{WPR2}/{MA2}
            // [CAP NHAT LAM-6H-01 - THEO YEU CAU] Dieu kien cong "<= 240"
            // doi thanh "<= 360" de khung 6h (aptNb[8] = 360, dang bi loai
            // khoi cong Lam vi 360 > 240) duoc tinh sLamStr y het 8 khung
            // con lai. f_tickPressure() da nang tran kep tuong ung (xem khoi
            // [CAP NHAT LAM-6H-01] o dinh nghia ham) nen 6h nhan dung 360 nen
            // M1 cua chinh no, khong bi kep chung ve 240 nhu 4h. 1m..4h
            // khong doi (aptNb cua chung deu <= 240 tu truoc).
            // [SUA MQL5SYNC-01 - THEO YEU CAU] Khop MQL5 moi: nhan RV1 chi con
            //   "<TF>" (ben MQL5 sau <TF> la 3 cap bo dem giay - Pine KHONG
            //   port) + ten nen dao chieu + mui ten cho khung > 1m. Cac cum cu
            //   da chuyen sang WPR1COL / nhan Pivot / cum duoi day than nen lon.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Uu tien vi tri
            // THEO THU TU KHUNG cho cot nhan RV1 - khop khoi "uu tien vi tri
            // nhan RV1 (khung >= 5m)" ben MQL5 (DrawRv2RsiLabels(), khoi
            // "for(int _c = 0; _c <= 1; _c++)", cot _c == 0 sau khi doi sang
            // f_priorityPushY-style o do): khung 1m (i == 0) GIU NGUYEN vi tri
            // gia that (rvL), KHONG qua f_priorityPushY va KHONG ghi vao
            // aptRv1YAdj - dung y het viec MQL5 loai nhan RV1 cua 1m ra khoi
            // day uu tien (no dat o cot rieng, xat canh cot Pivot). Cac khung
            // 5m tro len (i >= 1) moi qua f_priorityPushY, dung CHUNG mang
            // aptRv1YAdj lam settled - khung dung TRUOC (i nho hon trong nhom
            // 1..5) uu tien cao hon.
            float rv1Y = rvL
            if i >= 1
                rv1Y := f_priorityPushY(rvL, aptRv1YAdj, aptRv1YRaw, i, stepSafe)
                array.set(aptRv1YAdj, i, rv1Y)
                array.set(aptRv1YRaw, i, rvL)
            // [CAP NHAT THEO YEU CAU] "and tfOnI" o cuoi: an nhan cua khung
            // dang bi TAT - i_showRv1 GIU NGUYEN y het truoc.
            // [SUA MQL5SYNC-02] Nhan RV1 neo TRAI (ANCHOR_LEFT ben MQL5) -> style_label_left: chu chay sang PHAI cua moc cot.
            f_setLbl(aptLbRv1, i, xRv1Use, rv1Y, txtRv1M, rowClr, i_showRv1 and tfOnI, label.style_label_left, text.align_left)


            //──────────────────────────────────────────────────────
            // (3) COT NHAN RV2 — dat tai gia RV2 that cua tung khung.
            //     [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Doi nguon du
            //     lieu cua ba WPR noi vao nhan RV2: tu WPR2 (tren chuoi RV2)
            //     SANG WPR1 (tren THANG chuoi RV1 - tripleRv1c, tinh SOM o dau
            //     vong lap, KHONG tinh lai) - Pine chi co MOT bo tham so
            //     i_wprPeriod/i_maPeriod/i_maMethod dung chung cho ca RV1 va
            //     RV2 (khong them input Period1 rieng nhu MQL5, giu DUNG gioi
            //     han da ghi trong header) nen chi doi NGUON chuoi, khong doi
            //     tham so nao. Dinh dang chuoi tra ve van la "{dWPR}/{WPR}/{MA}"
            //     (f_wprTripleStr khong doi mot dong nao). Nhan RV2 tu nay co
            //     dang "<TF>v{dWPR1}/{WPR1}/{MA1}".
            //──────────────────────────────────────────────────────
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] CAT bo ba
            // {dWPR1}/{WPR1}/{MA1} (tripleRv1c) ra KHOI nhan RV2: bo ba nay
            // CHUYEN VE cot WPR1COL (xem khoi "(5) COT NHAN WPR1 MOI" ben
            // duoi) - khop [SUA WPR1COL-RV1RV2-01] ben AutoPositionTool_UI.mq5.
            // Ben MQL5, cho trong nhan RV2 SAU KHI cat duoc THAY bang cum
            // ngoac vuong "[<UpB>/<DnB> <UpA>/<DnA> <Up>/<Dn><DiffRv2>]" - Pine
            // KHONG co bon bo dem Up/Dn, UpA/DnA, UpB/DnB (da LOAI BO tu truoc,
            // xem ghi chu [LOAI BO - THEO YEU CAU] tai khoi varip dau file va
            // canh sPivBase o tren) nen KHONG co du lieu de dung cum ngoac
            // vuong tuong duong - THEO YEU CAU "voi nhung gia tri dang co san
            // (khong co Up/Dn, UpA/DnA, UpB/DnB)", nhan RV2 tu nay CHI con lai
            // "<TF>v" (khong noi them gi khac). tripleRv1c GIU NGUYEN dong
            // tinh o dau vong lap (KHONG xoa) - CHI CHUYEN NOI DUNG sang cot
            // WPR1COL. KHONG tao/xoa label nao, KHONG ve them duong line nao,
            // KHONG doi input/setting nao.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] THEM <DiffRv2>
            // vao nhan RV2 - khop dung y "nhan RV2 ben MQL5 sau khi cat WPR1
            // duoc THAY bang cum chua DiffRv2" nhung Pine KHONG co Up/Dn/
            // UpA/DnA/UpB/DnB de boc ngoac nen dinh dang rut gon CHI con
            // "<TF><DiffRv2>" (BO LUON ky tu "v" - dung dinh dang da yeu cau:
            // tf + <DiffRv2>). <DiffRv2> tinh Y HET cong thuc sDiffRv2 cua cot
            // WPR1COL o (5) (so sanh RV2 cua CHINH khung nay (rv2) voi RV2 cua
            // khung cao hon lien ke (array.get(aptRv2, i+1)): rv2 lon hon ->
            // "▲", nguoc lai -> "▼"; thieu du lieu hoac la khung cao nhat ->
            // "" (khong doan huong)) - PHAI khai bao RIENG mot ban sao
            // (rv2NextR2Lbl/sDiffRv2R2Lbl) tai day thay vi doc thang bien
            // sDiffRv2/rv2Next cua (5), vi hai bien do nam SAU diem nay trong
            // vong lap (chua co gia tri luc txtRv2 duoc go) - dung Y HET ly do
            // nhan Pivot da phai tach rieng sDiffRv2Piv/rv2NextPiv thay vi doc
            // thang sDiffRv2 (xem ghi chu canh khoi tinh sDiffRv2Piv o (1)).
            // sDiffRv2/rv2Next cua (5) GIU NGUYEN, KHONG doi. KHONG tao/xoa
            // label nao, KHONG ve them duong line nao, KHONG doi input/setting
            // nao.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Khop [SUA
            // RV2LBL-DIFFRV2-01] ben AutoPositionTool_UI.mq5: <DiffRv2> doi
            // tu KY HIEU tam giac sang GIA TRI SO = RV2 khung nay - RV2 khung
            // lon hon lien ke, in 1 chu so thap phan (khop DoubleToString(...,
            // M1_ELP_LBL_DIF1_DIGITS = 1)); thieu du lieu hoac la khung CAO
            // NHAT (i + 1 >= APT_TFN, rv2NextR2Lbl la na) -> "-" (khong doan
            // gia tri, dung quy uoc "thieu du lieu -> dau gach" ma ca file
            // dang dung), thay cho chuoi rong truoc day. Ky tu "v" duoc TRA
            // LAI vao giua <TF> va <DiffRv2> de nhan RV2 khop DUNG dinh dang
            // "<TF>v<DiffRv2>" ben MQL5. Nguon du lieu GIU NGUYEN 100%: van
            // la rv2 cua chinh khung nay va array.get(aptRv2, i + 1) - KHONG
            // tinh lai RV2, KHONG doc them du lieu nao. KHONG tao/xoa label
            // nao, KHONG ve them duong line nao, KHONG doi input/setting nao.
            // [CAP NHAT RV2LBL-ADDBRKPVDIFF-01 - THEO YEU CAU] BO SUNG
            // <brk><sigbrk><diffpv> <diffrv2> <diffrv1> vao BEN TRONG cap
            // ngoac nhon cua nhan RV2 - khop [SUA RV2LBL-ADDBRKPVDIFF-01] ben
            // AutoPositionTool_UI.mq5. Bon truong <brk>/<diffpv>/<diffrv2>/
            // <diffrv1> dung LAI DUNG bien sBrk/sDiffPv/sRv2Df/sDiff1 da tinh
            // san o dau vong lap "for i" nay (xem (1), KHONG tinh lai). Rieng
            // <sigbrk> CHUA co bien dung duoc tai day (sSigBrk goc tinh SAU
            // diem nay trong CUNG vong lap, phuc vu txtPiv/txtWpr1Col - doc
            // se ra gia tri rong "na"/chua gan) nen PHAI khai bao RIENG mot
            // ban sao (sSigBrkR2Lbl) ngay tai day, tinh DOC LAP tu CHINH
            // brkVal/brkDVal da co san (CUNG hai bien ma sBrk o tren dang
            // dung) - dung Y HET cong thuc cua sSigBrk goc (brkD uu tien hon
            // brk% khi co, nguong >=110.0 -> "▲", <=-10.0 -> "▼", con lai ->
            // " "), KHONG dinh nghia lai nguong nao, KHONG doc them du lieu
            // nao - dung Y HET ly do rv2NextR2Lbl/sDiffRv2R2Lbl da phai tach
            // rieng thay vi doc thang rv2Next/sDiffRv2 cua (5). sBrk/sSigBrk/
            // sDiffPv/sRv2Df/sDiff1 goc va moi noi dang dung chung (txtPiv,
            // txtWpr1Col) GIU NGUYEN, KHONG doi. Truong <DiffRv2>
            // (sDiffRv2R2Lbl) NGOAI ngoac nhon GIU NGUYEN, khong doi. Dinh
            // dang MOI cua nhan RV2:
            //   "<TF>{<brk><sigbrk><diffpv> <diffrv2> <diffrv1>}<DiffRv2>"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG
            // doi input/setting nao da co.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] CAT cum ngoac nhon
            // "{<brk><sigbrk><diffpv> <diffrv2> <diffrv1>}" RA KHOI nhan RV2,
            // CHUYEN sang nhan RV1 (xem khoi "[CAP NHAT THEO BAN MQL5 MOI NHAT]"
            // canh dong ghep txtRv1 o (2) phia tren, CUNG vong lap khung nay) -
            // khop [SUA RV1RV2-MOVEBRK-01] ben AutoPositionTool_UI.mq5. Bien
            // sSigBrkR2Lbl va cach tinh (dong ngay tren) GIU NGUYEN, KHONG doi mot
            // chu so nao - CHI khong con noi vao txtRv2 nua (van con nguyen dong
            // khai bao/tinh, dung theo yeu cau khong bo sot code goc). Bon bien
            // sBrk/sDiffPv/sRv2Df/sDiff1 cung GIU NGUYEN dong khai bao o dau vong
            // lap, doc lai o nhan RV1 qua CHINH cac bien nay (KHONG tinh lai/khai
            // bao bien moi). Truong <DiffRv2> (sDiffRv2R2Lbl) NGOAI cum ngoac nhon
            // GIU NGUYEN vi tri, van dan LIEN ngay sau <TF>. Dinh dang MOI cua
            // nhan RV2: "<TF><DiffRv2>". KHONG tao/xoa label nao, KHONG ve them
            // duong line nao, KHONG doi input/setting nao.
            // [CAP NHAT RV2LBL-ADDWPRDIFF-01 - THEO YEU CAU] CAT cum
            // "{dWPR1}/{WPR1}/{MA1}/<diffV1V2> <diffrv1> {dWPR2}/{WPR2}/{MA2}
            // <diffrv2>" TU cot WPR1COL (xem khoi "[CAP NHAT WPR1COL-FMT-FINAL-04]"
            // canh dong ghep txtWpr1Col o (5) ben duoi, CUNG vong lap khung
            // nay - noi cum nay bi CAT khoi txtWpr1Col) CHUYEN VE nhan RV2 nay,
            // chen NGAY SAU <TF> va NGAY TRUOC <DiffRv2> (sDiffRv2R2Lbl), moi
            // dau noi mot dau cach - khop [SUA WPR1COL-RV1RV2-02] ben
            // AutoPositionTool_UI.mq5. Nam truong cua cum (tripleRv1c/
            // sDiffV1V2/sDiff1/tripleRv2c/sRv2Df) dung LAI DUNG CHINH cac bien
            // da tinh san o dau vong lap "for i" nay (xem (1)/dau vong lap,
            // KHONG tinh lai, KHONG khai bao ban sao moi - CUNG mot vong lap
            // duy nhat nen khong can tach rieng nhu cac ban sao R2Lbl/Piv
            // khac): {dWPR1}/{WPR1}/{MA1} = tripleRv1c, <diffV1V2> =
            // sDiffV1V2, <diffrv1> = sDiff1, {dWPR2}/{WPR2}/{MA2} =
            // tripleRv2c, <diffrv2> = sRv2Df.
            // [CAP NHAT THEO YEU CAU - DONG BO MQL5] CAT truong <DiffRv2>
            // (sDiffRv2R2Lbl) RA KHOI nhan RV2 - truong nay CHUYEN VE nhan
            // Pivot o (1) (xem khoi "sDiffRv2PivNum" canh dong khai bao
            // sSigBrkPiv, va dong ghep txtPiv, phia tren trong CUNG ham nay).
            // Bien sDiffRv2R2Lbl va cach tinh no (rv2NextR2Lbl o tren) GIU
            // NGUYEN, KHONG xoa - CHI khong con noi vao txtRv2 nay nua. Dinh
            // dang MOI cua nhan RV2:
            //   "<TF> {dWPR1}/{WPR1}/{MA1}/<diffV1V2> <diffrv1> {dWPR2}/{WPR2}/{MA2} <diffrv2>"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG
            // doi input/setting nao da co.
            // [CAP NHAT THEO YEU CAU MOI] Toan bo cum {dWPR1}/{WPR1}/{MA1}/
            // <diffV1V2> <diffrv1> {dWPR2}/{WPR2}/{MA2} <diffrv2>
            // (tripleRv1c/sDiffV1V2/sDiff1/tripleRv2c/sRv2Df) da CAT sang noi
            // vao nhan RV1 o (2) (xem ghi chu canh dong ghep txtRv1 o (2) phia
            // tren, CUNG vong lap khung nay). Cac bien tripleRv1c/sDiffV1V2/
            // sDiff1/tripleRv2c/sRv2Df GIU NGUYEN dong khai bao/tinh (KHONG
            // xoa, van doc lai qua CHINH cac bien nay o nhan RV1), CHI khong
            // con noi vao txtRv2 nay nua. Nhan RV2 tu nay CHI con lai "<TF>
            // V2" (khong noi them gi khac). KHONG tao/xoa label nao, KHONG ve
            // them duong line nao, KHONG doi input/setting nao da co. Dinh
            // dang MOI cua nhan RV2:
            //   "<TF> V2"
            // [SUA MQL5SYNC-01 - THEO YEU CAU] Khop MQL5 moi: nhan RV2 = "<TF>".
            // [CAP NHAT THEO MQL5 MOI NHAT - THEO YEU CAU] Dinh dang MOI nhan RV2 (khop MQL5):
            //   "<TF> (<diffV1V2>) <diffrv1>/<diffrv2>"
            //   (ben MQL5 sau do con <Up>/<Dn> <UpC>/<DnC> <UpA>/<DnA> - Pine KHONG co cac bo dem giay nen KHONG them).
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Uu tien vi tri
            // THEO THU TU KHUNG cho cot nhan RV2 - khop khoi uu tien vi tri
            // cot RV2 ben MQL5 (DrawRv2RsiLabels(), cot _c == 1 sau khi doi
            // sang f_priorityPushY-style): AP DUNG CHO CA 6 khung (ke ca 1m,
            // KHONG loai khung nao - khac cot RV1 o tren), khung dung TRUOC
            // (i nho hon) uu tien cao hon, dung CHUNG mang aptRv2YAdj lam
            // settled.
            float rv2Y = f_priorityPushY(rv2, aptRv2YAdj, aptRv2YRaw, i, stepSafe)
            array.set(aptRv2YAdj, i, rv2Y)
            array.set(aptRv2YRaw, i, rv2)
            // [CAP NHAT THEO YEU CAU] "and tfOnI" o cuoi: an nhan cua khung
            // dang bi TAT - i_showRv2 GIU NGUYEN y het truoc.
            // [SUA MQL5SYNC-02] Nhan RV2 neo TRAI (ANCHOR_LEFT) tai cot RV2.
            f_setLbl(aptLbRv2, i, xRv2, rv2Y, txtRv2M, rowClr, i_showRv2 and tfOnI, label.style_label_left, text.align_left)

            //──────────────────────────────────────────────────────
            // (4) CUM NHAN DINH NEN (CRL)
            //   [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Cap <UpC>/<DnC>
            //   da CAT tiep sang cot nhan RV1 o (2) (xem khoi tinh sUpCs/sDnCs
            //   da doi len DAU vong lap). Bo ba WPR2 "{dWPR}/{WPR}/{MA}"
            //   (tripleRv2c) da CAT tiep sang cot nhan RV2 o (3). Ca cum "<TF>
            //   {dWPR1}/{WPR1}/{MA1}" (tfn + tripleRv1c, qua bien wprBlock ben
            //   duoi) — phan CUOI CUNG con lai cua CRL — da CAT NOT chuyen thanh
            //   MOT COT RIENG o (5) (xem khoi "COT NHAN WPR1 MOI" ngay sau vong
            //   lap chinh). CRL tu nay txtCrl LUON RONG. Bien wprBlock (va
            //   tripleRv1c/tripleRv2c dung de tinh no, gio da doi len DAU vong
            //   lap) KHONG bi xoa — VAN tinh nguyen, CHI khong con noi vao
            //   txtCrl nua. KHONG tao/xoa label nao ngoai quy tac cu, KHONG ve
            //   them duong nao, KHONG doi input nao da co (ngoai i_wpr1ColPts
            //   moi o (5)).
            //──────────────────────────────────────────────────────
            string txtCrl = ""
            float yCrl = high + step * (i + 1)
            f_setLbl(aptLbCrl, i, xCrl, yCrl, txtCrl, rowClr, i_showCrl, label.style_label_right, text.align_right)

            //──────────────────────────────────────────────────────
            // (5) COT NHAN WPR1 MOI — [GIU NGUYEN - KHONG XOA] Ban CU (cum
            //   "<TF> {dWPR1}/{WPR1}/{MA1}" - dung tripleRv1c, WPR tren THANG
            //   chuoi RV1 - CAT tu CRL o (4) chuyen thanh MOT COT RIENG, neo
            //   tren CUNG truc thoi gian voi nhan RV1 khung 1m):
            //   Cot nay xep TU DUOI LEN, khung nho nhat (1m, i=0) o DUOI CUNG
            //   cua cot MOI - cach hang 1 dung i_wpr1ColPts point (input, mac
            //   dinh 100) - khung lon dan len TREN (i cang lon cang len cao),
            //   buoc gia moi hang la stepSafe. i_showWpr van dieu khien hien/an
            //   CA COT nay; thieu du lieu -> hang do CHI con <TF>. Mau tung
            //   hang dung lai rowClr.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Doi nguon du
            //   lieu cua CA COT WPR1COL: tu WPR1 (tripleRv1c, tren chuoi RV1)
            //   SANG WPR2 (tripleRv2c, tren chuoi RV2 = EMA(5) cua RV1 - da
            //   tinh SOM o dau vong lap, KHONG tinh lai) - khop dung [SUA
            //   RV1-SWAPWPR-01] ben AutoPositionTool_UI.mq5 (WPR1COL doi sang
            //   dung Wpr8BuildRv2M1Series() + tham so InpWpr8Period/
            //   InpMa8Period/InpMa8Method - CHINH la i_wprPeriod/i_maPeriod/
            //   i_maMethod cua ban Pine nay, vi Pine chi co MOT bo tham so
            //   dung chung, khong them input moi). Dinh dang chuoi tra ve van
            //   la "{dWPR}/{WPR}/{MA}" (f_wprTripleStr khong doi mot dong
            //   nao), CHI doi NGUON chuoi truyen vao. Hang tren dinh cot (khung
            //   2h - Pine chi co 6 khung 1m..2h, KHONG co MN1 nhu MQL5) tu nay
            //   co dang "2h {dWPR2}/{WPR2}/{MA2}"; ca 6 hang cua cot deu doi
            //   dong nhat theo CUNG cong thuc, KHONG rieng mot hang nao. KHONG
            //   tao/xoa object nao, KHONG ve them duong line nao, KHONG doi
            //   setting/input nao.
            //──────────────────────────────────────────────────────
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] THEM <diffpv>,
            //   <DiffRv2>, <sigbrk> vao cot WPR1COL - khop cac ban [SUA
            //   RV1-WPR1COL-ADDDIFFPV-01]/[SUA RV1-WPR1COL-ADDDIFFRV2-01]/
            //   [SUA RV1-WPR1COL-ADDSIGBRK-01] ben AutoPositionTool_UI.mq5.
            //   KHONG port cap ngoac don "(<UpA>/<DnA> | <Up>/<Dn> |
            //   <UpB>/<DnB>)" - Pine da bo han cap nay tu truoc (dem giay
            //   khong chinh xac so voi MQL5, xem [LOAI BO - THEO YEU CAU] o
            //   nhan Pivot), nen ba truong nay noi TRUC TIEP, khong ngoac don:
            //   <diffpv> (sDiffPv, DA CO SAN, chi doi noi ghep TU nhan Pivot
            //   sang day); <DiffRv2> so sanh RV2 cua CHINH khung nay
            //   (array.get(aptRv2, i)) voi RV2 cua khung cao hon LIEN KE
            //   (array.get(aptRv2, i + 1) - aptTfName sap xep TANG DAN tu 1m
            //   den 2h nen phan tu ke tiep chinh la khung cao hon lien ke,
            //   dung Y HET cach _w1UdIdx/_w1UdIdx+1 ben MQL5): RV2(khung nay)
            //   > RV2(khung cao hon lien ke) -> tam giac HUONG LEN "▲"; con
            //   lai -> tam giac HUONG XUONG "▼"; khung cao nhat (2h, khong co
            //   khung cao hon) hoac thieu du lieu -> de trong "", KHONG doan
            //   huong. <sigbrk> dung LAI DUNG bien brkVal da tinh SAN o dau
            //   vong lap nay (brk% - y het WrvBuildBrkStr(), KHONG tinh lai
            //   cong thuc nao khac): brk >= 110 -> "▲"; brk <= -10 -> "▼"; con
            //   lai (giua hai nguong) hoac brkVal la na -> MOT dau cach " "
            //   (khop [SUA RV1-WPR1COL-SIGBRK-SPC-01] ben MQL5). KHONG tao/xoa
            //   object nao, KHONG ve them duong line nao, KHONG doi
            //   setting/input nao.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] <DiffRv2>
            // (sDiffRv2) da CAT KHOI cot WPR1COL - dinh dang MOI (xem khoi
            // txtWpr1Col ben duoi) KHONG con <DiffRv2> nua, khop CHINH XAC
            // dinh dang cuoi cung cua cot WPR1COL ben MQL5 sau [SUA
            // WPR1COL-RV1RV2-01] (<DiffRv2> o do da CHUYEN VE nhan RV2, ben
            // trong cum ngoac vuong dung Up/Dn - Pine KHONG co du lieu Up/Dn
            // nen KHONG the dung cum ngoac vuong tuong duong o nhan RV2, xem
            // ghi chu tai khoi txtRv2 o tren). sDiffRv2 GIU NGUYEN dong tinh
            // (KHONG xoa) du tu nay khong con noi nao doc lai - dung theo yeu
            // cau khong bo sot code goc.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] <sigbrk> cua CHINH
            // cot WPR1COL doc theo brkD (khi co) thay vi brk% - khop [SUA BRKW1-01]
            // ben MQL5, noi khoi _w1SigBrk duoc dat NGAY SAU cho ghi de _w1BrkStr.
            // Hai nguong 110 / -10 GIU NGUYEN, chi doi y nghia thanh "pha dinh /
            // thung day KENH" thay vi "1 nen". <sigbrk> cua cot Pivot (sSigBrkPiv
            // o tren) KHONG doi - ben MQL5 no lay tu brk1Str/BrkTextForTF() van la
            // brk 1 nen.
            string sSigBrk = na(brkDVal) ? (na(brkVal) ? " " : brkVal >= 110.0 ? "▲" : brkVal <= -10.0 ? "▼" : " ") : brkDVal >= 110.0 ? "▲" : brkDVal <= -10.0 ? "▼" : " "
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Dinh dang MOI
            // NHAT cua cot WPR1COL, khop CHINH XAC ban cuoi cung cua _w1Txt ben
            // AutoPositionTool_UI.mq5 (sau [SUA WPR1COL-ADDBIDDIFF-01]/[SUA
            // WPR1COL-ADDBIDDIFF-02]/[SUA WPR1COL-REORDER-01]/[SUA
            // WPR1COL-REORDER-02]):
            //   "<TF> <TenMuc> <RSI>/<±dRSI> <diffpv> ( <diffrv2>/ <diffrv1>) <sigbrk> <brk%> {dWPR1}/{WPR1}/{MA1} {dWPR2}/{WPR2}/{MA2}"
            // - <TenMuc> <RSI>/<±dRSI> (sNearLvl/sNearRsi/sNearDlt) va <diffpv>
            //   (sDiffPv) doi len DAU (ngay sau <TF>), thay vi cuoi cung nhu ban
            //   truoc - KHONG doi cach tinh.
            // - <diffrv2>/<diffrv1> (cap MOI, boc trong MOT cap ngoac don voi
            //   dau cach ngay sau "(") la "Bid - RV2"/"Bid - RV1" cua CHINH
            //   khung dang xet - Pine KHONG can them bo dem/cache rieng nhu
            //   g_rv2DiffCache[]/g_rv1DiffCache[] ben MQL5 vi da co SAN hai bien
            //   diffRv2/diffRv1 (dong "float diffRv1 = na(rvL) ? na : bid - rvL"
            //   / "float diffRv2 = na(rv2) ? na : bid - rv2" o dau vong lap) va
            //   chuoi da FORMAT san cua chung, sRv2Df/sDiff1 (dung CHINH cho
            //   nhan Pivot o (1)) - dung LAI TRUC TIEP, KHONG tinh/khai bao bien
            //   moi nao khac.
            // - <sigbrk> (sSigBrk) va <brk%> (sBrk) doi vi tri xuong SAU cap
            //   ngoac don <diffrv2>/<diffrv1>, KHONG con dan LIEN ngay sau <TF>
            //   nua - GIU NGUYEN cach tinh.
            // - {dWPR1}/{WPR1}/{MA1} (tripleRv1c) va {dWPR2}/{WPR2}/{MA2}
            //   (tripleRv2c) GIU NGUYEN vi tri cuoi cung va cach tinh.
            // - Nhanh "thieu du lieu" (tripleRv2c == "") GIU NGUYEN dung
            //   "<TF><sigbrk>" (sigbrk dan LIEN ngay sau TF, khong dau cach) -
            //   khop nhanh else cua _w1Txt ben MQL5.
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG
            // doi input/setting nao.
            // [CAP NHAT THEO YEU CAU] Doi lai thu tu + bo cap ngoac don cua
            //   <diffrv2>/<diffrv1>: cap nay doi len NGAY SAU <TF> (thay vi
            //   dung sau <diffpv>/truoc <sigbrk> nhu ban truoc), va KHONG con
            //   boc trong "( ... )" nua. <TenMuc> <RSI>/<±dRSI> <diffpv> dich
            //   xuong SAU cap <diffrv2>/<diffrv1>. <diffpv> va <sigbrk> gio
            //   dan LIEN nhau (khong dau cach). Cac phan con lai
            //   (<brk%> {dWPR1}/{WPR1}/{MA1} {dWPR2}/{WPR2}/{MA2}) GIU NGUYEN
            //   vi tri cuoi cung va cach tinh. Nhanh "thieu du lieu" GIU
            //   NGUYEN "<TF><sigbrk>" nhu cu.
            //   Dinh dang moi:
            //   "<TF>  <diffrv2>/ <diffrv1> <TenMuc> <RSI>/<±dRSI> <diffpv><sigbrk> <brk%> {dWPR1}/{WPR1}/{MA1} {dWPR2}/{WPR2}/{MA2}"
            // [CAP NHAT THEO YEU CAU] Doi dinh dang cot WPR1COL sang:
            //   "<TF>  {dWPR1}/{WPR1}/{MA1}  <diffrv1><TenMuc> <RSI>/<±dRSI>
            //   <diffpv> <sigbrk> <brk%> <diffrv2>  {dWPR2}/{WPR2}/{MA2}"
            //   Ba thay doi so voi ban truoc (dong ngay duoi):
            //     1) Bo ba {dWPR1}/{WPR1}/{MA1} (tripleRv1c) CHUYEN tu CUOI
            //        hang LEN NGAY SAU <TF>, cach <TF> HAI dau cach, roi HAI
            //        dau cach nua truoc <diffrv1> (sDiff1) - <diffrv1> van dan
            //        LIEN NGAY VAO <TenMuc> (sNearLvl), khong dau cach o diem
            //        noi, dung Y HET quy uoc noi cu.
            //     2) <diffrv2> (sRv2Df) BO dau "/ " dang dan no voi <diffrv1>,
            //        CHUYEN xuong SAU <brk%> (sBrk), dan LIEN bang MOT dau
            //        cach nhu cac truong khac, KHONG con dinh vao sDiff1.
            //     3) <diffpv> (sDiffPv) va <sigbrk> (sSigBrk) tach RIENG bang
            //        MOT dau cach (truoc day dan LIEN nhau khong dau cach).
            //   KHONG doi cach tinh bat ky truong nao (tfn/tripleRv1c/
            //   tripleRv2c/sDiff1/sNearLvl/sNearRsi/sNearDlt/sDiffPv/sSigBrk/
            //   sBrk/sRv2Df), KHONG doi nhanh "thieu du lieu" (van
            //   "<TF><sigbrk>" nhu cu). KHONG tao/xoa label nao, KHONG ve them
            //   duong line nao, KHONG doi input/setting nao.
            // [CAP NHAT THEO YEU CAU] Doi dinh dang cot WPR1COL sang - khop
            //   CHINH XAC ban cuoi cung cua _w1Txt ben AutoPositionTool_UI.mq5
            //   (sau [SUA WPR1COL-REORDER-08]/[SUA WPR1COL-REORDER-09]):
            //   "<TF>  {dWPR1}/{WPR1}/{MA1}  <diffrv1><sigbrk> <brk><TenMuc>
            //   <RSI>/<±dRSI> <diffpv> <diffrv2> {dWPR2}/{WPR2}/{MA2}"
            //   Hai thay doi so voi ban truoc:
            //     1) <sigbrk> (sSigBrk) va <brk%> (sBrk): ca hai CHUYEN LEN,
            //        xen giua <diffrv1> (sDiff1) va <TenMuc> (sNearLvl) -
            //        <sigbrk> dan LIEN NGAY SAU <diffrv1> (khong dau cach o
            //        diem noi, dung Y HET quy uoc cu), roi MOT dau cach, roi
            //        <brk%>, roi <TenMuc> dan LIEN NGAY SAU <brk%> (khong dau
            //        cach o diem noi, dung Y HET quy uoc <brk%> tung dan lien
            //        vao bo ba WPR1).
            //     2) Dau cach GIUA <diffpv> (sDiffPv) va <diffrv2> (sRv2Df), va
            //        GIUA <diffrv2> va bo ba {dWPR2}/{WPR2}/{MA2} (tripleRv2c):
            //        ca hai tu HAI dau cach lien tuc xuong con MOT dau cach.
            //   KHONG doi cach tinh bat ky truong nao (tfn/tripleRv1c/
            //   tripleRv2c/sDiff1/sNearLvl/sNearRsi/sNearDlt/sDiffPv/sSigBrk/
            //   sBrk/sRv2Df), KHONG doi nhanh "thieu du lieu" (van
            //   "<TF><sigbrk>" nhu cu). KHONG tao/xoa label nao, KHONG ve them
            //   duong line nao, KHONG doi input/setting nao.
            // [CAP NHAT THEO YEU CAU] Doi dinh dang cot WPR1COL sang - khop
            //   CHINH XAC ban cuoi cung cua _w1Txt ben AutoPositionTool_UI.mq5
            //   (sau [SUA WPR1COL-REORDER-10]):
            //   "<TF>  {dWPR1}/{WPR1}/{MA1}  <diffrv1><sigbrk> <brk><diffpv>
            //   <TenMuc> <RSI>/<±dRSI>  <diffrv2> {dWPR2}/{WPR2}/{MA2}"
            //   Doi cho <diffpv> (sDiffPv) va <TenMuc> <RSI>/<±dRSI>
            //   (sNearLvl/sNearRsi/sNearDlt): <diffpv> CHUYEN LEN TRUOC, dan
            //   LIEN NGAY SAU <brk> (sBrk, khong dau cach o diem noi, dung Y
            //   HET quy uoc <brk> tung dan lien vao bo ba WPR1), roi <TenMuc>
            //   dan LIEN NGAY SAU <diffpv> (khong dau cach o diem noi). Dau
            //   cach SAU cum <TenMuc> <RSI>/<±dRSI> (truoc <diffrv2>) tang tu
            //   MOT len HAI dau cach lien tuc (dung Y HET hai dau cach dang
            //   dung giua <TF>/bo ba WPR1 va giua bo ba WPR1/<diffrv1>). Dau
            //   cach GIUA <diffrv2> va bo ba {dWPR2}/{WPR2}/{MA2} GIU NGUYEN
            //   MOT dau cach (khong doi). KHONG doi cach tinh bat ky truong
            //   nao (tfn/tripleRv1c/tripleRv2c/sDiff1/sNearLvl/sNearRsi/
            //   sNearDlt/sDiffPv/sSigBrk/sBrk/sRv2Df), KHONG doi nhanh "thieu
            //   du lieu" (van "<TF><sigbrk>" nhu cu). KHONG tao/xoa label
            //   nao, KHONG ve them duong line nao, KHONG doi input/setting
            //   nao.
            // [CAP NHAT THEO YEU CAU] Doi dinh dang cot WPR1COL sang - khop
            //   CHINH XAC ban cuoi cung cua _w1Txt ben AutoPositionTool_UI.mq5
            //   (sau [SUA WPR1COL-REORDER-15]):
            //   "<TF> <brk><sigbrk>{dWPR1}/{WPR1}/{MA1}  <diffrv1><TenMuc>
            //   {<diffpv> <RSI>/<±dRSI>}  <diffrv2> {dWPR2}/{WPR2}/{MA2}"
            //   Nam thay doi so voi ban truoc (dong ngay duoi), gop chung
            //   thanh MOT lan cap nhat (Pine KHONG the tach nhieu buoc trung
            //   gian nhu ben MQL5 vi Pine khong cho ngat dong giua mot bieu
            //   thuc):
            //     1) <brk><sigbrk> (sBrk + sSigBrk): CHUYEN LEN DAU, dan
            //        LIEN NGAY SAU <TF> (MOT dau cach truoc no, GIAM tu HAI
            //        dau cach cua ban truoc), roi dan LIEN NGAY TRUOC bo ba
            //        {dWPR1}/{WPR1}/{MA1} (khong dau cach o hai diem noi).
            //     2) <diffrv1> (sDiff1) tu nay KHONG con <sigbrk> dan theo
            //        sau no nua (da chuyen len dau) - GIU NGUYEN dan LIEN
            //        NGAY VAO <TenMuc> (sNearLvl) sau no, khong dau cach o
            //        diem noi (dung Y HET quy uoc noi cu).
            //     3) <diffpv> (sDiffPv) va cum <RSI>/<±dRSI> (sNearRsi +
            //        "/" + sNearDlt) - CUNG voi MOT dau cach GIUA hai truong
            //        nay - duoc BOC vao TRONG mot cap ngoac nhon "{ }": dau
            //        "{" dan LIEN NGAY SAU <TenMuc> qua MOT dau cach (dung
            //        vi tri dau cach <diffpv> tung dung truc tiep sau
            //        <TenMuc>), dau "}" dan LIEN NGAY SAU <±dRSI>, truoc HAI
            //        dau cach dan sang <diffrv2> (sRv2Df).
            //   Phan con lai (<TF>/bo ba WPR1/<diffrv2>/bo ba WPR2 va
            //   khoang cach quanh chung) GIU NGUYEN vi tri cuoi cung va cach
            //   tinh. Nhanh "thieu du lieu" GIU NGUYEN "<TF><sigbrk>" nhu
            //   cu. Khac MQL5 (noi <TenMuc> va <RSI5>/<diff> von la MOT
            //   chuoi lien tu AptS1RsiTextForTF() nen phai tach bang
            //   StringFind/StringSubstr): ben Pine, sNearLvl (<TenMuc>) va
            //   sNearRsi/sNearDlt (<RSI>/<±dRSI>) VON DA la CAC BIEN RIENG
            //   BIET tu truoc gio - CHI can doi thu tu ghep chuoi, KHONG can
            //   tach/them bien moi nao. KHONG doi cach tinh bat ky truong
            //   nao (tfn/tripleRv1c/tripleRv2c/sDiff1/sNearLvl/sNearRsi/
            //   sNearDlt/sDiffPv/sSigBrk/sBrk/sRv2Df), KHONG doi nhanh
            //   "thieu du lieu" (van "<TF><sigbrk>" nhu cu). KHONG tao/xoa
            //   label nao, KHONG ve them duong line nao, KHONG doi
            //   input/setting nao.
            // [CAP NHAT LAM2RV1-PINE-01 - THEO YEU CAU] Khoi tinh sLamStr/sPushStr (<Lambda><▲▼>) da CAT CHUYEN len truoc dong ghep txtRv1 o (2) COT NHAN RV1 (Pine bat buoc khai bao truoc khi dung).
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] THEM <diffV1V2>
            // vao cot WPR1COL - khop cac ban [SUA WPR1COL-ADDDIFFV1V2-01]..
            // [SUA WPR1COL-ADDDIFFV1V2-07] ben AutoPositionTool_UI.mq5, gop
            // chung thanh MOT lan cap nhat (Pine khong the tach nhieu buoc
            // trung gian nhu ben MQL5 vi Pine khong cho ngat dong giua mot
            // bieu thuc). KHONG tinh lai RV1/RV2 rieng cho cot nay: dung
            // THANG sDiffV1V2 (f_diffV1V2Str(rvL, aptRvS, rv2, aptRv2S, i))
            // da tinh san o tren cho nhan Pivot (xem khoi "[CAP NHAT THEO BAN
            // MQL5 MOI NHAT - THEO YEU CAU] <diffV1V2>" canh dong khai bao
            // sDiffV1V2) - CUNG mot gia tri RV1(tf nay)/RV2(tf nay), CUNG
            // vong lap "for i", KHONG can/KHONG duoc tinh lai lan hai. Bon
            // thay doi trong txtWpr1Col so voi ban truoc (dong ngay duoi):
            //   1) <diffV1V2> (sDiffV1V2) CHEN vao NGAY SAU <lam> (sLamStr),
            //      dan bang dau "/" - KHONG dau cach o diem noi. sLamStr
            //      (khi tinh duoc) tu no da ket thuc bang MOT dau cach
            //      (xem khoi tinh sLamStr ngay tren, KHONG doi cach tinh) nen
            //      can CAT bo dung MOT dau cach cuoi TRUOC KHI noi dau "/"
            //      vao, dung bien rieng sLamStrNoSpc CHI dung tai diem noi
            //      nay (giong Y HET cach _w1LamStrNoSpc ben MQL5 cat khoang
            //      trang ma khong dong den ham/cach tinh sLamStr goc).
            //   2) Dau cach giua <TenMuc> (sNearLvl) va dau "{" mo cap
            //      {<diffpv> <RSI>/<±dRSI>}: BO, dau "{" nay gio dan LIEN
            //      NGAY sau <TenMuc>.
            //   3) <diffrv2> (sRv2Df): dan LIEN NGAY sau dau "}" dong cap
            //      (khong dau cach o diem noi, HAI dau cach cu truoc no BO
            //      het), roi MOT dau cach, roi moi den bo ba
            //      {dWPR2}/{WPR2}/{MA2} (tripleRv2c).
            //   Gia tri/cach tinh cua tat ca cac truong khac (tfn/sBrk/
            //   sSigBrk/sLamStr/tripleRv1c/sDiff1/sNearLvl/sDiffPv/sNearRsi/
            //   sNearDlt/sRv2Df/tripleRv2c) va nhanh "thieu du lieu"
            //   (tfn + sSigBrk) KHONG doi mot chu so nao. KHONG tao/xoa
            //   label nao, KHONG ve them duong line nao, KHONG doi
            //   input/setting nao.
            // [CAP NHAT WPR1COL-FMT-FINAL-01 - THEO YEU CAU] Doi dinh dang cot
            // WPR1COL sang khop CHINH XAC ban cuoi cung ben
            // AutoPositionTool_UI.mq5 (gop lai thanh MOT lan cap nhat, Pine
            // khong the tach nhieu buoc trung gian nhu ben MQL5):
            //   1) BO <diffV1V2> (sDiffV1V2) ra khoi vi tri ngay sau <push> -
            //      thay vao do la <brk><sigbrk> (sBrk/sSigBrk), dan LIEN nhau,
            //      dan LIEN NGAY SAU <push>, roi dan LIEN NGAY TRUOC bo ba
            //      {dWPR1}/{WPR1}/{MA1} (tripleRv1c) - bon truong nay
            //      (<push><brk><sigbrk>{dWPR1}/{WPR1}/{MA1}) dan LIEN nhau
            //      hoan toan, khong dau cach nao xen giua.
            //   2) <TenMuc> (sNearLvl) CHUYEN RA TRUOC dau "{" mo cap ngoac
            //      nhon, dan LIEN NGAY SAU MOT dau cach sau bo ba
            //      {dWPR1}/{WPR1}/{MA1}.
            //   3) BEN TRONG cap ngoac nhon: <diffpv> (sDiffPv) noi voi
            //      <diffrv1> (sDiff1) qua MOT dau "/" (khong dau cach), roi
            //      MOT dau cach, roi <diffV1V2> (sDiffV1V2, DUNG LAI CHINH
            //      bien da tinh san o (1) phia tren cho nhan Pivot - KHONG
            //      tinh lai), roi MOT dau cach, roi <RSI5>/<diff> (sNearRsi +
            //      "/" + sNearDlt), roi MOT dau cach, roi <+/-diffRSI>
            //      (truong MOI, xem sPivRsiDiffStr ngay duoi), roi dau "}"
            //      dong cap.
            //   4) <+/-diffRSI> (sPivRsiDiffStr) la gia tri RSI-diff CUA
            //      CHINH muc Pivot dang chon (khop g_pivotRsiDiffCache/
            //      _w1PivRsiDiffStr ben MQL5): ben Pine gia tri nay CHINH la
            //      pivDlt da tinh san o (1) phia tren (canh dong khai bao
            //      sPivBase, xem chu thich "<+/-diffRSI> cua nhan Pivot") -
            //      DUNG LAI THANG bien do, KHONG tinh lai, chi dinh dang lai
            //      thanh chuoi co dau +/- tuong minh (0 chu so thap phan,
            //      khop cach DrawEmaSeries() ben MQL5 dang in <+/-diffRSI>).
            //      Thieu du lieu (pivDlt la na) -> "-", khong doan gia tri.
            //   Gia tri/cach tinh cua TAT CA cac truong khac (tfn/sBrk/
            //   sSigBrk/sLamStrNoSpc/sPushStr/tripleRv1c/sDiff1/sNearLvl/
            //   sDiffPv/sDiffV1V2/sNearRsi/sNearDlt/sRv2Df/tripleRv2c/pivDlt)
            //   va nhanh "thieu du lieu" (tfn + sSigBrk) KHONG doi mot chu so
            //   nao. Dinh dang MOI cua cot WPR1COL:
            //     "<TF> <lam><push><brk><sigbrk>{dWPR1}/{WPR1}/{MA1}
            //     <TenMuc>{<diffpv>/<diffrv1> <diffV1V2> <RSI5>/<diff>
            //     <+/-diffRSI>}<diffrv2> {dWPR2}/{WPR2}/{MA2}"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao da co.
            // [CAP NHAT WPR1COL-FMT-FINAL-02 - THEO YEU CAU] Doi dinh dang cot
            // WPR1COL sang khop CHINH XAC ban cuoi cung ben
            // AutoPositionTool_UI.mq5 (gop cac ban [SUA WPR1COL-SWAPRV1V2-01]/
            // [SUA WPR1COL-DUPBRKSIGBRK-01]/[SUA WPR1COL-DELOUTERBRK-01] thanh
            // MOT lan cap nhat, Pine khong the tach nhieu buoc trung gian nhu
            // ben MQL5):
            //   1) BO ban <brk><sigbrk> (sBrk/sSigBrk) dang dan LIEN sau
            //      <push>, TRUOC bo ba {dWPR1}/{WPR1}/{MA1} - <push> tu nay
            //      dan LIEN THANG vao bo ba, khong con gi xen giua.
            //   2) THEM LAI <brk><sigbrk> (CHINH HAI bien do, KHONG tinh lai)
            //      vao BEN TRONG cap ngoac nhon, dan LIEN NGAY SAU dau "{" mo
            //      cap va dan LIEN NGAY TRUOC <diffpv> (khong dau cach o ca ba
            //      diem noi: "{"<brk><sigbrk><diffpv>).
            //   3) DAO CHO <diffrv1> (sDiff1) va <diffV1V2> (sDiffV1V2) BEN
            //      TRONG cap ngoac nhon: <diffV1V2> tu nay noi voi <diffpv>
            //      qua dau "/" (thay cho <diffrv1> tung noi truoc day), roi
            //      MOT dau cach, roi moi den <diffrv1> (thay cho <diffV1V2>
            //      tung dung vi tri nay), roi MOT dau cach, roi <RSI5>/<diff>.
            //   Gia tri/cach tinh cua TAT CA cac truong (tfn/sBrk/sSigBrk/
            //   sLamStrNoSpc/sPushStr/tripleRv1c/sDiff1/sNearLvl/sDiffPv/
            //   sDiffV1V2/sNearRsi/sNearDlt/sPivRsiDiffStr/sRv2Df/tripleRv2c)
            //   va nhanh "thieu du lieu" (tfn + sSigBrk) KHONG doi mot chu so
            //   nao - CHI doi VI TRI ghep cac bien nay trong chuoi. Dinh dang
            //   MOI cua cot WPR1COL:
            //     "<TF> <lam><push>{dWPR1}/{WPR1}/{MA1}
            //     <TenMuc>{<brk><sigbrk><diffpv>/<diffV1V2> <diffrv1>
            //     <RSI5>/<diff> <+/-diffRSI>}<diffrv2> {dWPR2}/{WPR2}/{MA2}"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao da co.
            // [CAP NHAT WPR1COL-FMT-FINAL-03 - THEO YEU CAU] Doi dinh dang cot
            // WPR1COL sang khop CHINH XAC ban cuoi cung ben AutoPositionTool_UI.mq5
            // (khop [SUA WPR1COL-REORDER-16] ben MQL5):
            //   1) CAT <diffV1V2> (sDiffV1V2) ra KHOI BEN TRONG cap ngoac nhon
            //      (truoc day dan LIEN sau <diffpv> qua dau "/"), dan LIEN NGAY
            //      SAU bo ba {dWPR1}/{WPR1}/{MA1} (tripleRv1c) qua dau "/" (khong
            //      dau cach).
            //   2) CAT <diffrv1> (sDiff1) ra KHOI BEN TRONG cap ngoac nhon (truoc
            //      day dan sau <diffV1V2>), dan ra NGOAI ngoac nhon, dung ngay
            //      SAU <diffV1V2> (mot dau cach), TRUOC <TenMuc> (mot dau cach).
            //   3) Cap ngoac nhon tu nay CHI con lai <brk><sigbrk><diffpv>
            //      <RSI5>/<diff> - BO rieng <+/-diffRSI> (sPivRsiDiffStr) ra
            //      khoi chuoi hien thi; dong khai bao/tinh sPivRsiDiffStr o tren
            //      VAN GIU NGUYEN, KHONG xoa, chi tu nay KHONG con noi nao doc
            //      lai gia tri trong txtWpr1Col.
            //   4) Bo ba {dWPR2}/{WPR2}/{MA2} (tripleRv2c) dan LIEN NGAY SAU dau
            //      "}" dong cap ngoac (khong dau cach), roi mot dau cach, roi
            //      <diffrv2> (sRv2Df) doi cho ra CUOI CUNG chuoi (truoc day dan
            //      ngay sau dau "}", gio doi xuong sau bo ba WPR2).
            //   Gia tri/cach tinh cua TAT CA cac truong (tfn/sLamStrNoSpc/
            //   sPushStr/tripleRv1c/sDiffV1V2/sDiff1/sNearLvl/sBrk/sSigBrk/
            //   sDiffPv/sNearRsi/sNearDlt/sPivRsiDiffStr/sRv2Df/tripleRv2c) va
            //   nhanh "thieu du lieu" (tfn + sSigBrk) KHONG doi mot chu so nao -
            //   CHI doi VI TRI ghep cac bien nay trong chuoi va bo bot MOT
            //   truong (<+/-diffRSI>) khoi chuoi hien thi. Dinh dang MOI cua
            //   cot WPR1COL:
            //     "<TF> <lam><push>{dWPR1}/{WPR1}/{MA1}/<diffV1V2>
            //     <diffrv1> <TenMuc>{<brk><sigbrk><diffpv> <RSI5>/<diff>}
            //     {dWPR2}/{WPR2}/{MA2} <diffrv2>"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao da co.
            // [CAP NHAT LAM2RV1-PINE-01] sLamStrNoSpc da CAT CHUYEN len truoc dong ghep txtRv1.
            // [CAP NHAT WPR1COL-FMT-FINAL-04 - THEO YEU CAU] CAT cum
            // "{dWPR1}/{WPR1}/{MA1}/<diffV1V2> <diffrv1> {dWPR2}/{WPR2}/{MA2}
            // <diffrv2>" (tripleRv1c + "/" + sDiffV1V2 + " " + sDiff1, roi
            // tripleRv2c + " " + sRv2Df) RA KHOI cot WPR1COL, CHUYEN VE nhan RV2
            // (xem khoi "[CAP NHAT RV2LBL-ADDWPRDIFF-01]" o (3) phia tren, CUNG
            // vong lap khung nay) - khop [SUA WPR1COL-RV1RV2-02] ben
            // AutoPositionTool_UI.mq5. <push> (sPushStr) tu nay dan LIEN THANG
            // vao <TenMuc> (sNearLvl), khong con gi xen giua. Nam bien
            // tripleRv1c/sDiffV1V2/sDiff1/tripleRv2c/sRv2Df va cach tinh cua
            // tung bien GIU NGUYEN dong khai bao/tinh o dau vong lap "for i"
            // (xem (1)), KHONG xoa mot dong nao - CHI khong con noi nao trong
            // cot WPR1COL doc lai chung nua. KHONG doi dieu kien tripleRv2c !=
            // "" hay nhanh "thieu du lieu" (tfn + sSigBrk), vi tripleRv2c van
            // con tinh binh thuong, chi khong con in ra. Dinh dang MOI cua cot
            // WPR1COL:
            //   "<TF> <lam><push><TenMuc>{<brk><sigbrk><diffpv> <RSI5>/<diff>}"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao da co.
            // [CAP NHAT RV1LBL-ADDTENMUCRSI-01 - THEO YEU CAU] Doi dinh dang cot
            // WPR1COL sang: "<TF> <lam><push>". CAT cum "<TenMuc>
            // {<brk><sigbrk><diffpv> <RSI5>/<diff>}" ra KHOI chuoi hien thi -
            // tuc sau bien sNearLvl/sBrk/sSigBrk/sDiffPv/sNearRsi/sNearDlt va
            // cap dau "{" "}" khong con in ra o day nua, cum nay CHUYEN VE
            // nhan RV1 (xem khoi "[CAP NHAT RV1LBL-ADDTENMUCRSI-01]" o (2)
            // phia tren, CUNG vong lap khung nay) - khop [SUA
            // WPR1COL-DROPBRKBLOCK-01] ben AutoPositionTool_UI.mq5. Cac bien
            // sNearLvl/sNearRsi/sNearDlt/sBrk/sSigBrk/sDiffPv va cach tinh cua
            // tung bien VAN GIU NGUYEN dong khai bao o dau vong lap "for i"
            // (KHONG xoa, KHONG doi cach tinh) - CHI la tu day khong con noi
            // nao trong txtWpr1Col doc lai chung nua. KHONG doi dieu kien
            // tripleRv2c != "" hay nhanh "thieu du lieu" (tfn + sSigBrk).
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao da co.
            // [BO SUNG - THEO YEU CAU] Tin hieu Climax ("MAX T"/"MAX G"/"WAIT",
            // xem f_climaxStateForTF() o dau file) cua CHINH khung i nay - NOI
            // vao CUOI CUNG cot WPR1COL, vi du dinh dang cuoi cung
            // "15m L+0.28▼ MAX G", khop ban cuoi cung cua cot WPR1COL ben
            // AutoPositionTool_UI.mq5 (MQL5) sau khi da CAT tin hieu Climax tu
            // cot nhan "Pattern + Asym" (aptLbPat, xem muc (6) ben duoi) CHUYEN
            // VE day. Dung DUNG cap i/tfOpenNow/tfCloseNow cua CHINH khung i
            // nay (i/array.get(aptCurO, i)/close) - [SUA WPR1COL-CLIMAX-
            // REALHIST-01] doi tham so dau tu array.get(aptNb,i) sang THANG i
            // vi f_climaxStateForTF() ban moi doc lich su rieng qua
            // aptClimaxRvS[i][] (xem khoi khai bao gan f_previewPivRsi ben
            // duoi), KHONG can nB nua. Noi o CA HAI nhanh (co/khong co
            // tripleRv2c) vi f_climaxStateForTF() tinh DOC LAP tren RV1(tf),
            // khong phu thuoc tripleRv2c/sLamStr/sPushStr o tren. KHONG
            // tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao da co.
            // [CAP NHAT LAM2RV1-PINE-01 - THEO YEU CAU] CAT <Lambda><▲▼> (sLamStrNoSpc/sPushStr) ra KHOI cot WPR1COL, CHUYEN VE nhan RV1. Nhanh "thieu du lieu" (tfn + sSigBrk) GIU NGUYEN. Dinh dang MOI: "<TF> <Climax>" / "<TF><SigBrk> <Climax>"
            // [SUA MQL5SYNC-01 - THEO YEU CAU] Khop WPR1COL MQL5 moi (bo cap
            //   <UpB>/<DnB> dau cum vi la bo dem giay; climaxState van tinh
            //   nhung MQL5 moi khong con noi vao):
            //   "<TF> {<RSI>/<±dRSI><TenMuc> <diffpv>/<diffpv2>|<V1V2>}<sigbrk><brk><SpR><L±x.xx><push> <±pct>% <thoi gian>"
            // [CAP NHAT WPR1COL-ADDRSI5DIFF-01 - THEO YEU CAU] Noi THEM truong
            // <RSI5> / <+/-diffRSI> vao cot WPR1COL, ngay SAU <Climax>, cach MOT
            // dau cach - khop [SUA WPR1COL-ADDRSI5DIFF-01] ben
            // AutoPositionTool_UI.mq5 (dinh dang MQL5: "15m L+0.28▼ MAX G 48 / +10").
            // CHI dung LAI hai bien DA CO SAN trong CUNG vong lap "for i":
            // pivRsi (RSI5 cua nhan Pivot, song theo tick qua f_previewPivRsi())
            // va sPivRsiDiffStr (<+/-diffRSI> tu pivDlt, khai bao o tren) -
            // KHONG tinh lai, KHONG dinh nghia cong thuc moi. Thieu du lieu
            // (pivRsi = na) -> "-", dung quy uoc "-" cua MQL5. Noi o CA HAI
            // nhanh (co/khong co tripleRv2c), giong <Climax>. Cum
            // <sigbrk><brkD>(<streak>)<SpRatio> ben duoi GIU NGUYEN, van noi
            // sau cung. KHONG tao/xoa label nao, KHONG ve them duong line nao,
            // KHONG doi input/setting nao da co.
            // [SUA WPR1COL-NEWFMT-PINE-01 - THEO YEU CAU] Dinh dang MOI: <TF>[ L+-x.xx<Push>] <Climax>
            // BO <PivRSI> / <PivDelta> khoi nhan (bien sWpr1ColRsiDiff giu nguyen, chi khong noi nua).
            // [CAP NHAT RV1-TENMUC2WPR1COL-01 - THEO YEU CAU] Noi THEM cum
            // "<TenMuc> <RSI>/<Δ>" CAT tu nhan RV1 (xem khoi cung ten o (2)
            // phia tren) ve day, ngay SAU <RSI5> / <+/-diffRSI> va TRUOC cum
            // <sigbrk><brkD>(<streak>)<SpRatio>, cach MOT dau cach - khop [SUA
            // RV1-TENMUC2WPR1COL-01] ben AutoPositionTool_UI.mq5. Dung LAI
            // DUNG ba bien sNearLvl/sNearRsi/sNearDlt da tinh san o dau vong
            // lap "for i", ghep Y HET cach nhan RV1 tung ghep - KHONG tinh lai.
            // Cap <Up>/<Dn> ben MQL5 KHONG them vao day vi Pine KHONG co bo dem
            // Up/Dn (da bo tu truoc, xem ghi chu khoi varip dau file). Noi o CA
            // HAI nhanh (co/khong co tripleRv2c), giong <Climax>. Dinh dang MOI
            // cua cot WPR1COL:
            //   "<TF> <lam><push> <Climax> <RSI5> / <+/-diffRSI> <TenMuc> <RSI>/<Δ> <sigbrk><brkD>(<streak>)<SpRatio>"
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG doi
            // input/setting nao da co.
            // [SUA WPR1COL-NEWFMT-PINE-01] BO <TenMuc> <RSI>/<dRSI> khoi nhan (chuyen sang nhan RV1).
            // [CAP NHAT WPR1COL-ADDSIGBRKSP-01 - THEO YEU CAU] Noi THEM cum
            // <sigbrk><brkD>(<streak>)<SpRatio> vao CUOI CUNG moi hang cot
            // WPR1COL, ngay SAU <Climax>, cach MOT dau cach - khop [SUA
            // WPR1COL-ADDSIGBRKSP-01] ben AutoPositionTool_UI.mq5. Ba truong
            // dan LIEN nhau, Y HET phan dau cap ngoac nhon cua nhan RV1 (txtRv1
            // o (2) phia tren, CUNG vong lap khung nay) va dung LAI DUNG ba bien
            // da tinh san o do - KHONG tinh lai, KHONG dinh nghia cong thuc moi:
            //   <sigbrk>         = sSigBrkRv1Lbl (uu tien brkDVal, du phong brkVal:
            //                      >= 110 -> "▲", <= -10 -> "▼", con lai " ")
            //   <brkD>(<streak>) = sBrk (f_brkD()/f_brkStreak() cua CHINH khung i)
            //   <SpRatio>        = sRv1SpRatio (diffRv1 / i_asymSpreadPts, lam
            //                      tron SO NGUYEN; thieu du lieu -> "0")
            // Noi o CA HAI nhanh (co/khong co tripleRv2c), giong <Climax>. KHONG
            // doi yWpr1Col/rowClr/onWpr1Col, KHONG tao/xoa label nao, KHONG ve
            // them duong line nao, KHONG doi input/setting nao da co.
            // [SUA WPR1COL-NEWFMT-PINE-01] BO <SigBrk><Brk>(<Streak>)<SpRatio> khoi nhan.
            // [SUA RV1M1-TO-WPR1COL-01 - THEO YEU CAU] Cac hang khung cua cot WPR1COL bi DAY LEN 5 hang de nhuong cho 5 hang cum RV1 1m chen vao ben duoi (2 hang cap khung, UpD/DnD, brkD, T/L).
            // [CAP NHAT THEO YEU CAU] "and tfOnI" o cuoi: an hang cua khung
            // dang bi TAT - i_showWpr GIU NGUYEN y het truoc.
            // [CAP NHAT THEO BAN MQL5 MOI NHAT - THEO YEU CAU] Cot nay von duoc
            // thiet ke neo tren CUNG truc thoi gian voi nhan RV1 khung 1m
            // (xem chu thich dau khoi (5) o tren: "neo tren CUNG truc thoi
            // gian voi nhan RV1 khung 1m (xPiv...)"); nhan RV1 khung 1m vua
            // doi moc sang xRv1m1 (12 nen 1m tuong lai) nen cot nay doi THEO
            // dung xRv1m1 de tiep tuc thang truc voi no, khong bi lech cot.
            // [CAP NHAT THEO YEU CAU] BO TOAN BO NHAN cot WPR1COL (9 hang): KHONG con ve label nao cho cot nay.

            //──────────────────────────────────────────────────────
            // (6) COT NHAN PATTERN — [BO SUNG - THEO YEU CAU]
            //   Format: <TF> <mau hinh> <khoang cach>, 6 khung 1m..2h,
            //   1m o DUOI CUNG. Neo time = xCrl (than nen 1m), gia =
            //   high + i_patAbovePts*mintick + i*stepSafe. CHI tao OBJ
            //   label qua f_setLbl. Neu khung nay la khung nen lon
            //   (aptNb[i]==APT_BAR_NB, mac dinh 15m) thi luu toa do
            //   2 canh de ve aptPatL1/aptPatL2 SAU vong lap.
            //──────────────────────────────────────────────────────
            int nBPat = array.get(aptNb, i)
            // [CAP NHAT THEO YEU CAU] Bo qua quet mau hinh (f_patScan) khi
            // khung bi tat (chi 3h/4h/6h moi co cong tac, xem f_tfEnabled) -
            // day la khoi ton tai NANG NHAT trong toan bo script (nhieu vong
            // lap long nhau, ti le thuan voi nB), giam tai dung y yeu cau. Gia
            // tri mac dinh khi tat GIONG HET gia tri khoi tao dau ham
            // f_patScan() (name="-", bias="BOTH", conf=0.0...) nen txtPat/
            // clrPat/patBarXXX ben duoi tu dong roi ve nhanh "khong co mau
            // hinh" - KHONG doan bua. Cong thuc quet KHONG doi mot dong nao
            // khi khung dang BAT.
            [patName, patBias, patConf, patRev, patMode, patT1, patP1, patT2, patP2, patT3, patP3, patT4, patP4] = f_patScan(tfOnI, nBPat, aptAtr, bid)
            // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Tinh gia "cham" cua CHINH
            // khung nay truoc, roi truyen vao f_patTxt (khop AptPatRowText).
            float patTouch = f_patTouch(patMode, patT1, patP1, patT2, patP2, patT3, patP3, patT4, patP4, bid)
            // [BO SUNG - THEO YEU CAU] Tinh THEM <asym> (chi phi day TANG vs
            // day GIAM, f_tickPressureAsym()) cho CHINH khung nBPat cua hang
            // nay, dung chung spread co dinh i_asymSpreadPts, roi truyen vao
            // f_patTxt() de noi vao CUOI CUNG chuoi hien thi.
            // [SUA MQL5SYNC-01 - THEO YEU CAU] Khop MQL5 moi: BO <asym>, noi
            //   "<±d>/<±ty le>" (tam Volume Imbalance -> tam Value Area).
            string txtPat = f_patTxt(tfn, patName, patRev, patTouch, bid, na) + " " + f_vimbDistStr(i, imbVah, imbVal, imbOk, tfOnI)
            color clrPat = f_patClr(patBias)
            float yPat = high + i_patAbovePts * syminfo.mintick + i * stepSafe
            // [CAP NHAT THEO YEU CAU] "and tfOnI" o cuoi: an nhan cua khung
            // dang bi TAT - i_showPat GIU NGUYEN y het truoc.
            f_setLbl(aptLbPat, i, xCrl, yPat, txtPat, clrPat, i_showPat and tfOnI, label.style_label_right, text.align_right)
            // [CAP NHAT PAT-MOVE-01 - THEO YEU CAU] Noi <ten mau hinh>
            // (patName, vua CAT khoi nhan Pattern o f_patTxt() - xem khoi
            // "[CAP NHAT PAT-MOVE-01]" tai do) vao CUOI chuoi HANG 2 cua cum
            // RV1 khung 1m (aptLbRv1m2, xem khoi "[CAP NHAT BRKSCORE-
            // MOVE-01]" o (2) COT NHAN RV1) - CHI cho khung 1m (i == 0).
            // aptLbRv1m2 da duoc f_setOne() ve TRUOC trong CUNG vong lap nay
            // (patName cua khung 1m chi tinh xong DEN DAY), nen phai GHI DE
            // lai bang label.set_text() thay vi sua bien txtRv1/brk cu da
            // qua - dung LAI DUNG bien sBrkScore da co (KHONG tinh lai
            // brkScore), dung DUNG dinh dang da yeu cau: "brkD: " + sBrkScore
            // + " " + patName. Pine KHONG co bo quet nen dao chieu tuong
            // duong AptCdlScanTF ben MQL5 (xem ghi chu tai f_patTxt()) nen
            // CHI noi <ten mau hinh>, KHONG bia them cum <TenNenDaoChieu>
            // <mui ten>.
            // not na(aptLbRv1m2): label CHI ton tai khi f_setOne() da tao no
            // (dieu kien on1 and sBrkScore != "" - xem khoi ve hang 2) - goi
            // set_text tren label na se loi, nen phai kiem tra truoc.
            // patName != "-"/patName != "": dung Y HET quy uoc cu cua
            // f_patTxt() - khong tim thay mau hinh thi KHONG noi gi, hang 2
            // giu NGUYEN dang da ve ("brkD: " + sBrkScore).
            // KHONG tao/xoa label nao, KHONG ve them duong line nao, KHONG
            // doi setting/input nao.
            // [SUA MQL5SYNC-01 - THEO YEU CAU] Khop MQL5: "brkD: <score> <mau hinh><nen dao chieu><mui ten>".
            // [CAP NHAT THEO MQL5 MOI NHAT - THEO YEU CAU] CAT "<ten mau hinh><ten nen dao chieu><mui ten>" KHOI hang brkD cua cum RV1-1m,
            //   CHUYEN sang nhan RV1 (xem khoi [CAP NHAT RV1-MQL5-01] ngay duoi). Hang 2 giu dang da ve: "brkD: <score>".
            // [CAP NHAT THEO YEU CAU - PATAUTO-01] Hai che do chon khung:
            //   i_patAutoTF BAT  -> lay khung DAU TIEN (thap nhat) du dieu kien
            //   i_patAutoTF TAT  -> lay dung khung aptBarNb nhu truoc
            // Dieu kien "du dieu kien ve" o day GIONG HET bieu thuc onPatLn
            // duoi khoi ve (bo phan i_showPatLines) nen khong bao gio chot
            // trung mot khung roi lai khong ve duoc.
            bool patOkI = tfOnI and patMode >= 2 and not na(patT1) and not na(patT2) and not na(patP1) and not na(patP2)
            bool takeI = i_patAutoTF ? (patOkI and not patBarLocked) : (nBPat == aptBarNb)
            if takeI
                if i_patAutoTF
                    patBarLocked := true
                patBarBias := patBias
                patBarMode := patMode
                patBarT1 := patT1
                patBarP1 := patP1
                patBarT2 := patT2
                patBarP2 := patP2
                patBarT3 := patT3
                patBarP3 := patP3
                patBarT4 := patT4
                patBarP4 := patP4

        //──────────────────────────────────────────────────────────
        // [SUA MQL5SYNC-02 - THEO YEU CAU] (5) THAN NEN LON + CUM NHAN DUOI DAY + HH/LL/MD + OW + MOC LAM TRON
        //   = DrawBarChart() / DrawBarChartLabels() / BuildBarCurLblRows() / DrawBrkDHHLL() / DrawOwLabelsAll() / AptRndMarksDraw()
        //   cua AutoPositionTool_UI.mq5 ban hien tai. Khung than nen lon = i_barTF (aptBarIdx).
        //──────────────────────────────────────────────────────────
        float rvLive1m = array.get(aptRvLive, 0)
        // ---- Bo dem giay cong don (varip): brkScore Up/Dn, CMF Up/Dn (reset khi sang nen M5 moi), UpD/DnD (reset khi than nen lon sang nen moi) ----
        float accDt = 0.0
        if not na(aptAccLast)
            float dtX = (timenow - aptAccLast) / 1000.0
            if dtX > 0.0 and dtX < 3600.0
                accDt := dtX
        aptAccLast := timenow
        int accM5Key = int(math.floor(time / 300000.0))
        bool accM5Reset = aptAccM5Key != accM5Key
        if accM5Reset
            aptAccM5Key := accM5Key
            aptAccBrkUp := 0.0
            aptAccBrkDn := 0.0
            aptAccCmfUp := 0.0
            aptAccCmfDn := 0.0
        int accBarKey = int(math.floor((time - aptAnchorMs) / (aptBarNb * 60000.0)))
        bool accBarReset = aptAccBarKey != accBarKey
        if accBarReset
            aptAccBarKey := accBarKey
            aptAccUpD := 0.0
            aptAccDnD := 0.0
        [cmfX, vpinX, vpinDirX] = f_cmfVpin(APT_TP_NB)
        float brkD1m = f_brkD(0, i_brkDBars, bid)
        float wPct1m = f_brkW(0, i_brkDBars, bid)
        if accDt > 0.0
            if not accM5Reset
                if not na(brkScoreV)
                    if brkScoreV >= 0.6
                        aptAccBrkUp += accDt
                    else if brkScoreV <= -0.6
                        aptAccBrkDn += accDt
                if not na(cmfX)
                    if cmfX > i_rvOrdCmfTh
                        aptAccCmfUp += accDt
                    else if cmfX < -i_rvOrdCmfTh
                        aptAccCmfDn += accDt
            if not accBarReset
                if not na(brkD1m) and not na(wPct1m)
                    if wPct1m > i_updWUp and brkD1m > i_updBrkUp
                        aptAccUpD += accDt
                    else if wPct1m < i_updWDn and brkD1m < i_updBrkDn
                        aptAccDnD += accDt

        // ---- Than nen lon: nen s=0 (dang chay) tai tMid = nen 1m hien tai + BARCUR_FUTURE_BARS(1) nen chart; nen DA DONG tai giua chu ky ----
        float o15 = array.get(aptCurOLive, aptBarIdx)
        float h15 = array.get(aptCurHLive, aptBarIdx)
        float l15 = array.get(aptCurLLive, aptBarIdx)
        float c15 = bid
        bool ok15 = i_showBox15m and not na(o15) and not na(h15) and not na(l15)
        int barMs15 = time - time[1]
        if barMs15 <= 0
            barMs15 := 60000
        // do dai vach Open/Close = InpBarTickChartBars (i_box15WidthBars) NEN CUA CHART, tinh tu tam nen (khong chia doi nhu ban cu)
        int tickLen15 = barMs15 * i_box15WidthBars
        int tMidCur = time + barMs15
        if ok15
            color barClr15 = color.aqua
            if not na(tpTsf) and not na(tpLam)
                if tpTsf > 0.15 and tpLam > 0.0
                    barClr15 := i_col15Up
                else if tpTsf < -0.15 and tpLam > 0.0
                    barClr15 := i_col15Dn
            if na(aptLine15m)
                aptLine15m := line.new(tMidCur, l15, tMidCur, h15, xloc=xloc.bar_time, color=barClr15, width=2)
            else
                line.set_xy1(aptLine15m, tMidCur, l15)
                line.set_xy2(aptLine15m, tMidCur, h15)
                line.set_color(aptLine15m, barClr15)
            if na(aptLine15mOpen)
                aptLine15mOpen := line.new(tMidCur - tickLen15, o15, tMidCur, o15, xloc=xloc.bar_time, color=barClr15, width=2)
            else
                line.set_xy1(aptLine15mOpen, tMidCur - tickLen15, o15)
                line.set_xy2(aptLine15mOpen, tMidCur, o15)
                line.set_color(aptLine15mOpen, barClr15)
            if na(aptLine15mClose)
                aptLine15mClose := line.new(tMidCur, c15, tMidCur + tickLen15, c15, xloc=xloc.bar_time, color=barClr15, width=2)
            else
                line.set_xy1(aptLine15mClose, tMidCur, c15)
                line.set_xy2(aptLine15mClose, tMidCur + tickLen15, c15)
                line.set_color(aptLine15mClose, barClr15)
        else
            if not na(aptLine15m)
                line.set_color(aptLine15m, color.new(color.black, 100))
            if not na(aptLine15mOpen)
                line.set_color(aptLine15mOpen, color.new(color.black, 100))
            if not na(aptLine15mClose)
                line.set_color(aptLine15mClose, color.new(color.black, 100))
        // nen DA DONG s = 1 .. i_barCount-1 (nguon: aptHb* cua khung than nen lon) - 3 doan moi nen: Low->High, vach Open (trai), vach Close (phai) + nhan % tai dau vach Close
        int nClosedBars = array.get(aptHbCnt, aptBarIdx)
        for s = 1 to math.max(i_barCount - 1, 1)
            bool onS = i_showBox15m and s <= i_barCount - 1 and s <= nClosedBars
            float oS = onS ? f_hbGet(aptHbO, aptBarIdx, s) : na
            float hS = onS ? f_hbGet(aptHbH, aptBarIdx, s) : na
            float lS = onS ? f_hbGet(aptHbL, aptBarIdx, s) : na
            float cS = onS ? f_hbGet(aptHbC, aptBarIdx, s) : na
            float tS = onS ? f_hbGet(aptHbT, aptBarIdx, s) : na
            bool okS = onS and not na(oS) and not na(hS) and not na(lS) and not na(cS) and not na(tS)
            color clrS = cS >= oS ? i_colBarUp : i_colBarDn
            int tMidS = okS ? int(tS + aptBarNb * 30000.0) : na
            f_setLn(aptBarLn, (s - 1) * 3, tMidS, lS, tMidS, hS, clrS, okS)
            f_setLn(aptBarLn, (s - 1) * 3 + 1, okS ? tMidS - tickLen15 : na, oS, tMidS, oS, clrS, okS)
            f_setLn(aptBarLn, (s - 1) * 3 + 2, tMidS, cS, okS ? tMidS + tickLen15 : na, cS, clrS, okS)
            bool onPct = okS and i_barLblShow and i_barLblShowPct and cS != 0.0 and (i_barLblPctCount <= 0 or s < i_barLblPctCount)
            float pctS = onPct ? (hS - lS) / cS * 100.0 : na
            if not na(pctS) and cS < oS
                pctS := -pctS
            f_setLbl(aptBarPctLb, s - 1, onPct ? tMidS + tickLen15 : na, cS, na(pctS) ? "" : str.tostring(pctS, "0.00") + "%", clrS, onPct, label.style_label_left, text.align_left)

        // ---- Cum nhan duoi day than nen lon hien tai: BuildBarCurLblRows() ----
        float bcPc0 = f_bcRangePct(aptBcO, aptBcH, aptBcL, aptBcC)
        bool bcHu = aptBcHasUp
        bool bcHd = aptBcHasDn
        float bcMu = aptBcMaxUp
        float bcMd = aptBcMaxDn
        if not na(bcPc0)
            if bcPc0 >= 0.0
                if not bcHu or bcPc0 > bcMu
                    bcMu := bcPc0
                    bcHu := true
            else
                if not bcHd or bcPc0 < bcMd
                    bcMd := bcPc0
                    bcHd := true
        array<string> bcRows = array.new_string()
        if i_barLblShowPct and not na(aptBcC) and aptBcC != 0.0 and not na(aptBcH) and not na(aptBcL) and not na(aptBcO)
            float bcHlc = (aptBcH - aptBcL) / aptBcC * 100.0
            if aptBcC < aptBcO
                bcHlc := -bcHlc
            bcRows.push(str.tostring(bcHlc, "0.00") + "%")
        if i_barLblShowMaxMin
            string bcUpS = bcHu ? "+" + str.tostring(bcMu, "0.00") + "%" : "-"
            string bcDnS = bcHd ? str.tostring(bcMd, "0.00") + "%" : "-"
            bcRows.push(bcUpS)
            bcRows.push(bcDnS)
        if i_barLblShowElapsed and not na(aptBcBk)
            int bcOpenMs = aptBcBk * aptBarNb * 60000 + aptAnchorMs
            bcRows.push(f_bcElapsedStr(int((timenow - bcOpenMs) / 1000)))
        if i_barLblShowCountdown
            string bcCd = f_bcCountdown(i_barLblCdSec, i_barLblCdMaxItems, aptAnchorMs)
            if bcCd != ""
                bcRows.push(bcCd)
        // 7 hang g_bcTopTxt[]: [0] brkD, [1] TC, [2] UPDDND, [3..6] cap khung (Pine chi co 2 cap M1&M5 / M15&M30)
        array<string> bcTop = array.new_string()
        if not na(brkScoreV)
            bcTop.push("brkD: " + str.tostring(brkScoreV, "0.00") + " " + f_secStr(aptAccBrkUp) + "/" + f_secStr(aptAccBrkDn))
        if not na(rvLive1m)
            string tcCmf = na(cmfX) ? "-" : (cmfX >= 0.0 ? "+" : "") + str.tostring(cmfX, "0.00")
            string tcTsf = na(tpTsf) or na(tpLam) ? "-" : (tpTsf >= 0.0 ? "+" : "") + str.tostring(tpTsf, "0.00") + "/" + (tpTsf >= 0.0 ? "1" : "-1")
            string tcVpin = na(vpinX) ? "V-" : "V" + str.tostring(vpinX, "0.00") + (vpinDirX > 0 ? "▲" : vpinDirX < 0 ? "▼" : " ")
            string tcLam = na(tpTsf) or na(tpLam) ? "L-" : "L" + (tpLam >= 0.0 ? "+" : "") + str.tostring(tpLam, "0.00")
            bcTop.push("TC " + f_secStr(aptAccCmfUp) + "/" + f_secStr(aptAccCmfDn) + " " + tcCmf + " " + tcTsf + " " + tcVpin + tcLam)
            bcTop.push(str.tostring(int(aptAccUpD)) + "/ " + str.tostring(int(aptAccDnD)) + " " + f_formatRemain(aptBarNb, aptAnchorMs))
            float pairRv1_5m = array.get(aptRvLive, 1)
            float pairRv2_5m = array.get(aptRv2Live, 1)
            float pairRv1_15m = array.get(aptRvLive, 2)
            float pairRv2_15m = array.get(aptRv2Live, 2)
            float pairRv1_30m = array.get(aptRvLive, 3)
            float pairRv2_30m = array.get(aptRv2Live, 3)
            float pairRv2_1m = array.get(aptRv2Live, 0)
            bool pairReady01 = not na(rvLive1m) and not na(pairRv1_5m) and not na(pairRv2_1m) and not na(pairRv2_5m) and rvLive1m > 0.0 and pairRv1_5m > 0.0 and pairRv2_1m > 0.0 and pairRv2_5m > 0.0
            bool pairReady23 = not na(pairRv1_15m) and not na(pairRv1_30m) and not na(pairRv2_15m) and not na(pairRv2_30m) and pairRv1_15m > 0.0 and pairRv1_30m > 0.0 and pairRv2_15m > 0.0 and pairRv2_30m > 0.0
            string pairStatus01 = pairReady01 and rvLive1m > pairRv1_5m and pairRv2_1m > pairRv2_5m ? "Up" : pairReady01 and rvLive1m < pairRv1_5m and pairRv2_1m < pairRv2_5m ? "Dn" : "Wait"
            string pairStatus23 = pairReady23 and pairRv1_15m > pairRv1_30m and pairRv2_15m > pairRv2_30m ? "Up" : pairReady23 and pairRv1_15m < pairRv1_30m and pairRv2_15m < pairRv2_30m ? "Dn" : "Wait"
            int tierSync01 = f_pairTier(0, bid) + f_pairTier(1, bid)
            int tierSync23 = f_pairTier(2, bid) + f_pairTier(3, bid)
            float extUpSync01 = math.max(0.0, math.min(100.0, (tierSync01 + 38.0) * 100.0 / 76.0))
            float extUpSync23 = math.max(0.0, math.min(100.0, (tierSync23 + 38.0) * 100.0 / 76.0))
            float extSync01 = pairStatus01 == "Dn" ? 100.0 - extUpSync01 : extUpSync01
            float extSync23 = pairStatus23 == "Dn" ? 100.0 - extUpSync23 : extUpSync23
            bcTop.push("M1 & M5  " + pairStatus01 + " " + str.tostring(math.round(extSync01)) + "%")
            bcTop.push("M15 & M30  " + pairStatus23 + " " + str.tostring(math.round(extSync23)) + "%")
        if bcTop.size() > 0
            while bcRows.size() < 5
                bcRows.push(" ")
            for tk = 0 to bcTop.size() - 1
                bcRows.push(bcTop.get(tk))
        string bcTrend = f_rv2TrendRow(aptBarIdx)
        if bcTrend != ""
            bcRows.push(bcTrend)
        // [GIU NGUYEN - mac dinh TAT] 6 hang DaySwingStructure + 3 nhan Call/Flip/Put KHONG co trong BuildBarCurLblRows() cua MQL5 hien tai
        int dssLiveDk = int(math.floor((time - aptAnchorMs) / 86400000.0))
        bool dssFresh = not na(dssDayKey) and dssLiveDk == dssDayKey and not dssPartial
        int dssCntNow = dssCnt + (barstate.isconfirmed ? 0 : 1)
        float dssLiveRng = barstate.isconfirmed ? 0.0 : high - low
        [dssOkRaw, dssR0, dssR1, dssR2, dssR3, dssR4, dssR5, dssCallPx, dssFlipPx, dssPutPx, dssCallTc, dssPutTc] = f_dssCompute(math.max(nz(dssHi, high), high), math.min(nz(dssLo, low), low), close, dssCntNow, dssLiveRng)
        bool dssOk = i_showDss and dssOkRaw and dssFresh
        if dssOk
            while bcRows.size() < 5
                bcRows.push(" ")
            bcRows.push(dssR0)
            bcRows.push(dssR1)
            bcRows.push(dssR2)
            bcRows.push(dssR3)
            bcRows.push(dssR4)
            bcRows.push(dssR5)
        string bcTxt = bcRows.size() > 0 ? bcRows.join("\n") : " "
        float bcY = na(l15) ? aptBcL : na(aptBcL) ? l15 : math.min(l15, aptBcL)
        bool onBarCur = i_barLblShow and i_showBox15m and bcRows.size() > 0
        aptLbBarCur := f_setOne(aptLbBarCur, tMidCur, bcY, bcTxt, i_barLblColorCur, onBarCur, label.style_label_upper_right, text.align_right)
        bool onDssLv = dssOk and i_barLblShow and i_showBox15m
        aptLbDssCall := f_setOne(aptLbDssCall, time, dssCallPx, "Call " + str.tostring(dssCallTc), #FF6347, onDssLv, label.style_label_left, text.align_left)
        aptLbDssFlip := f_setOne(aptLbDssFlip, time, dssFlipPx, "Flip", #FFD700, onDssLv, label.style_label_left, text.align_left)
        aptLbDssPut := f_setOne(aptLbDssPut, time, dssPutPx, "Put " + str.tostring(dssPutTc), #3CB371, onDssLv, label.style_label_left, text.align_left)

        // ---- DrawBrkDHHLL: nhan HH / LL / MD cua kenh brkD tren khung chon, ngay tren/duoi/giua than nen lon (cung truc thoi gian tMidCur) ----
        int hhIdx = array.indexof(aptTfName, i_hhllTf)
        bool onHh = hhIdx >= 0 and f_tfEnabled(hhIdx)
        float hhV = na
        float llV = na
        float mdV = na
        if onHh
            [hhT, llT] = f_chanHL(hhIdx, i_brkDBars, 1)
            hhV := hhT
            llV := llT
            mdV := f_mdAvg(hhIdx, i_brkDBars)
        aptLbHH := f_setOne(aptLbHH, tMidCur, hhV, "HH" + i_hhllTf, #FF6347, onHh, label.style_label_down, text.align_center)
        aptLbLL := f_setOne(aptLbLL, tMidCur, llV, "LL" + i_hhllTf, #00BFFF, onHh, label.style_label_up, text.align_center)
        aptLbMD := f_setOne(aptLbMD, tMidCur, mdV, "MD" + i_hhllTf, #FFD700, onHh, label.style_label_center, text.align_center)

        // ---- DrawOwLabelsAll: nhan "OW<khung> <so nen>" (xanh la) cua moi khung tai gia OW = LWMA(Open, n) ----
        for iw = 0 to APT_TFN - 1
            float owW = f_owLwma(iw, i_brkDBars)
            int owCnt = f_rv1OwCnt(iw, i_brkDBars, array.get(aptRvLive, iw))
            string owTxt = "OW" + array.get(aptTfName, iw) + " " + (na(owCnt) ? "-" : str.tostring(owCnt))
            f_setLbl(aptLbOw, iw, tMidCur, owW, owTxt, color.new(color.lime, 0), i_showOwAll and f_tfEnabled(iw) and not na(owW), label.style_label_center, text.align_center)

        // ---- AptRndMarksDraw: moc LAM TRON mau trang (R/S, HH, LL, OW cua cac khung >= 5m), khung trung gia gop 1 nhan ----
        array<float> mkPx = array.new_float(0)
        array<string> mkNm = array.new_string(0)
        for kd = 0 to 3
            for ir = 0 to APT_TFN - 1
                float vR = na
                if array.get(aptNb, ir) >= 5 and f_tfEnabled(ir)
                    if kd == 0
                        vR := array.get(aptRndRS, ir)
                    else if kd == 1
                        [rhh, rll] = f_chanHL(ir, i_brkDBars, 1)
                        string sH = f_roundNear("R1", rhh)
                        vR := sH == "" ? na : str.tonumber(sH)
                    else if kd == 2
                        [rhh2, rll2] = f_chanHL(ir, i_brkDBars, 1)
                        string sL = f_roundNear("S1", rll2)
                        vR := sL == "" ? na : str.tonumber(sL)
                    else
                        float owR = f_owLwma(ir, i_brkDBars)
                        float rv1R = array.get(aptRvLive, ir)
                        if not na(owR) and not na(rv1R) and rv1R > 0.0
                            string sO = f_roundNear(rv1R >= owR ? "R1" : "S1", owR)
                            vR := sO == "" ? na : str.tonumber(sO)
                if not na(vR) and vR > 0.0
                    string lbR = array.get(aptTfName, ir) + (kd == 1 ? "H" : kd == 2 ? "L" : kd == 3 ? "OW" : "")
                    int fIdx = array.indexof(mkPx, vR)
                    if fIdx >= 0
                        array.set(mkNm, fIdx, array.get(mkNm, fIdx) + " " + lbR)
                    else
                        array.push(mkPx, vR)
                        array.push(mkNm, lbR)
        for km = 0 to APT_TFN * 4 - 1
            bool onMk = i_showRnd and km < array.size(mkPx)
            float pxMk = onMk ? array.get(mkPx, km) : na
            string txMk = onMk ? array.get(mkNm, km) + " " + str.tostring(int(math.round(pxMk))) : ""
            f_setLbl(aptLbRnd, km, time + i_gapRnd * barMs15, pxMk, txMk, color.white, onMk, label.style_label_right, text.align_right)

        // ---- DrawCloseSimpleLabels: "< <khung> SMA<period>" tai SMA(Close, period) (nen dang chay + period-1 nen TF da dong) ----
        for ic = 0 to APT_TFN - 1
            float smaV = na
            if f_tfEnabled(ic) and array.get(aptHbCnt, ic) >= i_csmaPer - 1
                float smSum = bid
                for kc = 1 to i_csmaPer - 1
                    smSum += f_hbGet(aptHbC, ic, kc)
                smaV := smSum / i_csmaPer
            f_setLbl(aptLbCsma, ic, xRv1m1 + i_gapCsma * barMs15, smaV, "< " + array.get(aptTfName, ic) + " SMA" + str.tostring(i_csmaPer), array.get(aptTfClr, ic), i_showCsma and not na(smaV) and smaV > 0.0, label.style_label_left, text.align_left)

        //──────────────────────────────────────────────────────────
        // VE 2 CANH MAU HINH. [CAP NHAT THEO YEU CAU - PATAUTO-01] Khung
        // duoc chon o vong lap tren: TU DONG (khung thap nhat du dieu kien)
        // khi i_patAutoTF BAT, hoac dung khung i_barTF khi TAT. Khoi ve nay
        // KHONG doi mot dong logic nao, van chi doc cum patBar*.
        // Dung line.new/set_xy GIONG aptLine15m* da co — KHONG them
        // kieu object moi, KHONG doi 3 line bar 15m o tren.
        //──────────────────────────────────────────────────────────
        bool onPatLn = i_showPatLines and patBarMode >= 2 and not na(patBarT1) and not na(patBarT2) and not na(patBarP1) and not na(patBarP2)
        color patLnClr = f_patClr(patBarBias)
        // [CAP NHAT THEO YEU CAU - MQ5SYNC-01] Port AptPatDrawOneSeg() ben
        // AutoPositionTool_UI.mq5: MOI doan KHONG ve nguyen (t1,p1)-(t2,p2)
        // ma KEO DAI moc 2 toi thoi diem hien tai THEO DUNG DO DOC cua doan,
        // nho vay canh mau hinh luon chay toi sat nen hien tai va trung khop
        // voi gia "cham" ma f_patTouch dang bao tren nhan. Chi doi toa do
        // truyen vao 2 line CO SAN - KHONG them object nao.
        int patNowT = timenow
        // L1: (t1,p1) -> (t2,p2) keo dai
        int patX1b = patBarT2
        float patY1b = patBarP2
        if not na(patBarT2) and patNowT > patBarT2
            float pxE1 = f_patSegAt(patBarT1, patBarP1, patBarT2, patBarP2, patNowT)
            if not na(pxE1)
                patX1b := patNowT
                patY1b := pxE1
        // L2 mode 2: (t3,p3) -> (t4,p4) keo dai
        int patX2b = patBarT4
        float patY2b = patBarP4
        if not na(patBarT4) and patNowT > patBarT4
            float pxE2 = f_patSegAt(patBarT3, patBarP3, patBarT4, patBarP4, patNowT)
            if not na(pxE2)
                patX2b := patNowT
                patY2b := pxE2
        // L2 mode 3: (t2,p2) -> (t3,p3) keo dai
        int patX3b = patBarT3
        float patY3b = patBarP3
        if not na(patBarT3) and patNowT > patBarT3
            float pxE3 = f_patSegAt(patBarT2, patBarP2, patBarT3, patBarP3, patNowT)
            if not na(pxE3)
                patX3b := patNowT
                patY3b := pxE3
        if onPatLn
            if na(aptPatL1)
                aptPatL1 := line.new(patBarT1, patBarP1, patX1b, patY1b, xloc=xloc.bar_time, color=patLnClr, width=2)
            else
                line.set_xy1(aptPatL1, patBarT1, patBarP1)
                line.set_xy2(aptPatL1, patX1b, patY1b)
                line.set_color(aptPatL1, patLnClr)
            bool onL2 = patBarMode == 2 and not na(patBarT3) and not na(patBarT4) and not na(patBarP3) and not na(patBarP4)
            bool onL2b = patBarMode == 3 and not na(patBarT3) and not na(patBarP3)
            if onL2
                if na(aptPatL2)
                    aptPatL2 := line.new(patBarT3, patBarP3, patX2b, patY2b, xloc=xloc.bar_time, color=patLnClr, width=2)
                else
                    line.set_xy1(aptPatL2, patBarT3, patBarP3)
                    line.set_xy2(aptPatL2, patX2b, patY2b)
                    line.set_color(aptPatL2, patLnClr)
            else if onL2b
                if na(aptPatL2)
                    aptPatL2 := line.new(patBarT2, patBarP2, patX3b, patY3b, xloc=xloc.bar_time, color=patLnClr, width=2)
                else
                    line.set_xy1(aptPatL2, patBarT2, patBarP2)
                    line.set_xy2(aptPatL2, patX3b, patY3b)
                    line.set_color(aptPatL2, patLnClr)
            else if not na(aptPatL2)
                line.set_color(aptPatL2, color.new(color.black, 100))
        else
            if not na(aptPatL1)
                line.set_color(aptPatL1, color.new(color.black, 100))
            if not na(aptPatL2)
                line.set_color(aptPatL2, color.new(color.black, 100))

//══════════════════════════════════════════════════════════════════
// [SUA MQL5SYNC-02 - THEO YEU CAU] DUONG VE khop DrawRvLinesSelTF() + DrawEmaSeries() + DrawOwLine() cua MQL5 cho khung 1m va 5m:
//   RV1 (MAGENTA, net dut), RV2 (mau khung, net dut), EMA(5) cua MUC PIVOT DANG CHON i_pivLvl (mau theo muc, net dut), OW = LWMA(Open, n) (xanh la, net dut).
//   plot() ve LIEN TUC qua cac nen, chi doc lai gia tri da tinh san (aptRvLive / aptRv2Live / aptEmaLv / aptHbO).
//══════════════════════════════════════════════════════════════════
color aptPivLineClr = aptPivIdx == 0 ? color.white : aptPivIdx <= 9 ? color.lime : aptPivIdx == 10 ? color.orange : color.rgb(154, 205, 50)
int aptOwSelIdx = array.indexof(aptTfName, i_hhllTf)
plot(i_showLineRv1 and aptTfOk ? array.get(aptRvLive, 0) : na, title="Duong RV1 (1m)", color=i_colLineRv1, style=plot.style_line, linewidth=i_lineWidth, linestyle=plot.linestyle_dashed)
plot(i_showLineRv2 and aptTfOk ? array.get(aptRv2Live, 0) : na, title="Duong RV2 (1m)", color=i_colLineRv2, style=plot.style_line, linewidth=i_lineWidth, linestyle=plot.linestyle_dashed)
plot(i_showLineS1 and aptTfOk ? array.get(aptEmaLv, aptPivIdx) : na, title="Duong Pivot EMA (1m)", color=aptPivLineClr, style=plot.style_line, linewidth=i_lineWidth, linestyle=plot.linestyle_dashed)
plot(i_showLineRv1_5m and aptTfOk ? array.get(aptRvLive, 1) : na, title="Duong RV1 (5m)", color=i_colLineRv1_5m, style=plot.style_line, linewidth=i_lineWidth + 1, linestyle=plot.linestyle_dashed)
plot(i_showLineRv2_5m and aptTfOk ? array.get(aptRv2Live, 1) : na, title="Duong RV2 (5m)", color=i_colLineRv2_5m, style=plot.style_line, linewidth=i_lineWidth + 1, linestyle=plot.linestyle_dashed)
plot(i_showLineS1_5m and aptTfOk ? array.get(aptEmaLv, 1 * APT_LVN + aptPivIdx) : na, title="Duong Pivot EMA (5m)", color=aptPivLineClr, style=plot.style_line, linewidth=i_lineWidth + 1, linestyle=plot.linestyle_dashed)
plot(i_showLineOw and aptTfOk and aptOwSelIdx >= 0 ? f_owLwma(aptOwSelIdx, i_brkDBars) : na, title="Duong OW = LWMA(Open, n) (khung HH/LL)", color=color.lime, style=plot.style_line, linewidth=1, linestyle=plot.linestyle_dashed)
